<xt version="2">
  <head>
    <title>D1Debate</title>
  </head>

  <ports>
    round_text: string in = "第 3 回合／20"
    opp_name: string in = "塞德里克"
    opp_cred: string in = "塞德里克 的可信度"
    hp_me: number in = 124
    hp_me_max: number in = 140
    hp_opp: number in = 180.5
    hp_opp_max: number in = 230
    face: number in = 1
    band_p: number in = 0
    band_g: number in = 1
    band_a: number in = 0
    combo_text: string in = "連擊 ×2"
    hachiku: number in = 2
    guard_down: bool in = false
    shisshu: bool in = false
    ronpa_text: string in = "鏈長 2／4　爭點 2／2"
    ronpa_ready: bool in = false
    show_ronpa: bool in = true
    tell_on: bool in = true
    tell_card: string in = "鎖匠碰過筒子、有萬用鑰匙"
    tell_partial: bool in = false
    tell_clear: bool in = true
    tell_a: number in = 0
    tell_b: number in = -1
    tell_star: number in = -1
    tell_gesture: string in = "整理黑領巾、微微一笑"
    dying: bool in = false
    dying_text: string in = "垂死反撲：打中只扣 10"
    ochain_title: string in = "塞德里克 的推理鏈"
    ochain: list<struct{id: string, label: string, issue: string, sel: bool}> in = [{"id":"L1","label":"整晚守在靈柩旁","issue":"機","sel":false}]
    pchain: list<struct{id: string, label: string, issue: string, crack: number}> in = [{"id":"04A","label":"總閥被人關小","issue":"法","crack":0},{"id":"06A","label":"鎖已修妥，沒留後門","issue":"法","crack":0}]
    ev_list: list<struct{id: string, name: string, sel: bool}> in = [{"id":"E01","name":"黃銅文件筒（空）","sel":false},{"id":"E02","name":"書房的座鐘","sel":false},{"id":"E04","name":"地下室煤氣總閥","sel":false},{"id":"E06","name":"布里格斯的工作單","sel":true},{"id":"E08","name":"賭場的催款信","sel":false}]
    claims: list<struct{id: string, label: string, issue: string, kind: string, soph: number, crack: string, stand: string, extra: string, ok: number, sel: bool}> in = [{"id":"06A","label":"鎖已修妥，沒留後門","issue":"法","kind":"正論","soph":0,"crack":"","stand":"已在鏈上","extra":"","ok":0,"sel":false},{"id":"06B","label":"鎖匠傍晚就走了","issue":"機","kind":"正論","soph":0,"crack":"","stand":"","extra":"","ok":1,"sel":true},{"id":"06C","label":"工作單只寫「校試」","issue":"法","kind":"詭辯","soph":1,"crack":"與妳說過的話矛盾","stand":"","extra":"","ok":1,"sel":false}]
    record: list<struct{n: number, label: string, use: string, soph: string, crack: string, state: string}> in = [{"n":1,"label":"燈滅前，你的椅子就空了","use":"反駁","soph":"","crack":"","state":""},{"n":2,"label":"總閥被人關小","use":"","soph":"","crack":"","state":"站著"}]
    mode: number in = 0
    phase: number in = 0
    act: number in = 1
    can_dismantle: bool in = true
    guard_ok: bool in = true
    guard_armed: bool in = false
    guard_left: bool in = true
    sel_claim_text: string in = "鎖匠傍晚就走了"
    sel_target_text: string in = ""
    need_target: bool in = false
    can_lock: bool in = true
    picker_on: bool in = true
    speech_who: string in = "Sherefox"
    speech: string in = "總閥上有新鮮的扳動痕跡。燈不是自己暗的，是有人在地下室把它關小了。"
    sys_line: string in = "接上一節（手法）。論證 12 × 1 × 1.1 × 1.25 ＝ 16.5。"
    line_seq: number in = 0
    float_opp: string in = ""
    float_me: string in = ""
    float_opp_seq: number in = 0
    float_me_seq: number in = 0
    shatter_seq: number in = 0
    grade_text: string in = "乾淨論破"
    rounds_text: string in = "回合數 9"
    outcome_win: bool in = true
    pick_act: number out = 0
    pick_ev: string out = ""
    pick_claim: string out = ""
    pick_target: string out = ""
    guard: event out
    lock: event out
    skip: event out
    back_title: event out
    settings: event out
  </ports>

  <body on:show="play(intro)" key-activation="none">
    <div id="d1debate" tabindex="0" autofocus="" on:port(float_opp_seq)="play(float-opp)" on:port(float_me_seq)="play(float-me)" on:port(line_seq)="play(line-in)" on:port(shatter_seq)="play(shatter)" on:port(face)="play(face-in)" on:key(1)="if port(phase) eq 0 set(pick_act, 1)" on:key(2)="if port(phase) eq 0 set(pick_act, 2)" on:key(3)="if port(phase) eq 0 set(pick_act, 3)" on:key(4)="if port(phase) eq 0 set(pick_act, 4)" on:key(V)="if port(phase) eq 0 emit(guard)" on:key(R)="state(Open, toggle, target=#record)" on:key(Enter)="if port(phase) eq 0 and port(can_lock) eq true emit(lock); if port(phase) eq 1 emit(skip)" on:key(Space)="if port(phase) eq 1 emit(skip)" on:key(Escape)="emit(settings)" on:key(F1)="emit(settings)">
      <img id="bg-d01-parlour" src="../shared/img/bg-d01-parlour.jpg"/>
      <div id="sheet">
        <div id="opp-fig">
          <img id="cedric-composed" class="s-b00406" src="../shared/img/cedric-composed.png" bind:display="face | eq(0)"/>
          <img id="cedric-uneasy" class="s-b00406" src="../shared/img/cedric-uneasy.png" bind:display="face | eq(1)"/>
          <img id="cedric-cornered" class="s-b00406" src="../shared/img/cedric-cornered.png" bind:display="face | eq(2)"/>
          <img id="cedric-angry" class="s-b00406" src="../shared/img/cedric-angry.png" bind:display="face | eq(3)"/>
          <img id="cedric-guilt" class="s-b00406" src="../shared/img/cedric-guilt.png" bind:display="face | eq(4)"/>
        </div>
        <div id="opp-plate" class="name-plate">
          <div id="opp-name" class="opp-name" bind:text="opp_name">塞德里克</div>
        </div>
        <div id="mast-bg" class="s-e8d5ea"/>
        <div id="mast">
          <div id="mast-name" class="mast-t">@UI_PAPER_MAST</div>
          <div id="mast-extra" class="extra">@UI_PAPER_EXTRA</div>
          <div id="round" class="round" bind:text="round_text">第 3 回合／20</div>
        </div>
        <div id="btn-record" class="bbtn" on:click(left)="state(Open, toggle, target=#record)">
          <div id="btn-record-t" class="bbtn-t">@UI_V2_RECORD</div>
        </div>
        <div id="opp-cred" class="paper">
          <div id="opp-cred-l" class="cred-l" bind:text="opp_cred">塞德里克 的可信度</div>
          <div id="opp-cred-n" class="cred-n" bind:text="format('{0} / {1}', hp_opp, hp_opp_max)">180.5 / 230</div>
          <div id="opp-track" class="track">
            <div id="opp-fill" class="fill-opp" bind:width="hp_opp | range(0, hp_opp_max, 0%, 100%)"/>
          </div>
        </div>
        <div id="float-opp" class="float" bind:text="float_opp">−20</div>
        <div id="guard-down" class="plate red" bind:display="guard_down">
          <div id="guard-down-t" class="plate-t">@UI_V2_GUARD_DOWN</div>
        </div>
        <div id="psych" class="paper">
          <div id="g-p" class="gauge" bind:class.b0="band_p | eq(0)" bind:class.b1="band_p | eq(1)" bind:class.b2="band_p | eq(2)">
            <div id="g-p-n" class="g-name">@UI_V2_GAUGE_PRESSURE</div>
            <div id="g-p-b0" class="g-band gb-0">@UI_V2_GAUGE_CALM</div>
            <div id="g-p-b1" class="g-band gb-1">@UI_V2_GAUGE_FLOAT</div>
            <div id="g-p-b2" class="g-band gb-2">@UI_V2_GAUGE_BROKEN</div>
            <div id="g-p-s1" class="seg s1"/>
            <div id="g-p-s2" class="seg s2"/>
            <div id="g-p-s3" class="seg s3"/>
          </div>
          <div id="g-g" class="gauge" bind:class.b0="band_g | eq(0)" bind:class.b1="band_g | eq(1)" bind:class.b2="band_g | eq(2)">
            <div id="g-g-n" class="g-name">@UI_V2_GAUGE_GUILT</div>
            <div id="g-g-b0" class="g-band gb-0">@UI_V2_GAUGE_CALM</div>
            <div id="g-g-b1" class="g-band gb-1">@UI_V2_GAUGE_FLOAT</div>
            <div id="g-g-b2" class="g-band gb-2">@UI_V2_GAUGE_BROKEN</div>
            <div id="g-g-s1" class="seg s1"/>
            <div id="g-g-s2" class="seg s2"/>
            <div id="g-g-s3" class="seg s3"/>
          </div>
          <div id="g-a" class="gauge" bind:class.b0="band_a | eq(0)" bind:class.b1="band_a | eq(1)" bind:class.b2="band_a | eq(2)">
            <div id="g-a-n" class="g-name">@UI_V2_GAUGE_ANGER</div>
            <div id="g-a-b0" class="g-band gb-0">@UI_V2_GAUGE_CALM</div>
            <div id="g-a-b1" class="g-band gb-1">@UI_V2_GAUGE_FLOAT</div>
            <div id="g-a-b2" class="g-band gb-2">@UI_V2_GAUGE_BROKEN</div>
            <div id="g-a-s1" class="seg s1"/>
            <div id="g-a-s2" class="seg s2"/>
            <div id="g-a-s3" class="seg s3"/>
          </div>
        </div>
        <div id="ochain-box" class="paper">
          <div id="ochain-title" class="kicker" bind:text="ochain_title">塞德里克 的推理鏈</div>
          <div id="ochain-hint" class="kicker" bind:display="need_target">@UI_V2_REBUT_PICK_LINK</div>
          <div id="ochain-empty" class="empty" bind:display="ochain | item(0) | item(id) | eq('')">@UI_V2_CHAIN_EMPTY</div>
          <repeat id="ochain" port="ochain">
            <div id="oc" class="chip click" on:click(left)="if port(phase) eq 0 set(pick_target, item(id))" bind:class.sel="item(sel)">
              <div id="oc-iss" class="iss" bind:text="item(issue)">機</div>
              <div id="oc-t" class="chip-t" bind:text="item(label)">整晚守在靈柩旁</div>
            </div>
          </repeat>
        </div>
        <div id="picker" class="paper" bind:display="picker_on">
          <div id="pk-ev-k" class="kicker">@UI_V2_PICK_EVIDENCE</div>
          <div id="pk-ev-scroll">
            <repeat id="evs" port="ev_list">
              <div id="evc" class="evc" on:click(left)="if port(phase) eq 0 set(pick_ev, item(id))" bind:class.sel="item(sel)">
                <div id="evc-t" class="evc-t" bind:text="item(name)">黃銅文件筒（空）</div>
              </div>
            </repeat>
          </div>
          <div id="pk-cl-k" class="kicker">@UI_V2_PICK_CLAIM</div>
          <div id="pk-cl-scroll">
            <repeat id="cls" port="claims">
              <div id="clm" class="clm" on:click(left)="if port(phase) eq 0 set(pick_claim, item(id))" bind:class.soph="item(soph) | eq(1)" bind:class.sel="item(sel)" bind:class.off="item(ok) | eq(0)">
                <div id="clm-kind" class="clm-kind" bind:text="item(kind)">正論</div>
                <div id="clm-t" class="clm-t" bind:text="item(label)">鎖匠傍晚就走了</div>
                <div id="clm-tags">
                  <div id="clm-iss" class="iss" bind:text="item(issue)">機</div>
                  <div id="clm-crack" class="tag tag-red" bind:text="item(crack)">與妳說過的話矛盾</div>
                  <div id="clm-stand" class="tag tag-ink" bind:text="item(stand)"/>
                  <div id="clm-extra" class="tag tag-cu" bind:text="item(extra)"/>
                </div>
              </div>
            </repeat>
          </div>
        </div>
        <div id="tell" class="paper" bind:display="tell_on">
          <div id="tell-head" class="kicker" bind:display="mode | ne(1)">@UI_V2_TELL_HEAD</div>
          <div id="tell-last" class="plate red" bind:display="mode | eq(1)">
            <div id="tell-last-t" class="plate-t">@UI_V2_LAST_CARD</div>
          </div>
          <div id="tell-bubble" class="bubble" bind:display="tell_card | ne('')">
            <div id="tell-hes" class="tell-hes" bind:display="tell_partial">@UI_V2_TELL_HESITATE</div>
            <div id="tell-card" class="tell-card" bind:text="tell_card">鎖匠碰過筒子、有萬用鑰匙</div>
          </div>
          <div id="clar-c" class="clar" bind:display="tell_clear">@UI_V2_TELL_CLEAR</div>
          <div id="clar-v" class="clar" bind:display="tell_clear | not">@UI_V2_TELL_VAGUE</div>
          <div id="tell-cands">
            <div id="cand-a" class="cand" bind:class.a0="tell_a | eq(0)" bind:class.a1="tell_a | eq(1)" bind:class.a2="tell_a | eq(2)" bind:class.a3="tell_a | eq(3)" bind:class.a4="tell_a | eq(4)" bind:class.star="tell_star | eq(0)">
              <div id="cand-a-0" class="cand-l ca-0">@UI_V2_OPP_ASSERT</div>
              <div id="cand-a-1" class="cand-l ca-1">@UI_V2_OPP_PRESS</div>
              <div id="cand-a-2" class="cand-l ca-2">@UI_V2_OPP_REBUT</div>
              <div id="cand-a-3" class="cand-l ca-3">@UI_V2_OPP_DODGE</div>
              <div id="cand-a-4" class="cand-l ca-4">@UI_V2_LAST_CARD</div>
              <div id="cand-a-lk" class="likely">@UI_V2_TELL_LIKELY</div>
            </div>
            <div id="cand-sep" class="slash" bind:display="tell_b | ge(0)">／</div>
            <div id="cand-b" class="cand" bind:class.a0="tell_b | eq(0)" bind:class.a1="tell_b | eq(1)" bind:class.a2="tell_b | eq(2)" bind:class.a3="tell_b | eq(3)" bind:class.a4="tell_b | eq(4)" bind:class.star="tell_star | eq(1)" bind:display="tell_b | ge(0)">
              <div id="cand-b-0" class="cand-l ca-0">@UI_V2_OPP_ASSERT</div>
              <div id="cand-b-1" class="cand-l ca-1">@UI_V2_OPP_PRESS</div>
              <div id="cand-b-2" class="cand-l ca-2">@UI_V2_OPP_REBUT</div>
              <div id="cand-b-3" class="cand-l ca-3">@UI_V2_OPP_DODGE</div>
              <div id="cand-b-4" class="cand-l ca-4">@UI_V2_LAST_CARD</div>
              <div id="cand-b-lk" class="likely">@UI_V2_TELL_LIKELY</div>
            </div>
          </div>
          <div id="tell-gesture" class="gesture" bind:text="tell_gesture" bind:display="tell_gesture | ne('')">整理黑領巾、微微一笑</div>
          <div id="tell-dying" class="dying-t" bind:text="dying_text" bind:display="dying">垂死反撲：打中只扣 10</div>
        </div>
        <div id="me-cred" class="paper">
          <div id="me-cred-l" class="cred-l">@UI_V2_CRED_PLAYER</div>
          <div id="me-track" class="track">
            <div id="me-fill" class="fill-me" bind:width="hp_me | range(0, hp_me_max, 0%, 100%)"/>
          </div>
          <div id="me-cred-n" class="cred-n" bind:text="format('{0} / {1}', hp_me, hp_me_max)">124 / 140</div>
          <div id="me-combo" class="cred-l" bind:text="combo_text">連擊 ×2</div>
          <div id="me-hk" bind:display="hachiku | gt(0)">
            <div id="me-hk-t" class="cred-l">@STAMP_HACHIKU</div>
            <div id="me-hk-n" class="cred-l" bind:text="format('×{0}', hachiku)">×2</div>
          </div>
          <div id="me-shisshu" class="shis-t" bind:display="shisshu">@UI_V2_SHISHOU_HINT</div>
        </div>
        <div id="float-me" class="float" bind:text="float_me">−16</div>
        <div id="pchain-box" class="paper">
          <div id="pchain-title" class="kicker">@UI_V2_CHAIN_PLAYER</div>
          <div id="ronpa-ready" class="plate red" bind:display="ronpa_ready">
            <div id="ronpa-ready-t" class="plate-t">@UI_V2_RONPA_READY</div>
          </div>
          <div id="ronpa-t" class="ronpa-t" bind:text="ronpa_text" bind:display="show_ronpa">鏈長 2／4　爭點 2／2</div>
          <div id="pchain-empty" class="empty" bind:display="pchain | item(0) | item(id) | eq('')">@UI_V2_CHAIN_EMPTY</div>
          <repeat id="pchain" port="pchain">
            <div id="pc" class="chip" bind:class.cracked="item(crack) | gt(0)">
              <div id="pc-iss" class="iss" bind:text="item(issue)">法</div>
              <svg id="pc-crack" class="crack-m" viewBox="0 0 24 24">
                <path id="Crack" d="M20 2 L13 9 L16 12 L8 18 L11 21 L4 23" fill="none" stroke="#b8322a" stroke-width="2.2"/>
              </svg>
              <div id="pc-t" class="chip-t" bind:text="item(label)">總閥被人關小</div>
            </div>
          </repeat>
        </div>
        <div id="confirm" class="confirm">
          <div id="sum-claim" class="sum-t" bind:text="sel_claim_text">鎖匠傍晚就走了</div>
          <div id="sum-arrow" class="sum-a" bind:display="sel_target_text | ne('')">→</div>
          <div id="sum-target" class="sum-t" bind:text="sel_target_text" bind:display="sel_target_text | ne('')"/>
          <div id="sum-armed" class="sum-a" bind:display="guard_armed">@UI_V2_SUPPORT_ARMED</div>
        </div>
        <div id="acts" class="acts" bind:class.busy="phase | ne(0)">
          <div id="acts-0" bind:display="mode | eq(0)">
            <div id="act-1" class="tblock" on:click(left)="if port(phase) eq 0 set(pick_act, 1)" bind:class.on="act | eq(1)">
              <div id="act-1-k" class="tb-k">1</div>
              <div id="act-1-t" class="tb-t">@UI_V2_ACT_ARGUE</div>
            </div>
            <div id="grp-rebut" class="grp-l">@UI_V2_ACT_REBUT</div>
            <div id="act-2" class="tblock" on:click(left)="if port(phase) eq 0 set(pick_act, 2)" bind:class.on="act | eq(2)">
              <div id="act-2-k" class="tb-k">2</div>
              <div id="act-2-t" class="tb-t">@UI_V2_REBUT_CUT</div>
            </div>
            <div id="act-3" class="tblock" on:click(left)="if port(phase) eq 0 set(pick_act, 3)" bind:class.on="act | eq(3)" bind:class.off="can_dismantle | not">
              <div id="act-3-k" class="tb-k">3</div>
              <div id="act-3-t" class="tb-t">@UI_V2_REBUT_TOPPLE</div>
            </div>
            <div id="act-4" class="tblock" on:click(left)="if port(phase) eq 0 set(pick_act, 4)" bind:class.on="act | eq(4)">
              <div id="act-4-k" class="tb-k">4</div>
              <div id="act-4-t" class="tb-t">@UI_V2_ACT_STALL</div>
            </div>
            <div id="btn-guard" class="guard" on:click(left)="if port(phase) eq 0 emit(guard)" bind:class.armed="guard_armed" bind:class.off="guard_ok | not">
              <div id="guard-t" class="guard-t">@UI_V2_SUPPORT</div>
              <div id="guard-lamp" class="lamp" bind:class.on="guard_left"/>
            </div>
          </div>
          <div id="acts-1" bind:display="mode | eq(1)">
            <div id="eg-prompt" class="prompt">@UI_V2_LAST_CARD_PROMPT</div>
            <div id="act-5" class="tblock" on:click(left)="if port(phase) eq 0 set(pick_act, 5)" bind:class.on="act | eq(5)">
              <div id="act-5-t" class="tb-t">@UI_V2_ENDGAME_CUT</div>
            </div>
            <div id="act-6" class="tblock" on:click(left)="if port(phase) eq 0 set(pick_act, 6)" bind:class.on="act | eq(6)">
              <div id="act-6-t" class="tb-t">@UI_V2_ENDGAME_TAKE</div>
            </div>
          </div>
          <div id="acts-2" bind:display="mode | eq(2)">
            <div id="ls-prompt" class="prompt">@UI_V2_MY_LAST_CARD</div>
            <div id="act-7" class="tblock" on:click(left)="if port(phase) eq 0 set(pick_act, 7)" bind:class.on="act | eq(7)">
              <div id="act-7-t" class="tb-t">@UI_V2_ACT_REBUT</div>
            </div>
            <div id="act-6b" class="tblock" on:click(left)="if port(phase) eq 0 set(pick_act, 6)" bind:class.on="act | eq(6)">
              <div id="act-6b-t" class="tb-t">@UI_V2_GIVE_UP_BTN</div>
            </div>
          </div>
        </div>
        <div id="btn-lock" class="lockb" on:click(left)="if port(phase) eq 0 and port(can_lock) eq true emit(lock)" bind:class.off="can_lock | not" bind:display="mode | lt(3)">
          <div id="btn-lock-t" class="lockb-t">@UI_V2_LOCK_IN</div>
        </div>
        <div id="hit" on:click(left)="emit(skip)" bind:display="phase | eq(1)"/>
        <div id="band" class="band" on:click(left)="emit(skip)" bind:display="phase | eq(1)">
          <div id="band-who" class="who" bind:text="speech_who">Sherefox</div>
          <div id="band-speech" class="speech" bind:text="speech">總閥上有新鮮的扳動痕跡。燈不是自己暗的，是有人在地下室把它關小了。</div>
          <div id="band-sys" class="sysl" bind:text="sys_line" bind:display="sys_line | ne('')">接上一節（手法）。論證 12 × 1 × 1.1 × 1.25 ＝ 16.5。</div>
          <div id="band-more" class="more">▶</div>
        </div>
        <div id="record" class="s-66a9df">
          <div id="record-panel" class="sheet-big s-e1040c">
            <div id="rec-title" class="h1">@UI_V2_RECORD</div>
            <div id="rec-desc" class="desc">@UI_V2_RECORD_DESC</div>
            <div id="rec-close" class="bbtn" on:click(left)="state(Open, off, target=#record)">
              <div id="rec-close-t" class="bbtn-t">@BTN_CLOSE</div>
            </div>
            <div id="rec-rule" class="s-614666"/>
            <div id="rec-scroll">
              <repeat id="recs" port="record">
                <div id="rec" class="rec-row">
                  <div id="rec-n" class="rec-n" bind:text="format('R{0}', item(n))">R1</div>
                  <div id="rec-t" class="rec-t" bind:text="item(label)">燈滅前，你的椅子就空了</div>
                  <div id="rec-use" class="tag tag-cu" bind:text="item(use)">反駁</div>
                  <div id="rec-soph" class="tag tag-cu" bind:text="item(soph)"/>
                  <div id="rec-crack" class="tag tag-red" bind:text="item(crack)"/>
                  <div id="rec-state" class="tag tag-ink" bind:text="item(state)"/>
                </div>
              </repeat>
            </div>
          </div>
        </div>
        <div id="outcome-veil" class="veil" bind:display="mode | eq(3)"/>
        <div id="outcome" class="outcome sheet-big" bind:display="mode | eq(3)" bind:class.win="outcome_win">
          <div id="out-k" class="kicker s-872272">@UI_V2_GRADE_LABEL</div>
          <div id="out-rule" class="s-614666"/>
          <div id="out-grade" class="grade-t" bind:text="grade_text">乾淨論破</div>
          <div id="out-rounds" class="rounds-t" bind:text="rounds_text">回合數 9</div>
          <div id="out-back" class="bbtn" on:click(left)="emit(back_title)">
            <div id="out-back-t" class="bbtn-t">@UI_V2_BACK_TITLE</div>
          </div>
        </div>
      </div>
    </div>
  </body>

