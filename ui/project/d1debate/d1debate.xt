    }
    .rec-n {
      flex-shrink: 0;
    }
    .rec-t {
      overflow: hidden;
    }
    .desc {
      overflow: hidden;
    }
  </layout>
  <style src="../shared/base.xts"/>
  <style src="d1debate.xts"/>
  <timelines>
    @timeline face-in {
      #opp-fig {
        0ms {
          opacity: 0.4;
        }
        380ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline float-me {
      #float-me {
        0ms {
          opacity: 1;
          transform: translateY(0px);
        }
        1300ms ease-out {
          opacity: 0;
          transform: translateY(-26px);
        }
      }
    }
    @timeline float-opp {
      #float-opp {
        0ms {
          opacity: 1;
          transform: translateY(0px);
        }
        1300ms ease-out {
          opacity: 0;
          transform: translateY(-26px);
        }
      }
    }
    @timeline intro {
      #sheet {
        0ms {
          opacity: 0;
        }
        400ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline line-in {
      #band-who {
        0ms {
          opacity: 0.3;
        }
        260ms ease-out {
          opacity: 1;
        }
      }
      #band-speech {
        0ms {
          opacity: 0.3;
        }
        260ms ease-out {
          opacity: 1;
        }
      }
      #band-sys {
        0ms {
          opacity: 0;
        }
        200ms {
          opacity: 0;
        }
        500ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline shatter {
      #ochain {
        0ms {
          opacity: 1;
          transform: translateY(0px);
        }
        120ms {
          transform: translateX(-6px);
        }
        240ms {
          transform: translateX(6px);
        }
        360ms {
          transform: translateX(0px);
        }
        1400ms ease-in {
          opacity: 0;
          transform: translateY(30px);
        }
        3800ms {
          opacity: 0;
        }
        3900ms {
          opacity: 1;
          transform: translateY(0px);
        }
      }
    }
  </timelines>
</xt>
