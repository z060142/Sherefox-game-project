  color: #f3eedf;
  border-left-width: 4px;
  border-left-color: #b8322a;
  line-clamp: 2;
}

:lang(en) .sysl {
  font-size: 15px;
  line-height: 20px;
}

.more {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 12px;
  line-height: 16px;
  color: #f3eedf88;
  text-align: right;
  white-space: nowrap;
}

.sheet-big {
  background-color: var(--paper);
  border: 2px #123a31;
  effect: shadow(6px 6px 0px 0px #092e2899);
}

.rec-row {
  background-color: #fbf8ef;
  border-bottom-width: 1px;
  border-bottom-color: #123a3166;
  border-bottom-style: dashed;
}

.rec-n {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 26px;
  font-weight: 700;
  color: var(--copper);
  white-space: nowrap;
}

.rec-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 14px;
  line-height: 26px;
  font-weight: 700;
  color: var(--ink-deep);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.h1 {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 24px;
  line-height: 32px;
  font-weight: 700;
  color: var(--ink-deep);
  white-space: nowrap;
}

.desc {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 18px;
  color: var(--ink);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.name-plate {
  background-color: #092e28e6;
  border: 1px #000000;
}

.opp-name {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 20px;
  line-height: 34px;
  font-weight: 700;
  color: var(--paper);
  text-align: center;
  white-space: nowrap;
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --lamp-gold: #e0a050;
  --paper: #f3eedf;
  --vermilion: #b8322a;
}

