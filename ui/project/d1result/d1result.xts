/* Generated by xtframe-import from "D1Result". Edits are kept on re-import; see import-report.json. */

/* import: D1Result.dc.html:1 */
#d1result {
  background-color: #e3d9c2;
  background-gradient: radial-gradient(70.7107% 84.8528% at 50% 40%, #e3d9c2 55%, #cbbd9c 100%);
  color: #123a31;
}

.btn {
  text-align: center;
  line-height: 42px;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  letter-spacing: 2px;
  color: var(--paper);
  background-color: var(--ink);
  border: 1px #092e28;
  effect: shadow(3px 3px 0px 0px #092e2866);
  transition: background-color 120ms linear;
}

.f-body {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

.f-disp {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
}

.rule-thin {
  background-color: var(--ink);
}

.rule-thick {
  background-color: var(--ink);
}

.rule-col {
  background-color: var(--ink);
  opacity: 0.55;
}

.clip {
  background-color: var(--paper);
  border: 1px #123a3166;
  effect: shadow(6px 7px 0px 0px #092e2840);
}

.tape {
  background-color: #f3eedfb3;
  border: 1px #a6543233;
}

.grade {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 60px;
  line-height: 80px;
  font-weight: 700;
  letter-spacing: 8px;
  text-align: center;
  color: var(--ink-deep);
  text-effect: shadow 3px 3px 0px #c9a24a66;
}

.grade.lose {
  color: var(--copper);
  text-effect: shadow 3px 3px 0px #092e2833;
}

:lang(en) .grade {
  font-size: 44px;
  line-height: 80px;
  letter-spacing: 1px;
}

.rounds {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 2px;
  text-align: center;
  color: var(--ink);
}

.rp-label {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 18px;
  line-height: 36px;
  color: var(--ink-deep);
  white-space: nowrap;
}

:lang(en) .rp-label {
  font-size: 16px;
}

.rp-dots {
  border-top-width: 1px;
  border-top-color: #123a3180;
  border-top-style: dashed;
}

.rp-up {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 22px;
  line-height: 36px;
  font-weight: 700;
  text-align: right;
  color: #2f6b4f;
  white-space: nowrap;
}

.rp-down {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 22px;
  line-height: 36px;
  font-weight: 700;
  text-align: right;
  color: var(--vermilion);
  white-space: nowrap;
}

.fv-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 18px;
  line-height: 36px;
  color: var(--ink-deep);
  white-space: nowrap;
}

.none {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  line-height: 36px;
  font-style: italic;
  color: #5b6662;
}

.stamp-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 46px;
  line-height: 60px;
  font-weight: 700;
  letter-spacing: 10px;
  text-align: center;
  text-transform: uppercase;
  color: var(--vermilion);
}

:lang(en) .stamp-text {
  font-size: 24px;
  letter-spacing: 2px;
}

.btn:hover {
  background-color: var(--copper);
}

.btn:active {
  background-color: var(--ink-deep);
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --paper: #f3eedf;
  --vermilion: #b8322a;
}

