/* Generated by xtframe-import from "D1Carry". Edits are kept on re-import; see import-report.json. */

/* import: D1Carry.dc.html:1 */
#d1carry {
  background-color: #092e28;
}

/* import: D1Carry.dc.html:1/0 */
#bg {
  object-fit: cover;
}

/* import: D1Carry.dc.html:1/1 */
#dim {
  background-color: #092e2899;
}

.sys {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 14px;
  line-height: 21px;
  color: var(--ink);
  border-left-width: 3px;
  border-left-color: #b8322a;
}

.tick {
  background-color: #2f6b3a;
}

.it-n {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 20px;
  font-weight: 700;
  color: var(--ink-deep);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.it-d {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 12px;
  line-height: 16px;
  color: var(--ink);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
  white-space: nowrap;
}

:lang(en) .kicker {
  letter-spacing: 1px;
}

.sheet {
  background-color: #f3eedff2;
  border-top-width: 4px;
  border-top-color: #123a31;
  border-bottom-width: 1px;
  border-bottom-color: #123a31;
  effect: shadow(6px 6px 0px 0px #092e2899);
}

.h1 {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 28px;
  line-height: 38px;
  font-weight: 700;
  color: var(--ink-deep);
  white-space: nowrap;
}

:lang(en) .h1 {
  font-size: 24px;
}

.count {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 18px;
  line-height: 30px;
  font-weight: 700;
  color: var(--copper);
  white-space: nowrap;
  text-align: right;
}

.count.full {
  color: var(--vermilion);
}

.item {
  background-color: #fbf8ef;
  border: 1px #123a3166;
  border-left-width: 5px;
  border-left-color: #9ea7aa;
  transition: background-color 120ms linear;
}

.item:hover {
  background-color: #fff3cf;
}

.item.psy {
  border-left-color: #6b3a7a;
}

.item.sel {
  background-color: #e7f0e2;
  border: 2px #2f6b3a;
  border-left-width: 5px;
  border-left-color: #2f6b3a;
}

.box {
  border: 2px #123a31;
  background-color: var(--paper);
}

:lang(en) .it-n {
  font-size: 14px;
}

.it-k {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 11px;
  line-height: 16px;
  color: var(--copper);
  white-space: nowrap;
  text-align: right;
}

.item.psy .it-k {
  color: #6b3a7a;
}

.btn {
  text-align: center;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 18px;
  line-height: 44px;
  font-weight: 700;
  letter-spacing: 2px;
  color: var(--paper);
  white-space: nowrap;
  background-color: var(--ink);
  border: 1px #092e28;
  effect: shadow(3px 3px 0px 0px #092e2866);
  transition: background-color 120ms linear;
}

:lang(en) .btn {
  font-size: 16px;
  letter-spacing: 0px;
}

.btn:hover {
  background-color: var(--copper);
}

.btn.red {
  background-color: var(--vermilion);
  border-color: #5c1913;
}

.btn.red:hover {
  background-color: #d23f35;
}

.btn.paper {
  color: var(--ink);
  background-color: var(--paper);
  border-color: var(--ink);
}

.btn.paper:hover {
  color: var(--paper);
  background-color: var(--ink);
}

.dlg {
  background-color: #092e28eb;
  border-top-width: 2px;
  border-top-color: #a65432;
  border-bottom-width: 2px;
  border-bottom-color: #a65432;
}

.who {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
