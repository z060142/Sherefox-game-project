  border: 2px #123a31;
  effect: shadow(8px 8px 0px 0px #092e2899);
}

.c-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 19px;
  line-height: 30px;
  font-weight: 700;
  color: var(--ink-deep);
}

:lang(en) .c-t {
  font-size: 17px;
  line-height: 26px;
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --lamp-gold: #e0a050;
  --paper: #f3eedf;
  --vermilion: #b8322a;
}

