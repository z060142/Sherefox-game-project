.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
}

.btn {
  text-align: center;
  line-height: 42px;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  letter-spacing: 2px;
  color: var(--paper);
  background-color: var(--ink);
  border: 1px #092e28;
  effect: shadow(3px 3px 0px 0px #092e2866);
  transition: background-color 120ms linear;
}

.btn:hover {
  background-color: var(--copper);
}

.btn:active {
  background-color: var(--ink-deep);
}

.btn.off {
  color: #f3eedf8c;
  background-color: #5b6662;
  border-color: #5b6662;
}

.btn.off:hover {
  background-color: #5b6662;
}

.gbar {
  background-color: var(--copper);
}

.g1 .gbar {
  background-color: #9ea7aa;
}

.g2 .gbar {
  background-color: var(--ink-deep);
}

.g3 .gbar {
  background-color: var(--lamp-gold);
}

.g4 .gbar {
  background-color: #a6543280;
}

.drow {
  background-color: var(--paper);
  border: 1px #123a3199;
  effect: shadow(2px 2px 0px 0px #092e2840);
  transition: background-color 120ms linear;
}

.drow:hover {
  background-color: var(--paper-old);
}

.drow.placed {
  opacity: 0.55;
}

.drow.g3 {
  border-color: var(--lamp-gold);
}

.drow.g4 {
  border-style: dashed;
  border-color: var(--copper);
}

.drow.sel {
  background-color: var(--ink);
  border-color: var(--ink-deep);
  opacity: 1;
}

.drow-name {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 14px;
  line-height: 20px;
  color: var(--ink);
  line-clamp: 2;
}

.drow.sel .drow-name {
  color: var(--paper);
}

.qmark {
  border-radius: 10px;
  background-color: var(--vermilion);
  color: var(--paper);
  text-align: center;
  font-size: 13px;
  line-height: 20px;
  font-weight: 700;
}

.cork {
  background-color: #8d6a44;
  background-image: url("../shared/img/ui-cork.jpg");
  background-repeat: repeat;
  border: 6px #a65432;
  effect: shadow(4px 4px 0px 0px #092e2873);
}

.slot {
  border: 2px #f3eedf59;
  border-style: dashed;
  background-color: #092e2814;
  transition: background-color 120ms linear;
}

.slot:hover {
  border-color: var(--paper);
  background-color: #f3eedf33;
}

.rowno {
  border-radius: 14px;
  background-color: #f3eedfd9;
  border: 1px #092e28;
  text-align: center;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 26px;
  font-weight: 700;
  color: var(--ink-deep);
}

.clip {
  background-color: var(--paper);
  border: 1px #123a3166;
  effect: shadow(3px 4px 0px 0px #092e2866);
}

.clip:hover {
  background-color: #fbf8ef;
}

.clip.g1 {
  border-color: #9ea7aa;
}

.clip.g3 {
  border-color: var(--lamp-gold);
  effect: shadow(0px 0px 12px 2px #e0a050b3);
}

.clip.g4 {
  background-color: var(--paper-old);
  border-style: dashed;
  border-color: var(--copper);
}

.clip.sel {
  outline: 3px solid #b8322a;
  outline-offset: 2px;
}

.clip-name {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 19px;
  color: var(--ink);
  line-clamp: 4;
}

.pin {
  border-radius: 7px;
  background-color: var(--vermilion);
  border: 1px #092e28;
}

.thread-red {
  background-color: var(--vermilion);
  effect: shadow(0px 1px 0px 0px #092e2866);
}

.thread-gold {
  background-color: var(--lamp-gold);
  effect: shadow(0px 1px 0px 0px #092e2899);
}

.thread-pencil {
  border-top-width: 2px;
  border-top-color: #2e2f2d;
  border-top-style: dashed;
}

.plate {
  background-color: var(--copper);
  border: 1px #092e28;
  effect: shadow(3px 3px 0px 0px #092e2866);
}

.plate.empty {
  background-color: #dcc0a8;
  border-style: dashed;
}

.plate.empty .plate-t {
  color: var(--ink);
}

.plate-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 22px;
  font-weight: 700;
  color: var(--paper);
}

.plate-s {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  color: var(--paper);
  white-space: nowrap;
}

.plate-n {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  font-weight: 700;
  color: var(--lamp-gold);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.plate-dmg {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 30px;
  line-height: 36px;
  font-weight: 700;
  color: var(--paper);
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.plate-empty {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  color: var(--ink);
}

.panel {
  background-color: var(--paper);
  border-top-width: 3px;
  border-top-color: #123a31;
  border-bottom-width: 1px;
  border-bottom-color: #123a31;
  effect: shadow(3px 3px 0px 0px #092e2859);
}

.reason {
  background-color: var(--paper);
  border: 1px #123a3166;
  transition: background-color 120ms linear;
}

.reason:hover {
  background-color: var(--paper-old);
}

.reason.on {
  background-color: var(--ink-deep);
  border-color: var(--ink-deep);
}

.reason.fixed:hover {
  background-color: var(--paper);
}

.reason.on.fixed:hover {
  background-color: var(--ink-deep);
}

.reason-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 14px;
  line-height: 20px;
  color: var(--ink);
}

.reason.on .reason-t {
  color: var(--paper);
}

.radio {
  border-radius: 8px;
  border: 2px #123a31;
  background-color: var(--paper);
}

.reason.on .radio {
  border-color: var(--paper);
  background-color: var(--vermilion);
}

.bubble {
  background-color: var(--paper);
  border: 1px #123a31;
  border-left-width: 3px;
  border-left-color: #a65432;
  effect: shadow(3px 3px 0px 0px #092e2866);
}

.legend-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 12px;
  line-height: 16px;
  color: var(--ink);
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --lamp-gold: #e0a050;
  --paper: #f3eedf;
  --paper-old: #e3d9c2;
  --vermilion: #b8322a;
}

