  </layout>
  <style src="../shared/base.xts"/>
  <style src="d1book.xts"/>
  <timelines>
    @timeline in {
      #book {
        0ms {
          opacity: 0;
          transform: translate(0px, 14px);
        }
        220ms ease-out {
          opacity: 1;
          transform: translate(0px, 0px);
        }
      }
    }
    @timeline rm-in {
      #remark {
        0ms {
          opacity: 0;
        }
        260ms ease-out {
          opacity: 1;
        }
      }
    }
  </timelines>
</xt>
