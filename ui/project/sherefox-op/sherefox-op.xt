  <layout>
    /* import: Main.dc.html:1 */
    /* v3 integration (Sherefox docs/v3-op.md): the game's UI project designs at logicalHeight 720 with uiscaleRule
       fit, which would scale px by 1.5 on this 1920x1080 surface; a coefficient clamped to 1 keeps the OP's px as it
       was made (ui-scale: none would be the natural value, but v0.19.0 applies the dpr twice with it). */
    #sherefox-op {
      ui-scale: clamp(1, 1);
      height: 100vh;
      margin-bottom: 0;
      margin-left: 0;
      margin-right: 0;
      margin-top: 0;
      overflow: hidden;
      position: relative;
      width: 100vw;
    }
    /* import: Main.dc.html:1/0 */
    #stage {
      anchor: stretch stretch screen;
    }
    /* import: Main.dc.html:1/0/0 */
    #scene-intro {
      height: 1080px;
      left: 0;
      overflow: hidden;
      position: absolute;
      top: 0;
      width: 1920px;
