<xt version="2">
  <head>
    <title>VN</title>
  </head>

  <ports>
    bg: string in = "kitchen_morning"
    slot_l: string in = "sherefox"
    slot_c: string in = ""
    slot_r: string in = "arthur"
    focus: number in = 1
    speaker: string in = "Sherefox"
    line: string in = "我的布丁不見了。盤子還在，小旗還在，布丁不在。這是綁架。"
    line_seq: number in = 0
    style: number in = 0
    choice_count: number in = 0
    choice1: string in = "再打開冰箱看一次"
    choice2: string in = "問亞瑟昨晚幾點睡"
    choice3: string in = "【摔壞的懷錶】那只懷錶怎麼了？"
    choice4: string in = "先吃早餐再說"
    choice_locked1: bool in = false
    choice_locked2: bool in = false
    choice_locked3: bool in = true
    choice_locked4: bool in = false
    trust: number in = -1
    chapter_title: string in = "第 1 章　消失的發條焦糖布丁"
    advance: event out
    choose: number out = 0
    auto: event out
    skip: event out
    log: event out
    settings: event out
  </ports>

  <body on:show="play(reveal)" key-activation="none">
    <div id="vn" tabindex="0" autofocus="" on:key(Enter)="if port(choice_count) eq 0 emit(advance)" on:key(Space)="if port(choice_count) eq 0 emit(advance)" on:key(A)="emit(auto)" on:key(Backspace)="emit(log)" on:key(1)="if port(choice_count) ge 1 set(choose, 1)" on:key(2)="if port(choice_count) ge 2 set(choose, 2)" on:key(3)="if port(choice_count) ge 3 set(choose, 3)" on:key(4)="if port(choice_count) ge 4 set(choose, 4)" on:key(Escape)="emit(settings)" on:key(F1)="emit(settings)">
      <div id="bg" on:port(bg)="play(bg-in)">
        <div id="bg-art">
          <img id="bg-office-night" class="bg-art" src="../shared/img/bg-office-night.jpg" bind:display="bg | eq('office_night')"/>
          <img id="bg-office-day" class="bg-art" src="../shared/img/bg-office-day.jpg" bind:display="bg | eq('office_day')"/>
          <img id="bg-kitchen-morning" class="bg-art" src="../shared/img/bg-kitchen-morning.jpg" bind:display="bg | eq('kitchen_morning')"/>
          <img id="bg-clockshop" class="bg-art" src="../shared/img/bg-clockshop.jpg" bind:display="bg | eq('clockshop')"/>
          <img id="bg-dock-fog" class="bg-art" src="../shared/img/bg-dock-fog.jpg" bind:display="bg | eq('dock_fog')"/>
          <img id="bg-barge-deck" class="bg-art" src="../shared/img/bg-barge-deck.jpg" bind:display="bg | eq('barge_deck')"/>
          <img id="bg-boiler-room" class="bg-art" src="../shared/img/bg-boiler-room.jpg" bind:display="bg | eq('boiler_room')"/>
          <img id="bg-debate" class="bg-art" src="../shared/img/bg-debate.jpg" bind:display="bg | eq('debate')"/>
        </div>
      </div>
      <div id="slot-c" class="fig" bind:class.dim="focus | ne(2)" bind:class.narr="focus | eq(0)">
        <div id="ink-c" on:port(slot_c)="play(ink-in-c)">
          <img id="ch-c-sherefox" class="ch-art" src="../shared/img/ch-c-sherefox.png" bind:display="slot_c | eq('sherefox')"/>
          <img id="ch-c-arthur" class="ch-art" src="../shared/img/ch-c-arthur.png" bind:display="slot_c | eq('arthur')"/>
          <img id="ch-c-baskerville" class="ch-art" src="../shared/img/ch-c-baskerville.png" bind:display="slot_c | eq('baskerville')"/>
          <img id="ch-c-victor" class="ch-art" src="../shared/img/ch-c-victor.png" bind:display="slot_c | eq('victor')"/>
          <img id="ch-c-wolfhart" class="ch-art" src="../shared/img/ch-c-wolfhart.png" bind:display="slot_c | eq('wolfhart')"/>
          <img id="ch-c-valet" class="ch-art" src="../shared/img/ch-c-valet.png" bind:display="slot_c | eq('valet')"/>
          <img id="ch-c-partner" class="ch-art" src="../shared/img/ch-c-partner.png" bind:display="slot_c | eq('partner')"/>
        </div>
      </div>
      <div id="slot-l" class="fig" bind:class.dim="focus | ne(1)" bind:class.narr="focus | eq(0)">
        <div id="ink-l" on:port(slot_l)="play(ink-in-l)">
          <img id="ch-l-sherefox" class="ch-art" src="../shared/img/ch-c-sherefox.png" bind:display="slot_l | eq('sherefox')"/>
          <img id="ch-l-arthur" class="ch-art" src="../shared/img/ch-c-arthur.png" bind:display="slot_l | eq('arthur')"/>
          <img id="ch-l-baskerville" class="ch-art" src="../shared/img/ch-c-baskerville.png" bind:display="slot_l | eq('baskerville')"/>
          <img id="ch-l-victor" class="ch-art" src="../shared/img/ch-c-victor.png" bind:display="slot_l | eq('victor')"/>
          <img id="ch-l-wolfhart" class="ch-art" src="../shared/img/ch-c-wolfhart.png" bind:display="slot_l | eq('wolfhart')"/>
          <img id="ch-l-valet" class="ch-art" src="../shared/img/ch-c-valet.png" bind:display="slot_l | eq('valet')"/>
          <img id="ch-l-partner" class="ch-art" src="../shared/img/ch-c-partner.png" bind:display="slot_l | eq('partner')"/>
        </div>
      </div>
      <div id="slot-r" class="fig" bind:class.dim="focus | ne(3)" bind:class.narr="focus | eq(0)">
        <div id="ink-r" on:port(slot_r)="play(ink-in-r)">
          <img id="ch-r-sherefox" class="ch-art" src="../shared/img/ch-c-sherefox.png" bind:display="slot_r | eq('sherefox')"/>
          <img id="ch-r-arthur" class="ch-art" src="../shared/img/ch-c-arthur.png" bind:display="slot_r | eq('arthur')"/>
          <img id="ch-r-baskerville" class="ch-art" src="../shared/img/ch-c-baskerville.png" bind:display="slot_r | eq('baskerville')"/>
          <img id="ch-r-victor" class="ch-art" src="../shared/img/ch-c-victor.png" bind:display="slot_r | eq('victor')"/>
          <img id="ch-r-wolfhart" class="ch-art" src="../shared/img/ch-c-wolfhart.png" bind:display="slot_r | eq('wolfhart')"/>
          <img id="ch-r-valet" class="ch-art" src="../shared/img/ch-c-valet.png" bind:display="slot_r | eq('valet')"/>
          <img id="ch-r-partner" class="ch-art" src="../shared/img/ch-c-partner.png" bind:display="slot_r | eq('partner')"/>
        </div>
      </div>
      <div id="shade" bind:display="bg | ne('')"/>
      <div id="hit" on:click(left)="if port(choice_count) eq 0 emit(advance)"/>
      <div id="hud-tr">
        <div id="chapter-tag" bind:text="chapter_title" bind:display="chapter_title | ne('')">第 1 章　消失的發條焦糖布丁</div>
        <div id="trust" bind:display="trust | ge(0)">
          <div id="badge-1" class="badge" bind:class.on="trust | ge(1)"/>
          <div id="badge-2" class="badge" bind:class.on="trust | ge(2)"/>
          <div id="badge-3" class="badge" bind:class.on="trust | ge(3)"/>
          <div id="badge-4" class="badge" bind:class.on="trust | ge(4)"/>
          <div id="badge-5" class="badge" bind:class.on="trust | ge(5)"/>
        </div>
      </div>
      <div id="dlg-dock">
        <div id="dlg" class="dlg s-e1040c" bind:class.note="style | eq(1)" bind:class.sys="style | eq(2)">
          <div id="dlg-rule" class="dlg-rule"/>
          <div id="dlg-body" on:click(left)="if port(choice_count) eq 0 emit(advance)">
            <div id="nameplate" bind:display="speaker | ne('')">
              <div id="speaker" class="kicker" bind:text="speaker">Sherefox</div>
              <div id="speaker-rule"/>
            </div>
            <div id="line" class="line" on:port(line_seq)="play(reveal)" bind:text="line">我的布丁不見了。盤子還在，小旗還在，布丁不在。這是綁架。</div>
            <div id="choices" bind:display="choice_count | gt(0)">
              <div id="choice-1" class="choice" on:click(left)="set(choose, 1)" bind:display="choice_count | ge(1)" bind:class.locked="choice_locked1">
                <div id="choice-1-num" class="choice-num">1</div>
                <svg id="choice-1-key" class="choice-key" bind:display="choice_locked1" viewBox="0 0 22 22">
                  <circle id="Bow" cx="6.5" cy="11" r="4" fill="none" stroke="#a65432" stroke-width="2.5"/>
                  <path id="Bit" d="M10.5 11 H20 M17 11 V15 M20 11 V14" fill="none" stroke="#a65432" stroke-width="2.5" stroke-linecap="square"/>
                </svg>
                <div id="choice-1-text" class="choice-text" bind:text="choice1">再打開冰箱看一次</div>
              </div>
              <div id="choice-2" class="choice" on:click(left)="set(choose, 2)" bind:display="choice_count | ge(2)" bind:class.locked="choice_locked2">
                <div id="choice-2-num" class="choice-num">2</div>
                <svg id="choice-2-key" class="choice-key" bind:display="choice_locked2" viewBox="0 0 22 22">
                  <circle id="Bow" cx="6.5" cy="11" r="4" fill="none" stroke="#a65432" stroke-width="2.5"/>
                  <path id="Bit" d="M10.5 11 H20 M17 11 V15 M20 11 V14" fill="none" stroke="#a65432" stroke-width="2.5" stroke-linecap="square"/>
                </svg>
                <div id="choice-2-text" class="choice-text" bind:text="choice2">問亞瑟昨晚幾點睡</div>
              </div>
              <div id="choice-3" class="choice" on:click(left)="set(choose, 3)" bind:display="choice_count | ge(3)" bind:class.locked="choice_locked3">
                <div id="choice-3-num" class="choice-num">3</div>
                <svg id="choice-3-key" class="choice-key" bind:display="choice_locked3" viewBox="0 0 22 22">
                  <circle id="Bow" cx="6.5" cy="11" r="4" fill="none" stroke="#a65432" stroke-width="2.5"/>
                  <path id="Bit" d="M10.5 11 H20 M17 11 V15 M20 11 V14" fill="none" stroke="#a65432" stroke-width="2.5" stroke-linecap="square"/>
                </svg>
                <div id="choice-3-text" class="choice-text" bind:text="choice3">【摔壞的懷錶】那只懷錶怎麼了？</div>
              </div>
              <div id="choice-4" class="choice" on:click(left)="set(choose, 4)" bind:display="choice_count | ge(4)" bind:class.locked="choice_locked4">
                <div id="choice-4-num" class="choice-num">4</div>
                <svg id="choice-4-key" class="choice-key" bind:display="choice_locked4" viewBox="0 0 22 22">
                  <circle id="Bow" cx="6.5" cy="11" r="4" fill="none" stroke="#a65432" stroke-width="2.5"/>
                  <path id="Bit" d="M10.5 11 H20 M17 11 V15 M20 11 V14" fill="none" stroke="#a65432" stroke-width="2.5" stroke-linecap="square"/>
                </svg>
                <div id="choice-4-text" class="choice-text" bind:text="choice4">先吃早餐再說</div>
              </div>
            </div>
            <svg id="more" bind:display="choice_count | eq(0)" viewBox="0 0 14 10">
              <polygon id="Tri" points="0,0 14,0 7,10" fill="#a65432"/>
            </svg>
          </div>
          <div id="quickbar">
            <div id="qb-auto" class="qb" on:click(left)="emit(auto)">@BTN_AUTO</div>
            <div id="qb-skip" class="qb" on:click(left)="emit(skip)">@BTN_FAST</div>
            <div id="qb-log" class="qb" on:click(left)="emit(log)">@BTN_LOG</div>
          </div>
        </div>
      </div>
    </div>
  </body>

  <layout>
    /* import: Vn.dc.html:1 */
    #vn {
      height: 100vh;
      margin-bottom: 0;
      margin-left: 0;
      margin-right: 0;
      margin-top: 0;
      overflow: hidden;
      position: relative;
      width: 100vw;
    }
    /* import: Vn.dc.html:1/0 */
    #bg {
      anchor: stretch stretch screen;
    }
    /* import: Vn.dc.html:1/0/0 */
    #bg-art {
      height: 100%;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 100%;
    }
    /* import: Vn.dc.html:1/1 */
    #slot-c {
      anchor: center bottom;
      offset: 0 -28px;
      size: 440px 660px;
    }
    /* import: Vn.dc.html:1/1/0 */
    #ink-c {
      height: 660px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 440px;
    }
    /* import: Vn.dc.html:1/2 */
    #slot-l {
      anchor: left bottom;
      offset: 8px -28px;
      size: 440px 660px;
    }
    /* import: Vn.dc.html:1/2/0 */
    #ink-l {
      height: 660px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 440px;
    }
    /* import: Vn.dc.html:1/3 */
    #slot-r {
      anchor: right bottom;
      offset: 8px -28px;
      size: 440px 660px;
    }
    /* import: Vn.dc.html:1/3/0 */
    #ink-r {
      height: 660px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 440px;
    }
    /* import: Vn.dc.html:1/4 */
    #shade {
      bottom: calc(1safe-bottom - 18px);
      height: 320px;
      left: 0;
      position: absolute;
      right: 0;
    }
    /* import: Vn.dc.html:1/5 */
    #hit {
      anchor: stretch stretch screen;
    }
    /* import: Vn.dc.html:1/6 */
    #hud-tr {
      align-items: flex-end;
      anchor: right top;
      display: flex;
      flex-direction: column;
      gap: 6px;
      offset: 8px 6px;
      size: 600px 76px;
    }
    /* import: Vn.dc.html:1/6/0 */
    #chapter-tag {
      flex-shrink: 0;
      height: 36px;
      max-width: 600px;
      padding-bottom: 0px;
      padding-left: 14px;
      padding-right: 14px;
      padding-top: 0px;
    }
    /* import: Vn.dc.html:1/6/1 */
    #trust {
      align-items: center;
      display: flex;
      flex-direction: row;
      flex-shrink: 0;
      gap: 6px;
      height: 34px;
      justify-content: center;
      width: 148px;
    }
    /* import: Vn.dc.html:1/7 */
    #dlg-dock {
      anchor: center bottom;
      offset: 0 2px;
      size: 1000px 200px;
    }
    /* import: Vn.dc.html:1/7/0 */
    #dlg {
      bottom: 0px;
      display: flex;
      flex-direction: column;
      left: 0px;
      padding-bottom: 0px;
      padding-left: 0px;
      padding-right: 0px;
      padding-top: 3px;
      position: absolute;
      width: 1000px;
    }
    /* import: Vn.dc.html:1/7/0/0 */
    #dlg-rule {
      flex-shrink: 0;
      height: 1px;
      width: 1000px;
    }
    /* import: Vn.dc.html:1/7/0/1 */
    #dlg-body {
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      gap: 6px;
      padding-bottom: 20px;
      padding-left: 32px;
      padding-right: 32px;
      padding-top: 12px;
      position: relative;
      width: 1000px;
    }
    /* import: Vn.dc.html:1/7/0/1/0 */
    #nameplate {
      align-items: center;
      display: flex;
      flex-direction: row;
      flex-shrink: 0;
      gap: 12px;
      height: 24px;
      width: 936px;
    }
    /* import: Vn.dc.html:1/7/0/1/0/0 */
    #speaker {
      flex-shrink: 0;
      height: 22px;
      min-width: 40px;
    }
    /* import: Vn.dc.html:1/7/0/1/0/1 */
    #speaker-rule {
      flex-shrink: 0;
      height: 1px;
      width: 48px;
    }
    /* import: Vn.dc.html:1/7/0/1/1 */
    #line {
      flex-shrink: 0;
      min-height: 68px;
      width: 936px;
    }
    /* import: Vn.dc.html:1/7/0/1/2 */
    #choices {
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      gap: 6px;
      padding-bottom: 0px;
      padding-left: 0px;
      padding-right: 0px;
      padding-top: 6px;
      width: 936px;
    }
    /* import: Vn.dc.html:1/7/0/1/3 */
    #more {
      bottom: 10px;
      height: 10px;
      position: absolute;
      right: 24px;
      width: 14px;
    }
    /* import: Vn.dc.html:1/7/0/2 */
    #quickbar {
      display: flex;
      flex-direction: row;
      gap: 4px;
      height: 26px;
      justify-content: flex-end;
      position: absolute;
      right: 0px;
      top: -29px;
      width: 240px;
    }
    .bg-art {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    .ch-art {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 440px;
      height: 660px;
    }
    .qb {
      width: 76px;
      height: 26px;
      padding-top: 0px;
      padding-right: 0px;
      padding-bottom: 0px;
      padding-left: 0px;
      flex-shrink: 0;
    }
    .choice {
      width: 936px;
      height: 40px;
      flex-shrink: 0;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 12px;
      padding-top: 0px;
      padding-right: 16px;
      padding-bottom: 0px;
      padding-left: 16px;
    }
    .choice-num {
      width: 18px;
      height: 24px;
      flex-shrink: 0;
    }
    .choice-key {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
    }
    .choice-text {
      height: 24px;
      flex-grow: 1;
      min-width: 200px;
      overflow: hidden;
    }
    .badge {
      width: 18px;
      height: 22px;
      flex-shrink: 0;
    }
    .note .dlg-rule {
      display: none;
    }
    .note .line {
      padding-left: 16px;
      transform: skewX(-6deg);
    }
  </layout>
  <style src="../shared/base.xts"/>
  <style src="vn.xts"/>
  <timelines>
    @timeline bg-in {
      #bg-art {
        0ms {
          opacity: 0.35;
        }
        360ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline idle {
      #more {
        0ms {
          opacity: 1;
        }
        600ms ease-in-out {
          opacity: 0.25;
        }
        1200ms ease-in-out {
          opacity: 1;
        }
      }
    }
    @timeline ink-in-c {
      #ink-c {
        0ms {
          opacity: 0;
        }
        420ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline ink-in-l {
      #ink-l {
        0ms {
          opacity: 0;
        }
        420ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline ink-in-r {
      #ink-r {
        0ms {
          opacity: 0;
        }
        420ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline reveal {
      #line {
        0ms {
          opacity: 0;
          transform: translateY(6px);
        }
        260ms ease-out {
          opacity: 1;
          transform: translateY(0px);
        }
      }
    }
  </timelines>
</xt>
