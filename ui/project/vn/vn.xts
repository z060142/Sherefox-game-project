/* Generated by xtframe-import from "VN". Edits are kept on re-import; see import-report.json. */

/* import: Vn.dc.html:1 */
#vn {
  background-color: #f3eedf;
  background-color: var(--paper);
  color: var(--ink);
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

/* import: Vn.dc.html:1/0 */
#bg {
  background-color: var(--paper);
}

/* import: Vn.dc.html:1/4 */
#shade {
  background-gradient: linear-gradient(180deg, #092e2800 0%, #092e2873 100%);
}

/* import: Vn.dc.html:1/6/0 */
#chapter-tag {
  background-color: var(--paper);
  border-bottom-color: #123a31;
  border-bottom-width: 1px;
  border-top-color: #123a31;
  border-top-width: 3px;
  color: var(--ink);
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 31px;
  text-align: right;
  white-space: nowrap;
}

/* import: Vn.dc.html:1/6/1 */
#trust {
  background-color: var(--paper);
  border-bottom-color: #123a31;
  border-bottom-width: 1px;
}

/* import: Vn.dc.html:1/7 */
#dlg-dock {
  pointer-events: none;
}

/* import: Vn.dc.html:1/7/0 */
#dlg {
  pointer-events: auto;
}

/* import: Vn.dc.html:1/7/0/1/0/1 */
#speaker-rule {
  background-color: var(--copper);
}

.bg-art {
  object-fit: cover;
}

.ch-art {
  object-fit: contain;
}

.fig {
  effect: color-adjust(brightness(0) saturate(0));
  transition: effect 220ms ease-out;
}

.fig.dim {
  effect: color-adjust(brightness(-0.14) saturate(-0.5));
}

.fig.dim.narr {
  effect: color-adjust(brightness(0) saturate(0));
}

.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 14px;
  line-height: 22px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
}

.qb {
  line-height: 25px;
  text-align: center;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 12px;
  letter-spacing: 2px;
  color: var(--ink);
  background-color: var(--paper);
  border: 1px #123a31;
  border-bottom-width: 0px;
  transition: background-color 120ms linear, color 120ms linear;
}

.qb:hover {
  color: var(--paper);
  background-color: var(--ink);
}

.qb:active {
  color: var(--ink);
  background-color: var(--paper-old);
}

.choice {
  background-color: var(--paper);
  border: 1px #123a31;
  transition: background-color 120ms linear;
}

.choice:hover {
  background-color: var(--ink);
}

.choice:active {
  background-color: var(--paper-old);
}

.choice-num {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 24px;
  text-align: center;
  color: var(--copper);
}

.choice-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 18px;
  line-height: 24px;
  color: var(--ink);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.choice:hover .choice-text {
  color: var(--paper);
}

.choice:hover .choice-num {
  color: var(--lamp-gold);
}

.choice.locked {
  border-color: var(--copper);
}

.choice.locked .choice-text {
  color: var(--copper);
}

.choice.locked:hover .choice-text {
  color: var(--lamp-gold);
}

.badge {
  border: 2px #123a31;
  border-radius: 0px 0px 9px 9px;
  background-color: var(--paper);
}

.badge.on {
  background-color: var(--copper);
  border-color: var(--ink-deep);
}

.dlg {
  background-color: var(--paper);
  border-top-width: 3px;
  border-top-color: #123a31;
  border-bottom-width: 1px;
  border-bottom-color: #123a31;
  effect: shadow(4px 4px 0px 0px #092e2859);
}

.dlg-rule {
  background-color: var(--ink);
}

.line {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 22px;
  line-height: 34px;
  color: var(--ink);
}

.dlg.note {
  background-color: var(--paper-old);
  border-top-color: var(--copper);
}

.note .line {
  font-style: italic;
  color: var(--ink-deep);
  background-image: url("../shared/img/ui-ruled.png");
  background-repeat: repeat;
  border-left-width: 2px;
  border-left-color: #a65432;
}

.dlg.sys {
  background-color: var(--ink-deep);
  border-top-color: var(--copper);
}

.sys .dlg-rule {
  background-color: var(--copper);
}

.sys .line {
  color: var(--paper);
  text-align: center;
  font-size: 19px;
}

.sys .kicker {
  color: var(--lamp-gold);
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --lamp-gold: #e0a050;
  --paper: #f3eedf;
  --paper-old: #e3d9c2;
}

