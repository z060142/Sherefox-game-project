/* Generated by xtframe-import from "D1Inv". Edits are kept on re-import; see import-report.json. */

/* import: D1Inv.dc.html:1 */
#d1inv {
  background-color: #092e28;
  background-color: #092e28;
  color: #123a31;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

/* import: D1Inv.dc.html:1/0/0 */
#bg {
  background-color: #f3eedf;
}

/* import: D1Inv.dc.html:1/0/1 */
#shade-top {
  background-gradient: linear-gradient(180deg, #092e2880 0%, #092e2800 100%);
}

/* import: D1Inv.dc.html:1/1/1 */
#hud-appr {
  color: #a65432;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
  white-space: nowrap;
}

.bg-art {
  object-fit: cover;
}

.fig {
  object-fit: contain;
}

.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
  white-space: nowrap;
}

:lang(en) .kicker {
  letter-spacing: 1px;
}

.hud-card {
  background-color: var(--paper);
  border-top-width: 3px;
  border-top-color: #123a31;
  border-bottom-width: 1px;
  border-bottom-color: #123a31;
  effect: shadow(3px 3px 0px 0px #092e2859);
}

.ring {
  opacity: 0;
  border: 2px #2e2f2dd9;
  border-radius: 50%;
  effect: shadow(0px 0px 22px 4px #e0a050a6);
  transition: opacity 140ms ease-out;
}

.chip {
  opacity: 0;
  border-radius: 20px;
  background-color: #f3eedfeb;
  border: 2px #a65432;
  transition: opacity 140ms ease-out;
}

.spot-name {
  opacity: 0;
  text-align: center;
  white-space: nowrap;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 14px;
  line-height: 26px;
  color: var(--paper);
  background-color: #092e28d9;
  text-overflow: ellipsis;
  transition: opacity 140ms ease-out;
}

.spot:hover .ring {
  opacity: 1;
}

.spot:hover .chip {
  opacity: 1;
}

.spot:hover .spot-name {
  opacity: 1;
}

.spot.done .ring {
  opacity: 0.45;
  border-color: #e3d9c299;
  effect: shadow(0px 0px 0px 0px #e0a05000);
}

.spot.done .chip {
  opacity: 0.85;
  border-color: #5b6662;
  background-color: #e3d9c2d9;
}

.spot.done:hover .ring {
  opacity: 0.8;
}

.ico {
  object-fit: contain;
}

.ico-done {
  object-fit: contain;
  background-color: var(--paper);
  border-radius: 10px;
}

.loc {
  background-color: #f3eedfe6;
  border: 1px #123a31;
  border-top-width: 3px;
  border-top-color: #123a31;
  effect: shadow(2px 2px 0px 0px #092e2859);
  transition: background-color 120ms linear;
}

.loc:hover {
  background-color: #fff3cf;
}

.loc.sel {
  background-color: var(--ink);
  border-top-color: var(--vermilion);
}

.loc-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 18px;
  font-weight: 700;
  color: var(--ink-deep);
  text-align: center;
  line-clamp: 2;
}

:lang(en) .loc-t {
  font-size: 12px;
  line-height: 15px;
}

.loc.sel .loc-t {
  color: var(--paper);
}

.loc-done {
  border-radius: 8px;
  background-color: var(--copper);
}

.btn {
  text-align: center;
  line-height: 42px;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  letter-spacing: 2px;
  color: var(--paper);
  white-space: nowrap;
  background-color: var(--ink);
  border: 1px #092e28;
  effect: shadow(3px 3px 0px 0px #092e2866);
  transition: background-color 120ms linear;
}

:lang(en) .btn {
  font-size: 14px;
  letter-spacing: 0px;
}

.btn:hover {
  background-color: var(--copper);
}

.btn:active {
  background-color: var(--ink-deep);
}

.btn.paper {
  color: var(--ink);
  background-color: var(--paper);
  border-color: var(--ink);
}

.btn.paper:hover {
  color: var(--paper);
  background-color: var(--ink);
}

.dot {
  border-radius: 12px;
  background-color: var(--vermilion);
  color: var(--paper);
  font-size: 13px;
  line-height: 24px;
  text-align: center;
  font-weight: 700;
  pointer-events: none;
}

.pop-title {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 24px;
  line-height: 32px;
  font-weight: 700;
  color: var(--ink-deep);
}

.pop-body {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 17px;
  line-height: 27px;
  color: var(--ink);
}

:lang(en) .pop-body {
  font-size: 16px;
  line-height: 24px;
}

.pop-line {
  background-color: var(--paper-old);
  border-left-width: 3px;
  border-left-color: #a65432;
}

.pop-spk {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 18px;
  letter-spacing: 2px;
  font-weight: 700;
  color: var(--copper);
}

.pop-line-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  line-height: 25px;
  color: var(--ink-deep);
}

.got {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 22px;
  font-weight: 700;
  color: var(--vermilion);
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --paper: #f3eedf;
  --paper-old: #e3d9c2;
  --vermilion: #b8322a;
}

