<xt version="2">
  <head>
    <title>D1Inv</title>
  </head>

  <ports>
    bg: string in = "parlour"
    hud_title: string in = "蒐證"
    appr_text: string in = "鑑定 剩 2 次"
    locs: list<struct{id: string, name: string, sel: bool, done: bool}> in = [{"id":"PARLOR","name":"靈堂","sel":true,"done":false},{"id":"STUDY","name":"書房","sel":false,"done":false},{"id":"BASEMENT","name":"地下室（含廚房）","sel":false,"done":false},{"id":"ATTIC","name":"閣樓（含傭人房）","sel":false,"done":true},{"id":"BEDROOM","name":"塞德里克的臥室","sel":false,"done":false},{"id":"HALL","name":"門廳","sel":false,"done":false}]
    spots: list<struct{id: string, name: string, x: number, y: number, w: number, h: number, type: number, state: number}> in = [{"id":"HS04","name":"遺體照","x":470,"y":42,"w":246,"h":216,"type":0,"state":1},{"id":"HS06","name":"門口的黑紗花圈","x":1166,"y":138,"w":108,"h":274,"type":1,"state":0}]
    book_new: number in = 1
    popup_on: bool in = false
    popup_seq: number in = 0
    popup_title: string in = "警督保管的箱子"
    popup_body: string in = "警督把布里格斯的東西收在一個木箱裡：一圈萬用鑰匙，每一把都油亮亮的；一張工作單，字跡工整。"
    popup_speaker: string in = "亞瑟"
    popup_line: string in = "鑰匙全上了油。鎖匠的習慣。"
    popup_got: string in = "取得：萬用鑰匙圈、布里格斯的工作單"
    popup_note: string in = ""
    spot: string out = ""
    pick_loc: string out = ""
    dismiss: event out
    book: event out
    notes: event out
    end: event out
    settings: event out
  </ports>

  <body key-activation="none">
    <div id="d1inv" tabindex="0" autofocus="" on:key(Escape)="if port(popup_on) eq true emit(dismiss) else emit(settings)" on:key(Enter)="if port(popup_on) eq true emit(dismiss)" on:key(Space)="if port(popup_on) eq true emit(dismiss)" on:key(Tab)="emit(book)" on:key(N)="emit(notes)" on:key(F1)="emit(settings)">
      <div id="scene">
        <div id="bg" on:port(bg)="play(bg-in)">
          <div id="bg-art">
            <img id="bg-parlour" class="bg-art" src="../shared/img/bg-d01-parlour.jpg" bind:display="bg | eq('parlour')"/>
            <img id="bg-study" class="bg-art" src="../shared/img/bg-study.jpg" bind:display="bg | eq('study')"/>
            <img id="bg-basement" class="bg-art" src="../shared/img/bg-basement.jpg" bind:display="bg | eq('basement')"/>
            <img id="bg-attic" class="bg-art" src="../shared/img/bg-attic.jpg" bind:display="bg | eq('attic')"/>
            <img id="bg-bedroom" class="bg-art" src="../shared/img/bg-bedroom.jpg" bind:display="bg | eq('bedroom')"/>
            <img id="bg-hall" class="bg-art" src="../shared/img/bg-hall.jpg" bind:display="bg | eq('hall')"/>
            <div id="figs-parlour" bind:display="bg | eq('parlour')">
              <img id="fig-cedric" class="fig" src="../shared/img/cedric-composed.png"/>
              <img id="fig-hyde" class="fig" src="../shared/img/fig-hyde.png"/>
              <img id="fig-irene" class="fig" src="../shared/img/fig-irene.png"/>
            </div>
            <div id="figs-study" bind:display="bg | eq('study')">
              <img id="fig-irene-door" class="fig" src="../shared/img/fig-irene.png"/>
            </div>
            <div id="figs-hall" bind:display="bg | eq('hall')">
              <img id="fig-briggs" class="fig" src="../shared/img/fig-briggs.png"/>
            </div>
          </div>
        </div>
        <div id="shade-top"/>
        <div id="spots-layer">
          <repeat id="spots-list" port="spots">
            <div id="spot" class="spot" on:click(left)="if port(popup_on) eq false set(spot, item(id))" bind:translate-x="item(x)" bind:translate-y="item(y)" bind:width="item(w) | range(0, 1280, 0px, 1280px)" bind:height="item(h) | range(0, 720, 0px, 720px)" bind:class.done="item(state) | eq(1)">
              <div id="spot-ring" class="ring"/>
              <div id="spot-chip" class="chip">
                <img id="ico-look" class="ico" src="../shared/img/ico-look.png" bind:display="item(type) | eq(0)"/>
                <img id="ico-item" class="ico" src="../shared/img/ico-item.png" bind:display="item(type) | eq(1)"/>
                <img id="ico-talk" class="ico" src="../shared/img/ico-talk.png" bind:display="item(type) | eq(2)"/>
                <img id="ico-done" class="ico-done" src="../shared/img/ico-done.png"/>
              </div>
              <div id="spot-name" class="spot-name" bind:text="item(name)">遺體照</div>
            </div>
          </repeat>
        </div>
      </div>
      <div id="hud" class="hud-card">
        <div id="hud-title" class="kicker" bind:text="hud_title">蒐證</div>
        <div id="hud-appr" bind:text="appr_text">鑑定 剩 2 次</div>
      </div>
      <repeat id="locs" port="locs">
        <div id="loc" class="loc" on:click(left)="if port(popup_on) eq false set(pick_loc, item(id))" bind:class.sel="item(sel)" bind:class.done="item(done)">
          <div id="loc-t" class="loc-t" bind:text="item(name)">靈堂</div>
          <div id="loc-done" class="loc-done"/>
        </div>
      </repeat>
      <div id="actions">
        <div id="btn-book" class="btn paper" on:click(left)="emit(book)">@UI_V2_EVLIST</div>
        <div id="book-dot" class="dot" bind:display="book_new | gt(0)" bind:text="book_new">1</div>
        <div id="btn-notes" class="btn paper" on:click(left)="emit(notes)">@UI_V2_NOTES_PAGE</div>
        <div id="btn-end" class="btn" on:click(left)="emit(end)">@BTN_INV_END</div>
      </div>
      <div id="pop" bind:display="popup_on">
        <div id="pop-shade" class="s-8ecb27" on:click(left)="emit(dismiss)"/>
        <div id="pop-card" class="hud-card s-66a9df" on:port(popup_seq)="play(pop-in)">
          <div id="pop-kicker" class="kicker" bind:text="hud_title">蒐證</div>
          <div id="pop-title" class="pop-title" bind:text="popup_title">警督保管的箱子</div>
          <div id="pop-rule" class="s-614666"/>
          <div id="pop-body" class="pop-body" bind:text="popup_body">警督把布里格斯的東西收在一個木箱裡：一圈萬用鑰匙，每一把都油亮亮的；一張工作單，字跡工整。</div>
          <div id="pop-line" class="pop-line" bind:display="popup_line | ne('')">
            <div id="pop-spk" class="pop-spk" bind:text="popup_speaker">亞瑟</div>
            <div id="pop-line-text" class="pop-line-text" bind:text="popup_line">鑰匙全上了油。鎖匠的習慣。</div>
          </div>
          <div id="pop-got" class="got" bind:text="popup_got" bind:display="popup_got | ne('')">取得：萬用鑰匙圈、布里格斯的工作單</div>
          <div id="pop-note" class="got" bind:text="popup_note" bind:display="popup_note | ne('')">記下了一條人物筆記。</div>
          <div id="pop-close" class="s-1fc96b">@BTN_CLOSE</div>
        </div>
      </div>
    </div>
  </body>

  <layout>
    /* import: D1Inv.dc.html:1 */
    #d1inv {
      height: 100vh;
      margin-bottom: 0;
      margin-left: 0;
      margin-right: 0;
      margin-top: 0;
      overflow: hidden;
      position: relative;
      width: 100vw;
    }
    /* import: D1Inv.dc.html:1/0 */
    #scene {
      height: 720px;
      left: calc(50% - 640px);
      overflow: hidden;
      position: absolute;
      top: calc(50% - 360px);
      width: 1280px;
    }
    /* import: D1Inv.dc.html:1/0/0 */
    #bg {
      height: 720px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 1280px;
    }
    /* import: D1Inv.dc.html:1/0/0/0 */
    #bg-art {
      height: 100%;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 100%;
    }
    /* import: D1Inv.dc.html:1/0/0/0/6 */
    #figs-parlour {
      height: 720px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 1280px;
    }
    /* import: D1Inv.dc.html:1/0/0/0/6/0 */
    #fig-cedric {
      height: 420px;
      left: -10px;
      top: 300px;
      width: 280px;
    }
    /* import: D1Inv.dc.html:1/0/0/0/6/1 */
    #fig-hyde {
      height: 420px;
      left: 255px;
      top: 300px;
      width: 280px;
    }
    /* import: D1Inv.dc.html:1/0/0/0/6/2 */
    #fig-irene {
      height: 420px;
      left: 700px;
      top: 300px;
      width: 280px;
    }
    /* import: D1Inv.dc.html:1/0/0/0/7 */
    #figs-study {
      height: 720px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 1280px;
    }
    /* import: D1Inv.dc.html:1/0/0/0/7/0 */
    #fig-irene-door {
      height: 390px;
      left: -60px;
      top: 260px;
      width: 260px;
    }
    /* import: D1Inv.dc.html:1/0/0/0/8 */
    #figs-hall {
      height: 720px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 1280px;
    }
    /* import: D1Inv.dc.html:1/0/0/0/8/0 */
    #fig-briggs {
      height: 430px;
      left: 740px;
      top: 290px;
      width: 287px;
    }
    /* import: D1Inv.dc.html:1/0/1 */
    #shade-top {
      height: 120px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 1280px;
    }
    /* import: D1Inv.dc.html:1/0/2 */
    #spots-layer {
      height: 720px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 1280px;
    }
    /* import: D1Inv.dc.html:1/0/2/0 */
    #spots-list {
      height: 720px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 1280px;
    }
    /* import: D1Inv.dc.html:1/0/2/0/0 */
    #spot {
      align-items: center;
      display: flex;
      flex-direction: column;
      gap: 4px;
      height: 62px;
      justify-content: center;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 124px;
    }
    /* import: D1Inv.dc.html:1/0/2/0/0/0 */
    #spot-ring {
      bottom: -6px;
      left: -6px;
      position: absolute;
      right: -6px;
      top: -6px;
    }
    /* import: D1Inv.dc.html:1/0/2/0/0/1 */
    #spot-chip {
      position: relative;
    }
    /* import: D1Inv.dc.html:1/1 */
    #hud {
      anchor: left top;
      offset: -16px -8px;
      padding-bottom: 4px;
      padding-left: 12px;
      padding-right: 12px;
      padding-top: 4px;
      size: 200px 56px;
    }
    /* import: D1Inv.dc.html:1/1/0 */
    #hud-title {
      height: 20px;
      left: 12px;
      position: absolute;
      top: 4px;
      width: 176px;
    }
    /* import: D1Inv.dc.html:1/1/1 */
    #hud-appr {
      height: 24px;
      left: 12px;
      position: absolute;
      top: 25px;
      width: 176px;
    }
    /* import: D1Inv.dc.html:1/2 */
    #locs {
      anchor: right top;
      display: flex;
      flex-direction: row;
      gap: 6px;
      offset: -16px -8px;
      size: 1032px 56px;
    }
    /* import: D1Inv.dc.html:1/2/0 */
    #loc {
      flex-shrink: 0;
      height: 56px;
      position: relative;
      width: 167px;
    }
    /* import: D1Inv.dc.html:1/2/0/0 */
    #loc-t {
      height: 36px;
      left: 6px;
      position: absolute;
      top: 8px;
      width: 155px;
    }
    /* import: D1Inv.dc.html:1/2/0/1 */
    #loc-done {
      height: 10px;
      left: 151px;
      position: absolute;
      top: 4px;
      width: 10px;
    }
    /* import: D1Inv.dc.html:1/3 */
    #actions {
      anchor: right bottom;
      offset: -16px -2px;
      size: 560px 52px;
    }
    /* import: D1Inv.dc.html:1/3/0 */
    #btn-book {
      left: 0px;
      position: absolute;
      top: 4px;
      width: 176px;
    }
    /* import: D1Inv.dc.html:1/3/1 */
    #book-dot {
      height: 24px;
      left: 160px;
      position: absolute;
      top: -6px;
      width: 24px;
    }
    /* import: D1Inv.dc.html:1/3/2 */
    #btn-notes {
      left: 192px;
      position: absolute;
      top: 4px;
      width: 176px;
    }
    /* import: D1Inv.dc.html:1/3/3 */
    #btn-end {
      left: 384px;
      position: absolute;
      top: 4px;
      width: 176px;
    }
    /* import: D1Inv.dc.html:1/4 */
    #pop {
      anchor: stretch stretch screen;
    }
    /* import: D1Inv.dc.html:1/4/0 */
    #pop-shade {
      height: 720px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 1280px;
    }
    /* import: D1Inv.dc.html:1/4/1 */
    #pop-card {
      display: flex;
      flex-direction: column;
      gap: 8px;
      left: 330px;
      padding-bottom: 18px;
      padding-left: 28px;
      padding-right: 28px;
      padding-top: 18px;
      position: absolute;
      top: 150px;
      width: 620px;
    }
    /* import: D1Inv.dc.html:1/4/1/0 */
    #pop-kicker {
      flex-shrink: 0;
      height: 20px;
      width: 564px;
    }
    /* import: D1Inv.dc.html:1/4/1/1 */
    #pop-title {
      flex-shrink: 0;
      width: 564px;
    }
    /* import: D1Inv.dc.html:1/4/1/2 */
    #pop-rule {
      flex-shrink: 0;
      height: 1px;
      width: 564px;
    }
    /* import: D1Inv.dc.html:1/4/1/3 */
    #pop-body {
      flex-shrink: 0;
      width: 564px;
    }
    /* import: D1Inv.dc.html:1/4/1/4 */
    #pop-line {
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      gap: 2px;
      padding-bottom: 8px;
      padding-left: 12px;
      padding-right: 12px;
      padding-top: 8px;
      width: 564px;
    }
    /* import: D1Inv.dc.html:1/4/1/4/0 */
    #pop-spk {
      flex-shrink: 0;
      width: 540px;
    }
    /* import: D1Inv.dc.html:1/4/1/4/1 */
    #pop-line-text {
      flex-shrink: 0;
      width: 540px;
    }
    /* import: D1Inv.dc.html:1/4/1/5 */
    #pop-got {
      flex-shrink: 0;
      width: 564px;
    }
    /* import: D1Inv.dc.html:1/4/1/6 */
    #pop-note {
      flex-shrink: 0;
      width: 564px;
    }
    /* import: D1Inv.dc.html:1/4/1/7 */
    #pop-close {
      flex-shrink: 0;
      height: 22px;
      width: 564px;
    }
    .bg-art {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    .fig {
      position: absolute;
    }
    .chip {
      width: 40px;
      height: 40px;
      flex-shrink: 0;
    }
    .spot-name {
      width: 240px;
      height: 26px;
      flex-shrink: 0;
      overflow: hidden;
    }
    .spot.done .ico-done {
      display: block;
    }
    .ico {
      position: absolute;
      left: 7px;
      top: 7px;
      width: 22px;
      height: 22px;
    }
    .ico-done {
      display: none;
      position: absolute;
      left: 20px;
      top: 20px;
      width: 20px;
      height: 20px;
    }
    .loc-done {
      display: none;
    }
    .loc.done .loc-done {
      display: block;
    }
    .btn {
      height: 44px;
      flex-shrink: 0;
    }
  </layout>
  <style src="../shared/base.xts"/>
  <style src="d1inv.xts"/>
  <timelines>
    @timeline bg-in {
      #bg-art {
        0ms {
          opacity: 0.35;
        }
        360ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline pop-in {
      #pop-card {
        0ms {
          opacity: 0;
          transform: translate(0px, 16px);
        }
        220ms ease-out {
          opacity: 1;
          transform: translate(0px, 0px);
        }
      }
    }
  </timelines>
</xt>
