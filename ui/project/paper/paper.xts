  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 34px;
  line-height: 44px;
  font-weight: 700;
  letter-spacing: 6px;
  text-align: center;
  text-transform: uppercase;
  color: var(--paper);
}

.f-body {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

.f-disp {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

.pic-frame {
  background-color: var(--paper);
  border: 1px #123a31;
  effect: shadow(3px 3px 0px 0px #092e2833);
}

.pic-art {
  object-fit: cover;
}

.deck {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 18px;
  line-height: 24px;
