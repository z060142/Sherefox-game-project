.rule-thin {
  background-color: var(--ink);
}

.rule-thick {
  background-color: var(--ink);
}

.rule-copper {
  background-color: var(--copper);
}

.rule-col {
  background-color: var(--ink);
  opacity: 0.55;
}

.rule-thick.wolf {
  background-color: #3b2a4a;
}

.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
}

.col-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 22px;
  color: var(--ink);
}

.ear {
  border-top-width: 1px;
  border-top-color: #123a31;
  border-bottom-width: 1px;
  border-bottom-color: #123a31;
  background-color: var(--paper);
}

.ear.extra {
  background-color: var(--copper);
  border-color: var(--ink-deep);
}

.ear-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 22px;
  line-height: 30px;
  letter-spacing: 4px;
  text-align: center;
  color: var(--ink);
}

