  <style src="../shared/base.xts"/>
  <style src="paper.xts"/>
  <timelines>
    @timeline flip {
      #p1 {
        0ms {
          opacity: 0;
          transform: translateX(18px);
        }
        280ms ease-out {
          opacity: 1;
          transform: translateX(0px);
        }
      }
      #p2 {
        0ms {
          opacity: 0;
          transform: translateX(18px);
        }
        280ms ease-out {
          opacity: 1;
          transform: translateX(0px);
        }
      }
    }
    @timeline idle {
      #turn-mark {
        0ms {
          opacity: 1;
        }
        600ms ease-in-out {
          opacity: 0.25;
        }
        1200ms ease-in-out {
          opacity: 1;
        }
      }
    }
    @timeline intro {
      #mast {
        0ms {
          opacity: 0;
        }
        300ms ease-out {
          opacity: 1;
        }
      }
      #headline {
        0ms {
          opacity: 0;
          transform: translateY(-10px);
        }
        120ms {
          opacity: 0;
          transform: translateY(-10px);
        }
        420ms ease-out {
          opacity: 1;
          transform: translateY(0px);
        }
      }
      #lead-pic {
        0ms {
          opacity: 0;
        }
        200ms {
          opacity: 0;
        }
        560ms ease-out {
          opacity: 1;
        }
      }
      #cols {
        0ms {
          opacity: 0;
        }
        250ms {
          opacity: 0;
        }
        600ms ease-out {
          opacity: 1;
        }
      }
      #prev-case {
        0ms {
          opacity: 0;
        }
        350ms {
          opacity: 0;
        }
        700ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline stamp-in {
      #stamp {
        0ms {
          opacity: 0;
          transform: rotate(-9deg) scale(1.35);
        }
        180ms ease-in {
          opacity: 1;
          transform: rotate(-9deg) scale(1);
        }
      }
    }
  </timelines>
</xt>
