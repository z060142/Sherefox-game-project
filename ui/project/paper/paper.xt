<xt version="2">
  <head>
    <title>Paper</title>
  </head>

  <ports>
    page: number in = 1
    mast: number in = 0
    dateline: string in = "1887 年 10 月・陰雨　每份一便士"
    headline: string in = "百年古董懷錶遭掉包！富商怒告貝克街老鐘錶匠"
    subhead: string in = "格雷沙姆先生：「我的錶進店時完好如初。」"
    body: string in = "本報訊，富商格雷沙姆先生昨日委託貝克街報時鳥鐘錶店清潔一只百年古董懷錶，晚間開啟錶背時，赫然發現機芯已遭替換。格雷沙姆先生表示：「我的錶進店時完好如初，店主是唯一碰過它的人。」店主霍洛威老先生經營鐘錶店逾四十年，鄰里評價甚佳，對此指控堅決否認。據悉，富商已委託律師，最快本週提告。"
    page2_head: string in = ""
    page2_body: string in = ""
    side: string in = "鐘錶業公會午宴，一位年輕的市政顧問出席並捐贈學徒獎學金。"
    ad: string in = "招租：貝克街事務所二樓空房，限能忍受惡作劇者。"
    stamp: number in = 0
    picture: string in = "ch02"
    result_head: string in = "市議會擬加徵煤煙稅　工廠主人聯名抗議"
    result_sub: string in = ""
    next: event out
    prev: event out
  </ports>

  <body on:show="play(intro)" key-activation="none">
    <div id="paper" tabindex="0" autofocus="" on:click(left)="emit(next)" on:key(Enter)="emit(next)" on:key(Space)="emit(next)" on:key(Right)="emit(next)" on:key(PageDown)="emit(next)" on:key(Left)="emit(prev)" on:key(PageUp)="emit(prev)" on:port(page)="play(flip)">
      <div id="sheet">
        <div id="p1" bind:display="page | eq(1)" bind:class.tall="result_head | eq('')">
          <div id="ear-l" class="ear" bind:class.extra="mast | eq(1)">
            <div id="ear-l-name" class="ear-text" bind:display="mast | ne(1)">@UI_PAPER_MAST</div>
            <div id="ear-l-extra" class="ear-extra" bind:display="mast | eq(1)">@UI_PAPER_EXTRA</div>
          </div>
          <div id="ear-r" class="ear" bind:class.extra="mast | eq(1)">
            <div id="ear-r-page" class="ear-text" bind:display="mast | ne(1)">@UI_PAPER_PAGE1</div>
            <div id="ear-r-extra" class="ear-extra" bind:display="mast | eq(1)">@UI_PAPER_EXTRA</div>
          </div>
          <div id="mast-dock">
            <div id="mast">
              <img id="mast-art" class="s-b00406" src="../shared/img/masthead-art.png"/>
            </div>
          </div>
          <div id="p1-rule-a" class="rule-thick" bind:class.wolf="mast | eq(2)"/>
          <div id="p1-rule-b" class="rule-thin"/>
          <div id="dateline" class="f-body" bind:text="dateline">1887 年 10 月・陰雨　每份一便士</div>
          <div id="p1-rule-c" class="rule-thin"/>
          <div id="headline-box">
            <h1 id="headline" class="f-disp" on:port(headline)="play(intro)" bind:text="headline">百年古董懷錶遭掉包！富商怒告貝克街老鐘錶匠</h1>
          </div>
          <div id="p1-rule-d" class="rule-thin"/>
          <div id="lead-pic" bind:display="picture | ne('')">
            <div id="pic-frame" class="pic-frame">
              <img id="pic-ch01" class="pic-art" src="../shared/img/pic-ch01.jpg" bind:display="picture | eq('ch01')"/>
              <img id="pic-ch02" class="pic-art" src="../shared/img/pic-ch02.jpg" bind:display="picture | eq('ch02')"/>
              <img id="pic-ch03" class="pic-art" src="../shared/img/pic-ch03.jpg" bind:display="picture | eq('ch03')"/>
              <img id="pic-ch04" class="pic-art" src="../shared/img/pic-ch04.jpg" bind:display="picture | eq('ch04')"/>
            </div>
            <div id="pic-rule" class="rule-col"/>
            <div id="pic-deck-box">
              <p id="pic-deck" class="deck" bind:text="subhead">格雷沙姆先生：「我的錶進店時完好如初。」</p>
            </div>
            <div id="lead-rule" class="rule-thin"/>
            <div id="lead-col-1" class="col">
              <div id="lead-col-1-text" class="col-text" bind:text="body">本報訊，富商格雷沙姆先生昨日委託貝克街報時鳥鐘錶店清潔一只百年古董懷錶，晚間開啟錶背時，赫然發現機芯已遭替換。格雷沙姆先生表示：「我的錶進店時完好如初，店主是唯一碰過它的人。」店主霍洛威老先生經營鐘錶店逾四十年，鄰里評價甚佳，對此指控堅決否認。據悉，富商已委託律師，最快本週提告。</div>
            </div>
            <div id="lead-col-rule" class="rule-col"/>
            <div id="lead-col-2" class="col">
              <div id="lead-col-2-text" class="col-text" bind:text="body">本報訊</div>
            </div>
          </div>
          <div id="lead-text" bind:display="picture | eq('')">
            <p id="subhead" class="f-body" bind:text="subhead">格雷沙姆先生：「我的錶進店時完好如初。」</p>
            <div id="p1-rule-e" class="rule-thin"/>
            <div id="cols">
              <div id="col-1" class="col">
                <div id="col-1-text" class="col-text" bind:text="body">本報訊，富商格雷沙姆先生昨日委託貝克街報時鳥鐘錶店清潔一只百年古董懷錶，晚間開啟錶背時，赫然發現機芯已遭替換。</div>
              </div>
              <div id="col-rule-1" class="rule-col"/>
              <div id="col-2" class="col">
                <div id="col-2-text" class="col-text" bind:text="body">本報訊</div>
              </div>
              <div id="col-rule-2" class="rule-col"/>
              <div id="col-3" class="col">
                <div id="col-3-text" class="col-text" bind:text="body">本報訊</div>
              </div>
              <div id="col-rule-3" class="rule-col"/>
              <div id="col-4" class="col">
                <div id="col-4-text" class="col-text" bind:text="body">本報訊</div>
              </div>
              <div id="col-rule-4" class="rule-col"/>
              <div id="col-5" class="col">
                <div id="col-5-text" class="col-text" bind:text="body">本報訊</div>
              </div>
            </div>
          </div>
          <div id="prev-case" class="prev" bind:display="result_head | ne('')">
            <div id="prev-label" class="prev-label">@UI_PAPER_PREV_CASE</div>
            <div id="prev-text">
              <div id="prev-head" class="prev-head" bind:text="result_head">市議會擬加徵煤煙稅　工廠主人聯名抗議</div>
              <div id="prev-sub" class="prev-sub" bind:text="result_sub" bind:display="result_sub | ne('')">「店主拒絕受訪，櫥窗報時鳥停擺。」</div>
            </div>
          </div>
        </div>
        <div id="p2" bind:display="page | eq(2)" bind:class.wide="page2_head | eq('')">
          <div id="p2-label" class="kicker">@UI_PAPER_PAGE2</div>
          <div id="p2-mast" class="f-disp">@UI_PAPER_MAST</div>
          <div id="p2-date" class="f-body" bind:text="dateline">1887 年 10 月・陰雨　每份一便士</div>
          <div id="p2-rule-a" class="rule-thick" bind:class.wolf="mast | eq(2)"/>
          <div id="p2-rule-b" class="rule-thin"/>
          <div id="p2-article" bind:display="page2_head | ne('')">
            <h2 id="p2-headline" class="f-disp" bind:text="page2_head">古董收藏家控訴報時鳥鐘錶店掉包機芯，店家喊冤</h2>
            <div id="p2-rule-c" class="rule-thin"/>
            <div id="p2-cols">
              <div id="p2-col-1" class="col">
                <div id="p2-col-1-text" class="col-text" bind:text="page2_body">狐耳偵探事務所誠徵室友啟事，即日起撤除。另據月桂糕點鋪表示，今日第一位客人是一位頭髮亂翹的年輕紳士，身旁跟著一位耳朵豎得很高的少女。</div>
              </div>
              <div id="p2-col-rule-1" class="rule-col"/>
              <div id="p2-col-2" class="col">
                <div id="p2-col-2-text" class="col-text" bind:text="page2_body">狐耳偵探事務所</div>
              </div>
              <div id="p2-col-rule-2" class="rule-col"/>
              <div id="p2-col-3" class="col">
                <div id="p2-col-3-text" class="col-text" bind:text="page2_body">狐耳偵探事務所</div>
              </div>
            </div>
            <div id="p2-rule-side" class="rule-thin"/>
          </div>
          <div id="p2-briefs">
            <div id="brief-side">
              <div id="side-head" class="kicker s-7ee933">@UI_PAPER_SIDE</div>
              <div id="side-text" class="side-text" bind:text="side">鐘錶業公會午宴，一位年輕的市政顧問出席並捐贈學徒獎學金。</div>
              <div id="side-text-rule" class="rule-col"/>
            </div>
            <div id="brief-orn" class="brief-orn">
              <div id="brief-orn-rule" class="rule-thin"/>
            </div>
            <div id="brief-ads">
              <div id="ads-head" class="kicker s-7ee933">@UI_PAPER_ADS</div>
              <div id="ad-box" class="ad-box">
                <div id="ad-frame" class="ad-frame">
                  <div id="ad-text" class="ad-text" bind:text="ad">招租：貝克街事務所二樓空房，限能忍受惡作劇者。</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div id="foot-rule" class="rule-copper"/>
        <div id="folio" class="f-body" bind:text="page">1</div>
        <svg id="turn-mark" viewBox="0 0 10 14">
          <polygon id="Tri" points="0,0 10,7 0,14" fill="#a65432"/>
        </svg>
        <div id="stamp" class="s-6ed937" on:port(stamp)="play(stamp-in)" bind:display="stamp | gt(0)">
          <div id="stamp-inner" class="s-eb9710">
            <div id="stamp-closed" class="f-disp" bind:display="stamp | eq(1)">@UI_PAPER_STAMP_CLOSED</div>
            <div id="stamp-fix" class="f-disp" bind:display="stamp | eq(2)">@UI_PAPER_STAMP_FIX</div>
          </div>
        </div>
      </div>
    </div>
  </body>

