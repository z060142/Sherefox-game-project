<xt version="2">
  <head>
    <title>Paper</title>
  </head>

  <ports>
    page: number in = 1
    mast: number in = 0
    dateline: string in = "1887 年 10 月 14 日・濃霧　每份一便士"
    headline: string in = "月桂糕點鋪限量「發條焦糖布丁」開賣首日，排隊人龍繞過貝克街兩圈"
    subhead: string in = "本報小廣告欄：「狐耳偵探事務所誠徵室友，會做飯者優先。」"
    body: string in = "本報訊，貝克街月桂糕點鋪昨日推出新品「發條焦糖布丁」，以黃銅發條造型的焦糖頂飾聞名，每日限量四十顆，開店一小時即售罄。排隊人群中不乏專程前來的紳士淑女，其中一位狐耳少女據稱「尾巴從頭到尾都沒有停過」。另，本報小廣告欄刊有啟事一則：「狐耳偵探事務所誠徵室友，會做飯者優先，不接受怕狐狸毛的人。」"
    page2_head: string in = "古董收藏家控訴報時鳥鐘錶店掉包機芯，店家喊冤"
    page2_body: string in = "狐耳偵探事務所誠徵室友啟事，即日起撤除。另據月桂糕點鋪表示，今日第一位客人是一位頭髮亂翹的年輕紳士，身旁跟著一位耳朵豎得很高的少女。"
    side: string in = "鐘錶業公會午宴，一位年輕的市政顧問出席並捐贈學徒獎學金。"
    ad: string in = "招租：貝克街事務所二樓空房，限能忍受惡作劇者。"
    stamp: number in = 0
    next: event out
    prev: event out
  </ports>

  <body on:show="play(intro)" key-activation="none">
    <div id="paper" tabindex="0" autofocus="" on:click(left)="emit(next)" on:key(Enter)="emit(next)" on:key(Space)="emit(next)" on:key(Right)="emit(next)" on:key(PageDown)="emit(next)" on:key(Left)="emit(prev)" on:key(PageUp)="emit(prev)" on:port(page)="play(flip)">
      <div id="sheet">
        <div id="p1" bind:display="page | eq(1)">
          <div id="ear-l" class="ear" bind:class.extra="mast | eq(1)">
            <div id="ear-l-name" class="ear-text" bind:display="mast | ne(1)">@UI_PAPER_MAST</div>
            <div id="ear-l-extra" class="ear-extra" bind:display="mast | eq(1)">@UI_PAPER_EXTRA</div>
          </div>
          <div id="ear-r" class="ear" bind:class.extra="mast | eq(1)">
            <div id="ear-r-page" class="ear-text" bind:display="mast | ne(1)">@UI_PAPER_PAGE1</div>
            <div id="ear-r-extra" class="ear-extra" bind:display="mast | eq(1)">@UI_PAPER_EXTRA</div>
          </div>
          <div id="mast-dock">
            <div id="mast">
              <img id="mast-art" class="s-b00406" src="../shared/img/masthead-art.png"/>
            </div>
          </div>
          <div id="p1-rule-a" class="rule-thick" bind:class.wolf="mast | eq(2)"/>
          <div id="p1-rule-b" class="rule-thin"/>
          <div id="dateline" bind:text="dateline">1887 年 10 月 14 日・濃霧　每份一便士</div>
          <div id="p1-rule-c" class="rule-thin"/>
          <h1 id="headline" on:port(headline)="play(intro)" bind:text="headline">月桂糕點鋪限量「發條焦糖布丁」開賣首日，排隊人龍繞過貝克街兩圈</h1>
          <p id="subhead" bind:text="subhead">本報小廣告欄：「狐耳偵探事務所誠徵室友，會做飯者優先。」</p>
          <div id="p1-rule-d" class="rule-thin"/>
          <div id="cols">
            <div id="col-1" class="col">
              <div id="col-1-text" class="col-text" bind:text="body">本報訊，貝克街月桂糕點鋪昨日推出新品「發條焦糖布丁」，以黃銅發條造型的焦糖頂飾聞名，每日限量四十顆，開店一小時即售罄。排隊人群中不乏專程前來的紳士淑女，其中一位狐耳少女據稱「尾巴從頭到尾都沒有停過」。另，本報小廣告欄刊有啟事一則：「狐耳偵探事務所誠徵室友，會做飯者優先，不接受怕狐狸毛的人。」</div>
            </div>
            <div id="col-rule-1" class="rule-col"/>
            <div id="col-2" class="col">
              <div id="col-2-text" class="col-text" bind:text="body">本報訊</div>
            </div>
            <div id="col-rule-2" class="rule-col"/>
            <div id="col-3" class="col">
              <div id="col-3-text" class="col-text" bind:text="body">本報訊</div>
            </div>
            <div id="col-rule-3" class="rule-col"/>
            <div id="col-4" class="col">
              <div id="col-4-text" class="col-text" bind:text="body">本報訊</div>
            </div>
            <div id="col-rule-4" class="rule-col"/>
            <div id="col-5" class="col">
              <div id="col-5-text" class="col-text" bind:text="body">本報訊</div>
            </div>
          </div>
        </div>
        <div id="p2" bind:display="page | eq(2)">
          <div id="p2-label" class="kicker">@UI_PAPER_PAGE2</div>
          <div id="p2-mast">@UI_PAPER_MAST</div>
          <div id="p2-date" bind:text="dateline">1887 年 10 月 14 日・濃霧　每份一便士</div>
          <div id="p2-rule-a" class="rule-thick" bind:class.wolf="mast | eq(2)"/>
          <div id="p2-rule-b" class="rule-thin"/>
          <h2 id="p2-headline" bind:text="page2_head">古董收藏家控訴報時鳥鐘錶店掉包機芯，店家喊冤</h2>
          <div id="p2-rule-c" class="rule-thin"/>
          <div id="p2-cols">
            <div id="p2-col-1" class="col">
              <div id="p2-col-1-text" class="col-text" bind:text="page2_body">狐耳偵探事務所誠徵室友啟事，即日起撤除。另據月桂糕點鋪表示，今日第一位客人是一位頭髮亂翹的年輕紳士，身旁跟著一位耳朵豎得很高的少女。</div>
            </div>
            <div id="p2-col-rule-1" class="rule-col"/>
            <div id="p2-col-2" class="col">
              <div id="p2-col-2-text" class="col-text" bind:text="page2_body">狐耳偵探事務所</div>
            </div>
            <div id="p2-col-rule-2" class="rule-col"/>
            <div id="p2-col-3" class="col">
              <div id="p2-col-3-text" class="col-text" bind:text="page2_body">狐耳偵探事務所</div>
            </div>
          </div>
          <div id="p2-rule-side" class="rule-thin"/>
          <div id="side-head" class="kicker s-7ee933">@UI_PAPER_SIDE</div>
          <div id="side-text" class="col-text" bind:text="side">鐘錶業公會午宴，一位年輕的市政顧問出席並捐贈學徒獎學金。</div>
          <div id="ads-head" class="kicker s-7ee933">@UI_PAPER_ADS</div>
          <div id="ad-box" class="s-e68292">
            <div id="ad-frame" class="s-e68292">
              <div id="ad-text" bind:text="ad">招租：貝克街事務所二樓空房，限能忍受惡作劇者。</div>
            </div>
          </div>
        </div>
        <div id="foot-rule" class="rule-copper"/>
        <div id="folio" bind:text="page">1</div>
        <svg id="turn-mark" viewBox="0 0 10 14">
          <polygon id="Tri" points="0,0 10,7 0,14" fill="#a65432"/>
        </svg>
        <div id="stamp" on:port(stamp)="play(stamp-in)" bind:display="stamp | gt(0)">
          <div id="stamp-inner">
            <div id="stamp-closed" bind:display="stamp | eq(1)">@UI_PAPER_STAMP_CLOSED</div>
            <div id="stamp-fix" bind:display="stamp | eq(2)">@UI_PAPER_STAMP_FIX</div>
          </div>
        </div>
      </div>
    </div>
  </body>

