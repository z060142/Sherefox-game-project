      top: 32px;
      width: 100px;
    }
    /* import: Evbook.dc.html:1/1/0/5/0/0/0/5 */
    #card-rule {
      height: 3px;
      left: 8px;
      position: absolute;
      top: 118px;
      width: 100px;
    }
    /* import: Evbook.dc.html:1/1/0/5/0/0/0/6 */
    #card-new {
      height: 14px;
