      padding-top: 8px;
      position: absolute;
      top: 448px;
      width: 462px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/4/0 */
    #appr-box {
      flex-shrink: 0;
      height: 26px;
      width: 44px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/4/1 */
    #appr-label {
      flex-shrink: 0;
      height: 20px;
      min-width: 40px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/4/2 */
    #appr-count {
      flex-shrink: 0;
      height: 28px;
      width: 60px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/4/3 */
    #appr-gap {
      flex-grow: 1;
      height: 4px;
      min-width: 4px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/4/4 */
    #btn-appraise {
      width: 180px;
    }
    .tab {
      width: 150px;
      height: 34px;
      flex-shrink: 0;
    }
    .btn {
      height: 40px;
      flex-shrink: 0;
    }
    .note-mark {
      transform: rotate(45deg);
    }
    .glbl {
      display: none;
    }
    .panel.g0 .gl-0 {
      display: block;
    }
    .panel.g1 .gl-1 {
      display: block;
    }
    .panel.g2 .gl-2 {
      display: block;
    }
    .panel.g3 .gl-3 {
      display: block;
    }
    .panel.g4 .gl-4 {
      display: block;
    }
  </layout>
  <style src="../shared/base.xts"/>
  <style src="evbook.xts"/>
  <timelines>
    @timeline open {
      #scrim {
        0ms {
          opacity: 0;
        }
        200ms ease-out {
          opacity: 1;
        }
      }
      #book {
        0ms {
          opacity: 0;
          transform: translateY(16px);
        }
        240ms ease-out {
          opacity: 1;
          transform: translateY(0px);
        }
      }
    }
  </timelines>
</xt>
