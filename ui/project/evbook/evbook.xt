    }
    /* import: Evbook.dc.html:1/1/0/5/2 */
    #notes {
      height: 190px;
      left: 10px;
      position: absolute;
      top: 344px;
      width: 510px;
    }
    /* import: Evbook.dc.html:1/1/0/5/2/0 */
    #notes-head {
      height: 20px;
      left: 14px;
      position: absolute;
      top: 8px;
      width: 300px;
    }
    /* import: Evbook.dc.html:1/1/0/5/2/1 */
    #notes-scroll {
      height: 148px;
      left: 14px;
      overflow-y: auto;
      position: absolute;
      top: 34px;
      width: 486px;
    }
    /* import: Evbook.dc.html:1/1/0/5/2/1/0 */
    #notes-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: 482px;
    }
    /* import: Evbook.dc.html:1/1/0/5/2/1/0/0 */
    #note {
      flex-shrink: 0;
      padding-bottom: 0px;
      padding-left: 20px;
      padding-right: 0px;
      padding-top: 0px;
      position: relative;
      width: 482px;
    }
    /* import: Evbook.dc.html:1/1/0/5/2/1/0/0/0 */
    #note-mark {
      height: 7px;
      left: 3px;
      position: absolute;
      top: 8px;
      width: 7px;
    }
    /* import: Evbook.dc.html:1/1/0/5/2/1/0/0/1 */
    #note-text {
      width: 462px;
    }
    /* import: Evbook.dc.html:1/1/0/6 */
    #spine {
      height: 556px;
