      position: absolute;
      top: 0px;
      width: 498px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/1 */
    #detail-grade {
      height: 20px;
      left: 18px;
      position: absolute;
      top: 16px;
      width: 300px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/1/0 */
    #gl-0 {
      height: 20px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 300px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/1/1 */
    #gl-1 {
      height: 20px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 300px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/1/2 */
    #gl-2 {
      height: 20px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 300px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/1/3 */
    #gl-3 {
      height: 20px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 300px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/1/4 */
    #gl-4 {
      height: 20px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 300px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/2 */
    #detail-id {
      height: 16px;
      left: 380px;
      position: absolute;
      top: 18px;
      width: 100px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/3 */
    #detail-body {
      display: flex;
      flex-direction: column;
      gap: 10px;
      height: 380px;
      left: 18px;
      position: absolute;
      top: 44px;
      width: 462px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/3/0 */
    #sel-name {
      flex-shrink: 0;
      width: 462px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/3/1 */
    #sel-tags {
      flex-shrink: 0;
      width: 462px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/3/2 */
    #sel-rule {
      flex-shrink: 0;
      height: 3px;
      width: 462px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/3/3 */
    #sel-desc {
      flex-shrink: 0;
      width: 462px;
    }
    /* import: Evbook.dc.html:1/1/0/7/0/4 */
    #appr-row {
      align-items: center;
      display: flex;
      flex-direction: row;
