/* Generated by xtframe-import from "Evbook". Edits are kept on re-import; see import-report.json. */

/* import: Evbook.dc.html:1 */
#evbook {
  background-color: #092e28;
  color: #123a31;
}

/* import: Evbook.dc.html:1/1/0/0 */
#book-title {
  color: #092e28;
  font-size: 26px;
  font-weight: 700;
  letter-spacing: 3px;
  line-height: 40px;
  white-space: nowrap;
}

/* import: Evbook.dc.html:1/1/0/7/0/3/0 */
#sel-name {
  color: #092e28;
  font-size: 26px;
  font-weight: 700;
  line-clamp: 2;
  line-height: 34px;
}

/* import: Evbook.dc.html:1/1/0/7/0/3/1 */
#sel-tags {
  color: #a65432;
  font-size: 14px;
  line-clamp: 2;
  line-height: 22px;
}

/* import: Evbook.dc.html:1/1/0/7/0/3/3 */
#sel-desc {
  color: #123a31;
  font-size: 16px;
  line-clamp: 9;
  line-height: 26px;
}

/* import: Evbook.dc.html:1/1/0/7/0/4 */
#appr-row {
  border-top-color: #123a3180;
  border-top-style: dashed;
  border-top-width: 1px;
}

.f-body {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

.f-disp {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
}

.rule-thin {
  background-color: var(--ink);
}

.rule-thick {
  background-color: var(--ink);
}

.scrim {
  background-color: #092e28b8;
}

.book {
  background-color: var(--paper-old);
  border: 2px #092e28;
  effect: shadow(8px 8px 0px 0px #00000059);
}

.page-l {
  background-color: var(--paper);
}

.page-r {
  background-color: var(--paper);
}

.spine {
  background-gradient: linear-gradient(90deg, #092e2800 0%, #092e2833 45%, #092e2866 50%, #092e2833 55%, #092e2800 100%);
}

.tab {
  text-align: center;
  line-height: 32px;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  letter-spacing: 2px;
  color: var(--ink);
  background-color: var(--paper-old);
  border: 1px #123a31;
  transition: background-color 120ms linear;
}

:lang(en) .tab {
  font-size: 13px;
  letter-spacing: 0px;
}

:lang(en) #book-title {
  font-size: 22px;
  letter-spacing: 1px;
}

.tab:hover {
  background-color: var(--paper);
}

.tab.on {
  color: var(--paper);
  background-color: var(--ink);
  border-color: var(--ink-deep);
}

.btn {
  text-align: center;
  line-height: 38px;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  letter-spacing: 2px;
  color: var(--paper);
  background-color: var(--ink);
  border: 1px #092e28;
  effect: shadow(3px 3px 0px 0px #092e2866);
  transition: background-color 120ms linear;
}

.btn:hover {
  background-color: var(--copper);
}

.btn:active {
  background-color: var(--ink-deep);
}

.btn.off {
  color: #f3eedf8c;
  background-color: #5b6662;
  border-color: #5b6662;
}

.btn.off:hover {
  background-color: #5b6662;
}

.btn.alt {
  color: var(--ink);
  background-color: var(--paper);
  border-color: var(--ink);
}

.btn.alt:hover {
  color: var(--paper);
  background-color: var(--copper);
}

.gbar {
  background-color: var(--copper);
}

.g1 .gbar {
  background-color: #9ea7aa;
}

.g2 .gbar {
  background-color: var(--ink-deep);
}

.g3 .gbar {
  background-color: var(--lamp-gold);
}

.g4 .gbar {
  background-color: #a6543280;
}

.evc {
  background-color: var(--paper);
  border: 1px #123a3166;
  effect: shadow(2px 3px 0px 0px #092e2859);
  transition: background-color 120ms linear;
}

.evc:hover {
  background-color: #fbf8ef;
}

.evc.g1 {
  border-color: #9ea7aa;
}

.evc.g2 {
  background-color: var(--paper-old);
  border: 2px #092e28;
}

.evc.g3 {
  border-color: var(--lamp-gold);
  effect: shadow(0px 0px 12px 2px #e0a050b3);
}

.evc.g4 {
  background-color: var(--paper-old);
  border-style: dashed;
  border-color: var(--copper);
}

.evc.sel {
  outline: 3px solid #b8322a;
  outline-offset: 2px;
}

.tape {
  background-color: #e3d9c2cc;
  border: 1px #a6543226;
}

.evc-id {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 11px;
  line-height: 16px;
  letter-spacing: 1px;
  color: var(--copper);
}

.evc-name {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 19px;
  color: var(--ink);
  line-clamp: 4;
}

.qmark {
  border-radius: 9px;
  background-color: var(--vermilion);
  color: var(--paper);
  text-align: center;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 12px;
  line-height: 18px;
  font-weight: 700;
}

.newdot {
  border-radius: 6px;
  background-color: var(--vermilion);
  border: 2px #f3eedf;
}

.empty {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 24px;
  font-style: italic;
  color: #5b6662;
  text-align: center;
}

.notes-box {
  background-color: var(--paper-old);
  border-top-width: 3px;
  border-top-color: #a65432;
}

.note-mark {
  background-color: var(--copper);
}

.note-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 14px;
  line-height: 22px;
  color: var(--ink-deep);
}

.panel {
  background-color: var(--paper);
  border-top-width: 3px;
  border-top-color: #123a31;
  border-bottom-width: 1px;
  border-bottom-color: #123a31;
}

.appr-n {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 18px;
  line-height: 28px;
  font-weight: 700;
  color: var(--copper);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --lamp-gold: #e0a050;
  --paper: #f3eedf;
  --paper-old: #e3d9c2;
  --vermilion: #b8322a;
}

