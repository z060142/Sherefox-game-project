/* Generated by xtframe-import from "Settings". Edits are kept on re-import; see import-report.json. */

/* import: Settings.dc.html:1 */
#settings {
  background-color: #092e28;
  color: #123a31;
}

/* import: Settings.dc.html:1/1/0/0 */
#set-title {
  color: #092e28;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 4px;
  line-height: 40px;
  white-space: nowrap;
}

.f-body {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

.f-disp {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

.rule-thin {
  background-color: var(--ink);
}

.rule-thick {
  background-color: var(--ink);
}

.scrim {
  background-color: #092e28b8;
}

.book {
  background-color: var(--paper-old);
  border: 2px #092e28;
  effect: shadow(8px 8px 0px 0px #00000059);
}

.page {
  background-color: var(--paper);
  border-left-width: 3px;
  border-left-color: #a65432;
}

:lang(en) #set-title {
  font-size: 22px;
  letter-spacing: 1px;
}

.btn {
  text-align: center;
  line-height: 38px;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  letter-spacing: 2px;
  color: var(--ink);
  background-color: var(--paper);
  border: 1px #123a31;
  effect: shadow(3px 3px 0px 0px #092e2866);
  transition: background-color 120ms linear;
}

.btn:hover {
  color: var(--paper);
  background-color: var(--copper);
}

.row-label {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  line-height: 34px;
  font-weight: 700;
  letter-spacing: 2px;
  color: var(--ink-deep);
  white-space: nowrap;
}

:lang(en) .row-label {
  letter-spacing: 0px;
}

.row-rule {
  border-bottom-width: 1px;
  border-bottom-color: #123a3166;
  border-bottom-style: dashed;
}

.opt {
  text-align: center;
  line-height: 32px;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  letter-spacing: 1px;
  color: var(--ink);
  background-color: var(--paper-old);
  border: 1px #123a31;
  white-space: nowrap;
  transition: background-color 120ms linear;
}

:lang(en) .opt {
  font-size: 14px;
  letter-spacing: 0px;
}

.opt:hover {
  background-color: #fbf8ef;
}

.opt.on {
  color: var(--paper);
  background-color: var(--ink);
  border-color: var(--ink-deep);
}

.current {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 1px;
  color: var(--copper);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --paper: #f3eedf;
  --paper-old: #e3d9c2;
}

