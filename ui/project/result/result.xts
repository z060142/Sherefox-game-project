/* Generated by xtframe-import from "Result". Edits are kept on re-import; see import-report.json. */

/* import: Result.dc.html:1 */
#result {
  background-color: #e3d9c2;
  background-gradient: radial-gradient(70.7107% 84.8528% at 50% 40%, #e3d9c2 55%, #cbbd9c 100%);
  color: #123a31;
}

/* import: Result.dc.html:1/0/0/2 */
#res-mast {
  color: #092e28;
  font-size: 20px;
  letter-spacing: 5px;
  line-height: 30px;
  text-align: center;
}

/* import: Result.dc.html:1/0/0/10/0 */
#trust {
  border-bottom-color: #123a31;
  border-bottom-width: 1px;
}

/* import: Result.dc.html:1/0/0/10/2/0 */
#costs-head {
  color: #b8322a;
}

.f-body {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

.f-disp {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
}

.rule-thin {
  background-color: var(--ink);
}

.rule-thick {
  background-color: var(--ink);
}

.rule-col {
  background-color: var(--ink);
  opacity: 0.55;
}

.clip {
  background-color: var(--paper);
  border: 1px #123a3166;
  effect: shadow(6px 7px 0px 0px #092e2840);
}

.tape {
  background-color: #f3eedfb3;
  border: 1px #a6543233;
}

.verdict {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 112px;
  line-height: 140px;
  font-weight: 700;
  letter-spacing: 28px;
  text-align: center;
  text-transform: uppercase;
}

.v-win {
  color: var(--lamp-gold);
  text-effect: shadow 3px 3px 0px #092e28;
}

.v-lose {
  color: var(--copper);
  text-effect: shadow 3px 3px 0px #092e2833;
}

.v-none {
  color: #5b6662;
  text-effect: shadow 3px 3px 0px #092e2826;
}

:lang(en) .verdict {
  font-size: 84px;
  letter-spacing: 6px;
}

.opp-line {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 19px;
  line-height: 28px;
  font-style: italic;
  text-align: center;
  color: var(--ink-deep);
  line-clamp: 2;
}

.st-label {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 30px;
  color: var(--ink);
  white-space: nowrap;
}

.st-dots {
  border-top-width: 1px;
  border-top-color: #123a3180;
  border-top-style: dashed;
}

.st-value {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 19px;
  line-height: 30px;
  font-weight: 700;
  color: var(--ink-deep);
  text-align: right;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.badge {
  border: 2px #123a31;
  border-radius: 0px 0px 9px 9px;
  background-color: var(--paper);
}

.badge.on {
  background-color: var(--copper);
  border-color: var(--ink-deep);
}

.trust-num {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 22px;
  line-height: 30px;
  font-weight: 700;
  color: var(--ink-deep);
  text-align: right;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.note {
  background-color: var(--paper-old);
  border-top-width: 3px;
  border-top-color: #a65432;
  effect: shadow(3px 3px 0px 0px #092e2833);
}

.note-line {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 18px;
  line-height: 34px;
  font-style: italic;
  color: var(--ink-deep);
  background-image: url("../shared/img/ui-ruled.png");
  background-repeat: repeat;
  border-left-width: 2px;
  border-left-color: #a65432;
  line-clamp: 2;
}

.face {
  border-radius: 19px;
  border: 2px #a65432;
  background-color: var(--paper);
}

.costs {
  border-top-width: 3px;
  border-top-color: #b8322a;
  border-bottom-width: 1px;
  border-bottom-color: #b8322a;
}

.cost-mark {
  background-color: var(--vermilion);
}

.cost-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 24px;
  color: var(--ink-deep);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.stamp-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 46px;
  line-height: 60px;
  font-weight: 700;
  letter-spacing: 10px;
  text-align: center;
  text-transform: uppercase;
  color: var(--vermilion);
}

:lang(en) .stamp-text {
  font-size: 24px;
  letter-spacing: 2px;
}

.btn {
  text-align: center;
  line-height: 42px;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  letter-spacing: 2px;
  color: var(--paper);
  background-color: var(--ink);
  border: 1px #092e28;
  effect: shadow(3px 3px 0px 0px #092e2866);
  transition: background-color 120ms linear;
}

.btn:hover {
  background-color: var(--copper);
}

.btn:active {
  background-color: var(--ink-deep);
}

.btn.alt {
  color: var(--ink);
  background-color: var(--paper);
  border-color: var(--ink);
}

.btn.alt:hover {
  color: var(--paper);
  background-color: var(--copper);
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --lamp-gold: #e0a050;
  --paper: #f3eedf;
  --paper-old: #e3d9c2;
  --vermilion: #b8322a;
}

