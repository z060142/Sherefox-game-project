    }
    /* import: Result.dc.html:1/0/0/12 */
    #btns {
      display: flex;
      flex-direction: row;
      gap: 14px;
      height: 44px;
      justify-content: flex-end;
      left: 536px;
      position: absolute;
      top: 600px;
      width: 472px;
    }
    .badge {
      width: 18px;
      height: 22px;
      flex-shrink: 0;
    }
    .note-line {
      padding-left: 14px;
      transform: skewX(-6deg);
    }
    .face {
      overflow: hidden;
    }
    .cost-text {
      overflow: hidden;
    }
    .btn {
      width: 180px;
      height: 44px;
      flex-shrink: 0;
    }
  </layout>
  <style src="../shared/base.xts"/>
  <style src="result.xts"/>
  <timelines>
    @timeline trust-in {
      #trust-from {
        0ms {
          opacity: 1;
        }
        500ms {
          opacity: 1;
        }
        900ms ease-in-out {
          opacity: 0;
        }
      }
      #trust-to {
        0ms {
          opacity: 0;
          transform: scale(1);
        }
        500ms {
          opacity: 0;
          transform: scale(1.18);
        }
        900ms ease-in-out {
          opacity: 1;
        }
        1100ms ease-out {
          transform: scale(1);
        }
      }
    }
    @timeline verdict-in {
      #verdict {
        0ms {
          opacity: 0;
          transform: scale(1.35);
        }
        80ms {
          opacity: 0;
          transform: scale(1.35);
        }
        360ms ease-in {
          opacity: 1;
          transform: scale(1);
        }
        440ms ease-out {
          transform: scale(1.03);
        }
        520ms ease-out {
          transform: scale(1);
        }
      }
      #opp-line {
        0ms {
          opacity: 0;
        }
        420ms {
          opacity: 0;
        }
        760ms ease-out {
          opacity: 1;
        }
      }
      #res-stamp {
        0ms {
          opacity: 0;
          transform: rotate(-9deg) scale(1.35);
        }
        700ms {
          opacity: 0;
          transform: rotate(-9deg) scale(1.35);
        }
        880ms ease-in {
          opacity: 0.92;
          transform: rotate(-9deg) scale(1);
        }
      }
    }
  </timelines>
</xt>
