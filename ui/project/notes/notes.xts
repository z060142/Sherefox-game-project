/* Generated by xtframe-import from "Notes". Edits are kept on re-import; see import-report.json. */

/* import: Notes.dc.html:1 */
#notes {
  background-color: #092e28;
  color: #123a31;
}

/* import: Notes.dc.html:1/1/0/0 */
#notes-title {
  color: #092e28;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 2px;
  line-height: 40px;
  white-space: nowrap;
}

.f-body {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

.f-disp {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
}

.rule-thin {
  background-color: var(--ink);
}

.rule-thick {
  background-color: var(--ink);
}

.scrim {
  background-color: #092e28b8;
}

.book {
  background-color: var(--paper-old);
  border: 2px #092e28;
  effect: shadow(8px 8px 0px 0px #00000059);
}

.page {
  background-color: var(--paper);
  border-left-width: 3px;
  border-left-color: #a65432;
}

.tab {
  text-align: center;
  line-height: 32px;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  letter-spacing: 2px;
  color: var(--ink);
  background-color: var(--paper-old);
  border: 1px #123a31;
  transition: background-color 120ms linear;
}

:lang(en) .tab {
  font-size: 13px;
  letter-spacing: 0px;
}

:lang(en) #notes-title {
  font-size: 20px;
  letter-spacing: 1px;
}

.tab:hover {
  background-color: var(--paper);
}

.tab.on {
  color: var(--paper);
  background-color: var(--ink);
  border-color: var(--ink-deep);
}

.btn {
  text-align: center;
  line-height: 38px;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  letter-spacing: 2px;
  color: var(--ink);
  background-color: var(--paper);
  border: 1px #123a31;
  effect: shadow(3px 3px 0px 0px #092e2866);
  transition: background-color 120ms linear;
}

.btn:hover {
  color: var(--paper);
  background-color: var(--copper);
}

.opp-name {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 30px;
  line-height: 38px;
  font-weight: 700;
  color: var(--ink-deep);
  white-space: nowrap;
}

.opp-desc {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  line-height: 26px;
  color: var(--ink-deep);
  line-clamp: 4;
}

.g-row {
  border-bottom-width: 1px;
  border-bottom-color: #123a3166;
  border-bottom-style: dashed;
}

.g-act {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 34px;
  font-weight: 700;
  color: var(--copper);
  white-space: nowrap;
}

.g-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 34px;
  color: var(--ink-deep);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.r-row {
  background-color: var(--paper-old);
  border-left-width: 3px;
  border-left-color: #a65432;
}

.r-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  line-height: 24px;
  color: var(--ink-deep);
  line-clamp: 2;
}

.r-count {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 12px;
  line-height: 18px;
  color: var(--copper);
  white-space: nowrap;
}

.empty {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 24px;
  font-style: italic;
  color: #5b6662;
}

.l-row {
  background-color: var(--paper);
  border-bottom-width: 1px;
  border-bottom-color: #123a3140;
}

.l-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 14px;
  line-height: 22px;
  color: var(--ink-deep);
  line-clamp: 2;
}

:lang(en) .l-text {
  font-size: 13px;
  line-height: 20px;
}

.l-frame {
  border: 3px #b8322a;
}

.l-note {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 19px;
  color: var(--vermilion);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.legend-sw {
  border: 3px #b8322a;
  background-color: var(--paper);
}

.legend-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  color: var(--vermilion);
  white-space: nowrap;
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --paper: #f3eedf;
  --paper-old: #e3d9c2;
  --vermilion: #b8322a;
}

