                <div id="td-soph-atk-t" class="s-8dbda0">@UI_TABLE_SOPH_ATK</div>
              </div>
              <div id="td-soph-rf" class="td" bind:class.lit-a="tell_a | eq(2)" bind:class.lit-b="tell_b | eq(2)">
