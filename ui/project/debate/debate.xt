          <div id="opp-name" class="opp-name s-2a083a" bind:text="opp_name">費奇</div>
          <div id="opp-type" class="opp-type" bind:text="opp_type">犯人</div>
        </div>
        <div id="hand" bind:display="hand | gt(0)">
          <div id="hand-c1" class="cback"/>
          <div id="hand-c2" class="cback" bind:display="hand | ge(2)"/>
          <div id="hand-c3" class="cback" bind:display="hand | ge(3)"/>
          <div id="hand-n" class="hand-n" bind:text="format('×{0}', hand)">×1</div>
        </div>
        <div id="me-gauge" class="gauge" bind:display="mode | eq(0)" bind:class.mid="hp_me | range(0, hp_me_max, 0, 1) | between(0.2, 0.5)" bind:class.low="hp_me | range(0, hp_me_max, 0, 1) | lt(0.2)">
          <div id="gm-wrap" class="dial-wrap">
            <svg id="gm-dial" viewBox="0 0 164 164">
              <defs>
                <linearGradient id="gm-brass" x1="0" y1="0" x2="164" y2="164" gradientUnits="userSpaceOnUse">
                  <stop offset="0" stop-color="#e3b36a"/>
                  <stop offset="0.45" stop-color="#a65432"/>
                  <stop offset="1" stop-color="#5e2c18"/>
                </linearGradient>
              </defs>
              <circle id="Bezel" cx="82.0" cy="82.0" r="80.0" fill="url(#gm-brass)" stroke="#092e28" stroke-width="2"/>
              <circle id="Face" cx="82.0" cy="82.0" r="71.0" fill="#f6f1e3" stroke="#5e2c18" stroke-width="1.5"/>
