              <path id="ZoneAmber" d="M23.0 62.8 A62.0 62.0 0 0 1 82.0 20.0" fill="none" stroke="#d99034" stroke-width="7"/>
              <path id="ZoneWhite" d="M82.0 20.0 A62.0 62.0 0 0 1 136.2 112.1" fill="none" stroke="#fffdf5" stroke-width="7"/>
              <path id="Ticks" d="M34.4 109.5 L39.6 106.5 M27.3 87.7 L30.3 87.4 M29.7 65.0 L32.5 65.9 M41.1 45.2 L43.4 47.2 M59.6 31.8 L60.8 34.5 M82.0 27.0 L82.0 33.0 M104.4 31.8 L103.2 34.5 M122.9 45.2 L120.6 47.2 M134.3 65.0 L131.5 65.9 M136.7 87.7 L133.7 87.4 M129.6 109.5 L124.4 106.5" fill="none" stroke="#123a31" stroke-width="1.6"/>
              <circle id="Rivet0" cx="135.7" cy="28.3" r="2.2" fill="#092e28"/>
              <circle id="Rivet1" cx="135.7" cy="135.7" r="2.2" fill="#092e28"/>
              <circle id="Rivet2" cx="28.3" cy="135.7" r="2.2" fill="#092e28"/>
              <circle id="Rivet3" cx="28.3" cy="28.3" r="2.2" fill="#092e28"/>
            </svg>
            <div id="gm-needle" class="needle" bind:rotate="hp_me | range(0, hp_me_max, -120, 120)">
              <svg id="gm-needle-art" viewBox="0 0 12 112.0">
                <path id="Blade" d="M6 2 L9 56.0 L6 68.0 L3 56.0 Z" fill="#b8322a" stroke="#092e28" stroke-width="1"/>
              </svg>
            </div>
            <div id="gm-hub" class="hub"/>
            <div id="gm-num" class="gnum" bind:text="format('{0}／{1}', hp_me, hp_me_max)">81／100</div>
          </div>
          <div id="gm-steam" class="steam"/>
        </div>
        <div id="shisshu" class="sico" bind:class.on="st_shisshu | gt(0)">
          <svg id="shisshu-art" viewBox="0 0 40 40">
            <rect id="Seal" x="3" y="3" width="34" height="34" fill="#f3eedf" stroke="#5b6662" stroke-width="3"/>
            <rect id="Inner" x="9" y="9" width="22" height="22" fill="none" stroke="#5b6662" stroke-width="1.6"/>
            <path id="Crack" d="M22 2 L18 13 L24 19 L15 28 L19 38" fill="none" stroke="#092e28" stroke-width="2"/>
          </svg>
          <div id="shisshu-l1" class="lamp" bind:class.on="st_shisshu | ge(1)"/>
          <div id="shisshu-tip" class="tip">@UI_STATE_SHISSHU_TIP</div>
        </div>
        <div id="hachiku" class="sico" bind:class.on="st_hachiku | gt(0)" bind:class.pre="st_hachiku_preview" bind:class.gold="st_hachiku | ge(3)">
          <svg id="hachiku-art" viewBox="0 0 42 58">
            <rect id="Stem" x="14" y="3" width="14" height="52" rx="5" fill="#3d6b47" stroke="#20402a" stroke-width="1.4"/>
            <path id="Nodes" d="M14 20 H28 M14 37 H28" fill="none" stroke="#20402a" stroke-width="2"/>
            <path id="Leaf" d="M28 14 C36 10 40 12 41 16 C36 17 32 17 28 16 Z" fill="#3d6b47"/>
          </svg>
          <svg id="hk-c1" bind:display="st_hachiku | ge(1)" viewBox="0 0 42 58">
            <path id="C1" d="M18 44 L23 48 L20 53" fill="none" stroke="#e0a050" stroke-width="2"/>
          </svg>
          <svg id="hk-c2" bind:display="st_hachiku | ge(2)" viewBox="0 0 42 58">
            <path id="C2" d="M24 24 L19 29 L23 34" fill="none" stroke="#e0a050" stroke-width="2"/>
          </svg>
          <svg id="hk-c3" bind:display="st_hachiku | ge(3)" viewBox="0 0 42 58">
            <path id="C3" d="M18 6 L23 11 L19 17" fill="none" stroke="#e0a050" stroke-width="2"/>
          </svg>
          <div id="hachiku-n" class="hk-n" bind:text="format('×{0}', st_hachiku)" bind:display="st_hachiku | gt(0)">×1</div>
        </div>
        <div id="assist" class="assist" on:click(left)="if port(phase) eq 0 emit(assist)" bind:class.armed="assist_armed" bind:class.spent="assist_left | eq(0)">
          <div id="assist-face" class="face">
            <img id="assist-art" class="s-b00406" src="../shared/img/ch-c-arthur.png"/>
          </div>
          <div id="assist-t" class="assist-t">@BTN_DEB_ASSIST</div>
          <div id="assist-l1" class="lamp" bind:class.on="assist_left | ge(1)"/>
          <div id="assist-l2" class="lamp" bind:display="assist_left | ge(2)" bind:class.on="assist_left | ge(2)"/>
          <div id="assist-key" class="kicker">V</div>
        </div>
        <div id="chains" class="chains">
          <div id="row-1" class="rowno">I</div>
          <div id="row-2" class="rowno">II</div>
          <div id="row-3" class="rowno">III</div>
          <repeat id="chips" class="s-66a9df" port="chains">
            <div id="chip" class="chip" bind:display="item(id) | ne('')" bind:class.sel="item(sel)" bind:translate-x="item(pos) | scale(146) | offset(36)" bind:translate-y="item(chain) | scale(44) | offset(5)">
              <div id="chip-t" class="chip-t" bind:text="item(name)">鐘擺護蓋上的新刮痕</div>
              <div id="lk">
                <div id="lk-red" class="thread-red" bind:display="item(link) | eq(1)"/>
                <div id="lk-gold" class="thread-gold" bind:display="item(link) | eq(4)"/>
                <img id="lk-star" class="s-b00406" src="../shared/img/link-star.png" bind:display="item(link) | eq(4)"/>
                <div id="lk-pencil" class="thread-pencil" bind:display="item(link) | eq(2)"/>
                <img id="lk-weak" class="s-b00406" src="../shared/img/link-weak.png" bind:display="item(link) | eq(2)"/>
                <div id="lk-pencil5" class="thread-pencil" bind:display="item(link) | eq(5)"/>
                <div id="lk-band" class="bandage" bind:display="item(link) | eq(5)"/>
                <img id="lk-weak5" class="s-b00406" src="../shared/img/link-weak.png" bind:display="item(link) | eq(5)"/>
                <img id="lk-cut" class="s-b00406" src="../shared/img/lg-bad-ico.png" bind:display="item(link) | eq(3)"/>
                <div id="lk-snap-a" class="thread-pencil" bind:display="item(link) | eq(6)"/>
                <div id="lk-snap-b" class="thread-pencil" bind:display="item(link) | eq(6)"/>
                <div id="lk-snap-x" bind:display="item(link) | eq(6)"/>
              </div>
            </div>
          </repeat>
          <div id="cell-0" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 0)"/>
          <div id="cell-1" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 1)"/>
          <div id="cell-2" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 2)"/>
          <div id="cell-3" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 3)"/>
          <div id="cell-4" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 4)"/>
          <div id="cell-5" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 5)"/>
          <div id="cell-6" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 6)"/>
          <div id="cell-7" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 7)"/>
          <div id="cell-8" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 8)"/>
          <div id="cell-9" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 9)"/>
          <div id="cell-10" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 10)"/>
          <div id="cell-11" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 11)"/>
          <div id="cell-12" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 12)"/>
          <div id="cell-13" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 13)"/>
          <div id="cell-14" class="cell" on:click(left)="if port(phase) eq 0 set(seg, 14)"/>
        </div>
        <div id="confirm" class="confirm" bind:display="summary | ne('')" bind:class.armed="assist_armed">
          <div id="confirm-mark"/>
          <div id="summary" class="summary" bind:text="summary">反駁　對準：我在報時鳥報三點時就離開了　出示：報童小湯米的證詞</div>
          <div id="armed-t" class="armed-t" bind:display="assist_armed">@UI_DEB_ASSIST_ARMED</div>
          <div id="btn-back" class="backb" on:click(left)="if port(phase) eq 0 emit(back)" bind:display="phase | eq(0)">
            <div id="btn-back-t" class="backb-t">@BTN_BACK</div>
          </div>
          <div id="btn-lock" class="lockb" on:click(left)="if port(phase) eq 0 and port(can_lock) eq true emit(lock)" bind:display="phase | eq(0)" bind:class.off="can_lock | not">
            <div id="btn-lock-t" class="lockb-t">@BTN_DEB_LOCK</div>
          </div>
          <div id="locked" class="locked-t" bind:display="phase | ne(0)">@UI_DEB_LOCKED</div>
        </div>
        <div id="acts" class="acts" bind:class.locked="phase | ne(0)">
          <div id="grp-atk" class="grp">@UI_ACT_GROUP_ATK</div>
          <div id="act-1" class="tblock" on:click(left)="if port(phase) eq 0 set(act, 1)" bind:class.on="sel_act | eq(1)" bind:class.off="act_enabled | item(0) | not">
            <div id="tb-1-k" class="tb-k">1</div>
            <div id="tb-1-t" class="tb-t">@BTN_DEB_SOLID</div>
            <div id="tb-1-r" class="tb-r" bind:text="act_reason | item(0)" bind:display="act_reason | item(0) | ne('')">失守：這一回合不能反駁</div>
          </div>
          <div id="act-2" class="tblock" on:click(left)="if port(phase) eq 0 set(act, 2)" bind:class.on="sel_act | eq(2)" bind:class.off="act_enabled | item(1) | not">
            <div id="tb-2-k" class="tb-k">2</div>
            <div id="tb-2-t" class="tb-t">@BTN_DEB_SOPH</div>
            <div id="tb-2-r" class="tb-r" bind:text="act_reason | item(1)" bind:display="act_reason | item(1) | ne('')">失守：這一回合不能反駁</div>
          </div>
          <div id="divider" class="divider">
            <div id="rivet-1" class="rivet"/>
            <div id="rivet-2" class="rivet"/>
          </div>
          <div id="grp-def" class="grp">@UI_ACT_GROUP_DEF</div>
          <div id="act-3" class="tblock" on:click(left)="if port(phase) eq 0 set(act, 3)" bind:class.on="sel_act | eq(3)" bind:class.off="act_enabled | item(2) | not" bind:class.cracked="st_shisshu | gt(0)">
            <div id="tb-3-k" class="tb-k">3</div>
            <div id="tb-3-t" class="tb-t">@BTN_DEB_PARRY</div>
            <div id="tb-3-r" class="tb-r" bind:text="act_reason | item(2)" bind:display="act_reason | item(2) | ne('')">失守：這一回合不能反駁</div>
            <svg id="tb-3-crack" class="tb-crack" viewBox="0 0 150 72">
              <path id="Crack" d="M92 0 L80 18 L96 30 L70 48 L84 58 L74 72" fill="none" stroke="#f3eedfb3" stroke-width="2.4"/>
            </svg>
          </div>
          <div id="act-4" class="tblock" on:click(left)="if port(phase) eq 0 set(act, 4)" bind:class.on="sel_act | eq(4)" bind:class.off="act_enabled | item(3) | not">
            <div id="tb-4-k" class="tb-k">4</div>
            <div id="tb-4-t" class="tb-t">@BTN_DEB_OBSERVE</div>
            <div id="tb-4-r" class="tb-r" bind:text="act_reason | item(3)" bind:display="act_reason | item(3) | ne('')">失守：這一回合不能反駁</div>
          </div>
        </div>
        <div id="status" class="status">
          <div id="status-k" class="kicker">@UI_DEB_STATUS_LABEL</div>
          <div id="status-list">
            <div id="st-brk" class="st-row st-brk" bind:display="st_break">@UI_DEB_STATUS_BREAK_TURN</div>
            <div id="st-shaken" bind:display="st_shaken | gt(0)">
              <div id="st-shaken-l" class="lamp on"/>
              <div id="st-shaken-t" class="st-row">@UI_DEB_PREVIEW_SHAKEN</div>
              <div id="st-shaken-d1" class="dot"/>
              <div id="st-shaken-d2" class="dot" bind:display="st_shaken | ge(2)"/>
            </div>
            <div id="st-tail" bind:display="st_tail | gt(0)">
              <div id="st-tail-t" class="st-row">@UI_TAIL</div>
              <div id="st-tail-d1" class="dot"/>
              <div id="st-tail-d2" class="dot" bind:display="st_tail | ge(2)"/>
            </div>
            <div id="st-none-1" bind:display="st_break | not">
              <div id="st-none-2" bind:display="st_shaken | eq(0)">
                <div id="st-none-3" bind:display="st_tail | eq(0)">
                  <div id="st-none" class="st-flags" bind:display="st_flags | eq('')">—</div>
                </div>
              </div>
            </div>
            <div id="st-flags" class="st-flags" bind:text="st_flags" bind:display="st_flags | ne('')">不能補強・聽眾不耐</div>
          </div>
        </div>
        <div id="btn-notes" class="tab" on:click(left)="emit(notes)">
          <div id="btn-notes-t" class="tab-t">@BTN_DEB_NOTES</div>
        </div>
        <div id="float-opp" class="float" bind:text="float_opp" bind:display="float_opp | ne('')">−35</div>
        <div id="float-me" class="float" bind:text="float_me" bind:display="float_me | ne('')">−22</div>
        <div id="table" class="s-66a9df">
          <div id="table-handle" class="tab s-e1040c" on:click(left)="state(Open, toggle, target=#table)">
            <div id="table-handle-t" class="tab-t">@BTN_DEB_TABLE</div>
            <svg id="table-handle-arrow" viewBox="0 0 12 12">
              <path id="Tri" d="M2 1 L11 6 L2 11 Z" fill="#f3eedf"/>
            </svg>
          </div>
          <div id="table-panel" class="tbl s-e1040c">
            <div id="tbl-title" class="col-head">@UI_TABLE_TITLE</div>
            <div id="th-atk" class="th" bind:class.lit-a="tell_a | le(1)" bind:class.lit-b="tell_b | between(0, 1)">@UI_TABLE_COL_ATK</div>
            <div id="th-rf" class="th" bind:class.lit-a="tell_a | eq(2)" bind:class.lit-b="tell_b | eq(2)">@UI_TABLE_COL_REINFORCE</div>
            <div id="th-trap" class="th" bind:class.lit-a="tell_a | eq(3)" bind:class.lit-b="tell_b | eq(3)">@UI_TABLE_COL_TRAP</div>
            <div id="tr-solid" class="trow">
              <div id="rh-solid" class="rh">
                <div id="rh-solid-t">@BTN_DEB_SOLID</div>
              </div>
              <div id="td-solid-atk" class="td" bind:class.lit-a="tell_a | le(1)" bind:class.lit-b="tell_b | between(0, 1)">
                <div id="td-solid-atk-t" class="s-8dbda0">@UI_TABLE_SOLID_ATK</div>
              </div>
              <div id="td-solid-rf" class="td" bind:class.lit-a="tell_a | eq(2)" bind:class.lit-b="tell_b | eq(2)">
                <div id="td-solid-rf-t" class="s-8dbda0">@UI_TABLE_SOLID_REINFORCE</div>
              </div>
              <div id="td-solid-trap" class="td" bind:class.lit-a="tell_a | eq(3)" bind:class.lit-b="tell_b | eq(3)">
