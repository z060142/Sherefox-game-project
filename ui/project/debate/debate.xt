          <div id="konju-l2" class="lamp" bind:class.on="st_konju | ge(2)"/>
          <div id="konju-tip" class="tip">@UI_STATE_KONJU_TIP</div>
        </div>
        <div id="counter-box" class="sheet-paper" bind:display="mode | ne(0)">
          <div id="counter-box-k" class="kicker">@UI_PAPER_EXTRA</div>
