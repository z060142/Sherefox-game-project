              <circle id="Rivet2" cx="27.1" cy="128.9" r="2.2" fill="#092e28"/>
              <circle id="Rivet3" cx="27.1" cy="27.1" r="2.2" fill="#092e28"/>
            </svg>
            <div id="go-needle" class="needle" bind:rotate="hp_opp | range(0, hp_opp_max, -120, 120)">
              <svg id="go-needle-art" viewBox="0 0 12 104.0">
                <path id="Blade" d="M6 2 L9 52.0 L6 64.0 L3 52.0 Z" fill="#b8322a" stroke="#092e28" stroke-width="1"/>
              </svg>
            </div>
            <div id="go-hub" class="hub"/>
            <div id="go-num" class="gnum" bind:text="format('{0}／{1}', hp_opp, hp_opp_max)">70／100</div>
          </div>
          <div id="go-valve" class="steam valve"/>
          <div id="go-steam" class="steam"/>
          <div id="go-shaken" class="plate" bind:display="st_shaken | gt(0)">
            <div id="go-shaken-l" class="lamp on"/>
            <div id="go-shaken-t" class="plate-t">@UI_DEB_PREVIEW_SHAKEN</div>
          </div>
        </div>
        <div id="konju" class="sico" bind:display="mode | eq(0)" bind:class.on="st_konju | gt(0)">
          <svg id="konju-art" viewBox="0 0 44 44">
            <circle id="Disc" cx="22" cy="22" r="20" fill="#f3eedf" stroke="#b8322a" stroke-width="2"/>
            <path id="Claw" d="M11 9 C16 17 15 27 10 35 M20 7 C25 16 24 27 19 37 M29 9 C34 17 33 27 28 35" fill="none" stroke="#b8322a" stroke-width="3.4"/>
          </svg>
