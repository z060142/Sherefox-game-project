              </div>
              <div id="td-parry-atk" class="td" bind:class.lit-a="tell_a | le(1)" bind:class.lit-b="tell_b | between(0, 1)">
                <div id="td-parry-atk-t" class="s-8dbda0">@UI_TABLE_PARRY_ATK</div>
              </div>
              <div id="td-parry-rf" class="td" bind:class.lit-a="tell_a | eq(2)" bind:class.lit-b="tell_b | eq(2)">
                <div id="td-parry-rf-t" class="s-8dbda0">@UI_TABLE_PARRY_REINFORCE</div>
              </div>
              <div id="td-parry-trap" class="td" bind:class.lit-a="tell_a | eq(3)" bind:class.lit-b="tell_b | eq(3)">
                <div id="td-parry-trap-t" class="s-8dbda0">@UI_TABLE_PARRY_TRAP</div>
              </div>
            </div>
            <div id="tr-obs" class="trow">
              <div id="rh-obs" class="rh">
                <div id="rh-obs-t">@BTN_DEB_OBSERVE</div>
              </div>
              <div id="td-obs-atk" class="td" bind:class.lit-a="tell_a | le(1)" bind:class.lit-b="tell_b | between(0, 1)">
                <div id="td-obs-atk-t" class="s-8dbda0">@UI_TABLE_OBS_ATK</div>
              </div>
              <div id="td-obs-rf" class="td" bind:class.lit-a="tell_a | eq(2)" bind:class.lit-b="tell_b | eq(2)">
                <div id="td-obs-rf-t" class="s-8dbda0">@UI_TABLE_OBS_REINFORCE</div>
              </div>
              <div id="td-obs-trap" class="td" bind:class.lit-a="tell_a | eq(3)" bind:class.lit-b="tell_b | eq(3)">
                <div id="td-obs-trap-t" class="s-8dbda0">@UI_TABLE_OBS_TRAP</div>
              </div>
            </div>
          </div>
        </div>
        <div id="reveal" bind:display="phase | ne(0)">
          <div id="reveal-band" class="band"/>
          <div id="reveal-cards" class="rcards" bind:class.stale="reveal_combo | eq(3)">
            <div id="rc-me" class="rcard" bind:class.m1="reveal_me | eq(1)" bind:class.m2="reveal_me | eq(2)" bind:class.m3="reveal_me | eq(3)" bind:class.m4="reveal_me | eq(4)">
              <div id="rc-me-front">
                <div id="rc-me-who" class="rwho">@SPK_SHEREFOX</div>
                <div id="rc-me-rule" class="s-15baa9"/>
                <div id="rc-me-i1" class="rname rm-1">
                  <svg id="rc-me-i1-art" viewBox="0 0 32 32">
                    <rect id="L1" x="3" y="11" width="16" height="10" rx="5" fill="none" stroke="#b8322a" stroke-width="2.6"/>
                    <rect id="L2" x="13" y="11" width="16" height="10" rx="5" fill="none" stroke="#b8322a" stroke-width="2.6"/>
                  </svg>
                </div>
                <div id="rc-me-n1" class="rname rm-1">@BTN_DEB_SOLID</div>
                <div id="rc-me-i2" class="rname rm-2">
                  <svg id="rc-me-i2-art" viewBox="0 0 32 32">
                    <path id="Dash" d="M2 16 H7 M25 16 H30" fill="none" stroke="#2e2f2d" stroke-width="2.4"/>
                    <circle id="Gear" cx="16" cy="16" r="8" fill="#a65432" stroke="#092e28" stroke-width="1.6"/>
                    <circle id="Hub" cx="16" cy="16" r="3" fill="#f3eedf"/>
                    <path id="Crack" d="M14 7 L17 12 L14 16 L18 21 L16 25" fill="none" stroke="#f3eedf" stroke-width="1.6"/>
                  </svg>
                </div>
                <div id="rc-me-n2" class="rname rm-2">@BTN_DEB_SOPH</div>
                <div id="rc-me-i3" class="rname rm-3">
                  <svg id="rc-me-i3-art" viewBox="0 0 32 32">
                    <circle id="Ring" cx="16" cy="16" r="12" fill="none" stroke="#b8322a" stroke-width="2.6"/>
                    <rect id="Bar" x="14.5" y="8" width="3" height="11" fill="#b8322a"/>
                    <circle id="Dot" cx="16" cy="23" r="2" fill="#b8322a"/>
                  </svg>
                </div>
                <div id="rc-me-n3" class="rname rm-3">@BTN_DEB_PARRY</div>
                <div id="rc-me-i4" class="rname rm-4">
                  <svg id="rc-me-i4-art" viewBox="0 0 32 32">
                    <path id="Lid" d="M3 16 C9 7 23 7 29 16 C23 25 9 25 3 16 Z" fill="#f3eedf" stroke="#123a31" stroke-width="2"/>
                    <circle id="Iris" cx="16" cy="16" r="5" fill="#123a31"/>
                    <circle id="Glint" cx="17.5" cy="14.5" r="1.6" fill="#f3eedf"/>
                  </svg>
                </div>
                <div id="rc-me-n4" class="rname rm-4">@BTN_DEB_OBSERVE</div>
              </div>
              <div id="rc-me-back" class="rback s-efadb3"/>
            </div>
            <div id="rc-opp" class="rcard" bind:class.o0="reveal_opp | eq(0)" bind:class.o1="reveal_opp | eq(1)" bind:class.o2="reveal_opp | eq(2)" bind:class.o3="reveal_opp | eq(3)" bind:class.o4="reveal_opp | eq(4)">
              <div id="rc-opp-front">
                <div id="rc-opp-who" class="rwho" bind:text="opp_name">費奇</div>
                <div id="rc-opp-rule" class="s-15baa9"/>
                <div id="rc-opp-i0" class="rname ro-0">
                  <svg id="rc-opp-i0-art" viewBox="0 0 32 32">
                    <rect id="Sheet" x="6" y="4" width="20" height="24" fill="#f3eedf" stroke="#123a31" stroke-width="2"/>
                    <rect id="Head" x="9" y="8" width="14" height="4" fill="#123a31"/>
                    <path id="Lines" d="M9 16 H23 M9 20 H23 M9 24 H18" fill="none" stroke="#123a31" stroke-width="1.6"/>
                  </svg>
                </div>
                <div id="rc-opp-n0" class="rname ro-0">@UI_ACT_CLAIM</div>
                <div id="rc-opp-i1" class="rname ro-1">
                  <svg id="rc-opp-i1-art" viewBox="0 0 32 32">
                    <path id="Chev" d="M5 8 L12 16 L5 24 M12 8 L19 16 L12 24 M19 8 L26 16 L19 24" fill="none" stroke="#b8322a" stroke-width="3" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div id="rc-opp-n1" class="rname ro-1">@UI_ACT_RUSH</div>
                <div id="rc-opp-i2" class="rname ro-2">
                  <svg id="rc-opp-i2-art" viewBox="0 0 32 32">
                    <path id="Shield" d="M16 3 L27 7 V15 C27 22 22 27 16 29 C10 27 5 22 5 15 V7 Z" fill="#a65432" stroke="#092e28" stroke-width="1.6"/>
                    <path id="Band" d="M16 7 V25 M9 13 H23" fill="none" stroke="#e0a050" stroke-width="2"/>
                  </svg>
                </div>
                <div id="rc-opp-n2" class="rname ro-2">@UI_ACT_REINFORCE</div>
                <div id="rc-opp-i3" class="rname ro-3">
                  <svg id="rc-opp-i3-art" viewBox="0 0 32 32">
                    <path id="Jaw" d="M4 18 C8 28 24 28 28 18" fill="none" stroke="#092e28" stroke-width="2.4"/>
                    <path id="Teeth" d="M5 17 L8 10 L11 17 L14 10 L17 17 L20 10 L23 17 L26 10 L28 17" fill="none" stroke="#123a31" stroke-width="2" stroke-linejoin="round"/>
                    <circle id="Pin" cx="16" cy="25" r="2" fill="#a65432"/>
                  </svg>
                </div>
                <div id="rc-opp-n3" class="rname ro-3">@UI_ACT_TRAP</div>
                <div id="rc-opp-i4" class="rname ro-4">
                  <svg id="rc-opp-i4-art" viewBox="0 0 32 32">
                    <path id="Claw" d="M8 4 C12 12 12 20 7 28 M16 3 C20 12 20 20 15 29 M24 4 C28 12 28 20 23 28" fill="none" stroke="#b8322a" stroke-width="3"/>
                  </svg>
                </div>
                <div id="rc-opp-n4" class="rname ro-4">@UI_TAIL</div>
              </div>
              <div id="rc-opp-back" class="rback s-efadb3"/>
            </div>
          </div>
          <div id="clash" bind:display="reveal_combo | eq(2)">
            <svg id="clash-art" viewBox="0 0 104 70">
              <xt-star id="Burst" cx="52" cy="35" points="10" r="34" r2="14" fill="#e0a050"/>
              <path id="Cross" d="M30 14 L74 56 M74 14 L30 56" fill="none" stroke="#b8322a" stroke-width="5"/>
            </svg>
            <div id="clash-t" class="clash-t">@MSG_DEB_CLASH</div>
          </div>
          <div id="rl-wrap" bind:display="phase | eq(1)">
            <div id="reveal-line" class="rline" bind:text="reveal_line" bind:display="reveal_line | ne('')">報時鳥叫了三聲，店裡的人都——</div>
          </div>
          <div id="res-wrap" bind:display="phase | ge(2)">
            <div id="result-line" class="resline" bind:text="result_line" bind:display="result_line | ne('')">截斷！移除主張，反擊 30。</div>
          </div>
          <div id="reveal-hit" on:click(left)="if port(phase) eq 1 emit(skip); if port(phase) ge 2 emit(next)"/>
        </div>
        <div id="vignette"/>
      </div>
      <div id="roller"/>
    </div>
  </body>

  <layout>
    /* import: Debate.dc.html:1 */
    #debate {
      height: 100vh;
      margin-bottom: 0;
      margin-left: 0;
      margin-right: 0;
      margin-top: 0;
      overflow: hidden;
      position: relative;
      width: 100vw;
