              <path id="ZoneWhite" d="M78.0 20.0 A58.0 58.0 0 0 1 128.7 106.1" fill="none" stroke="#fffdf5" stroke-width="7"/>
              <path id="Ticks" d="M33.8 103.5 L39.0 100.5 M27.3 83.3 L30.3 83.0 M29.5 62.2 L32.3 63.2 M40.1 43.9 L42.3 45.9 M57.3 31.4 L58.5 34.1 M78.0 27.0 L78.0 33.0 M98.7 31.4 L97.5 34.1 M115.9 43.9 L113.7 45.9 M126.5 62.2 L123.7 63.2 M128.7 83.3 L125.7 83.0 M122.2 103.5 L117.0 100.5" fill="none" stroke="#123a31" stroke-width="1.6"/>
              <circle id="Rivet0" cx="128.9" cy="27.1" r="2.2" fill="#092e28"/>
