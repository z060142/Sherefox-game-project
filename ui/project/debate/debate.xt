    /* import: Debate.dc.html:1/2 */
    #roller {
      anchor: stretch stretch screen;
      transform: translateX(2700px);
    }
    .nk {
      display: none;
    }
    .node.s0 .nk-0 {
      display: block;
    }
    .node.s1 .nk-1 {
      display: block;
    }
    .node.s2 .nk-2 {
      display: block;
    }
    .node.s3 .nk-3 {
      display: block;
    }
    .node.s4 .nk-1 {
      display: block;
    }
    .node.s1 .nk-1 {
      padding-left: 4px;
    }
    .node.s4 {
      transform: translateY(26px) rotate(5deg);
    }
    .crack {
      display: none;
    }
    .node.s2 .crack {
      display: block;
    }
    .strike {
      display: none;
      transform-origin: 0% 50%;
    }
    .node.s4 .strike {
      display: block;
    }
    .lit-mark {
      display: none;
    }
    .node.s1 .lit-mark {
      display: block;
    }
    .q-en {
      display: none;
    }
    :lang(en) .q-en {
      display: block;
    }
    :lang(en) .q-zh {
      display: none;
    }
    .gesture {
      overflow: hidden;
    }
    .clar {
      display: none;
    }
    .tell.c0 .clar-0 {
      display: block;
    }
    .tell.c1 .clar-1 {
      display: block;
    }
    .tell.c2 .clar-2 {
      display: block;
    }
    .cand-l {
      display: none;
    }
    .ci {
      display: none;
    }
    .cand.a0 .ca-0 {
      display: block;
    }
    .cand.a1 .ca-1 {
      display: block;
    }
    .cand.a2 .ca-2 {
      display: block;
    }
    .cand.a3 .ca-3 {
      display: block;
    }
    .gauge.brk .gring {
      display: block;
    }
    .gring {
      display: none;
    }
    .tip {
      display: none;
    }
    #konju:hover #konju-tip {
      display: block;
    }
    #shisshu:hover #shisshu-tip {
      display: block;
    }
    .summary {
      overflow: hidden;
    }
    .armed-t {
      overflow: hidden;
    }
    .tb-crack {
      display: none;
    }
    .tblock.cracked .tb-crack {
      display: block;
    }
    .st-brk {
      padding-left: 6px;
    }
    #table-panel {
      display: none;
    }
    #table:state(Open) #table-panel {
      display: block;
    }
    .rname {
      display: none;
    }
    .rcard.m1 .rm-1 {
      display: block;
    }
    .rcard.m2 .rm-2 {
      display: block;
    }
    .rcard.m3 .rm-3 {
      display: block;
    }
    .rcard.m4 .rm-4 {
      display: block;
    }
    .rcard.o0 .ro-0 {
      display: block;
    }
    .rcard.o1 .ro-1 {
      display: block;
    }
    .rcard.o2 .ro-2 {
      display: block;
    }
    .rcard.o3 .ro-3 {
      display: block;
    }
    .rcard.o4 .ro-4 {
      display: block;
    }
    .rline {
      overflow: hidden;
    }
    .resline {
      overflow: hidden;
    }
  </layout>
  <style src="../shared/base.xts"/>
  <style src="debate.xts"/>
  <timelines>
    @timeline fidget {
      #opp-bob {
        0ms {
          transform: translateY(0px) rotate(0deg);
        }
        750ms ease-in-out {
          transform: translateY(-5px) rotate(-0.6deg);
        }
        1500ms ease-in-out {
          transform: translateY(0px) rotate(0deg);
        }
      }
    }
    @timeline float-me {
      #gm-steam {
        0ms {
          opacity: 0.95;
          transform: scale(0.6);
        }
        700ms ease-out {
          opacity: 0;
          transform: scale(1.8);
        }
      }
      #float-me {
        0ms {
          opacity: 0;
          transform: translateY(14px) scale(1.3);
        }
        140ms ease-out {
          opacity: 1;
          transform: translateY(0px) scale(1);
        }
        1000ms {
          opacity: 1;
          transform: translateY(-6px) scale(1);
        }
        1400ms ease-in {
          opacity: 0;
          transform: translateY(-30px) scale(1);
        }
      }
    }
    @timeline float-opp {
      #go-steam {
        0ms {
          opacity: 0.95;
          transform: scale(0.6);
        }
        700ms ease-out {
          opacity: 0;
          transform: scale(1.8);
        }
      }
      #float-opp {
        0ms {
          opacity: 0;
          transform: translateY(14px) scale(1.3);
        }
        140ms ease-out {
          opacity: 1;
          transform: translateY(0px) scale(1);
        }
        1000ms {
          opacity: 1;
          transform: translateY(-6px) scale(1);
        }
        1400ms ease-in {
          opacity: 0;
          transform: translateY(-30px) scale(1);
        }
      }
    }
    @timeline ink-in {
      #opp-ink {
        0ms {
          opacity: 0;
        }
        420ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline intro {
      #roller {
        0ms {
          transform: translateX(-40px);
          opacity: 1;
        }
        590ms {
          opacity: 1;
        }
        600ms ease-in-out {
          transform: translateX(2700px);
          opacity: 0;
        }
      }
    }
    @timeline picker-in {
      #picker {
        0ms {
          opacity: 0;
          transform: translateY(18px);
        }
        220ms ease-out {
          opacity: 1;
          transform: translateY(0px);
        }
      }
    }
    @timeline reveal {
      #rc-me {
        0ms {
          transform: translateX(-760px) scaleX(1);
        }
        300ms ease-out {
          transform: translateX(0px) scaleX(1);
        }
        420ms ease-in {
          transform: translateX(0px) scaleX(0);
        }
        540ms ease-out {
          transform: translateX(0px) scaleX(1);
        }
      }
      #rc-me-front {
        0ms {
          opacity: 0;
        }
        419ms {
          opacity: 0;
        }
        420ms {
          opacity: 1;
        }
      }
      #rc-me-back {
        0ms {
          opacity: 1;
        }
        419ms {
          opacity: 1;
        }
        420ms {
          opacity: 0;
        }
      }
      #rc-opp {
        0ms {
          transform: translateX(760px) scaleX(1);
        }
        300ms ease-out {
          transform: translateX(0px) scaleX(1);
        }
        420ms ease-in {
          transform: translateX(0px) scaleX(0);
        }
        540ms ease-out {
          transform: translateX(0px) scaleX(1);
        }
      }
      #rc-opp-front {
        0ms {
          opacity: 0;
        }
        419ms {
          opacity: 0;
        }
        420ms {
          opacity: 1;
        }
      }
      #rc-opp-back {
        0ms {
          opacity: 1;
        }
        419ms {
          opacity: 1;
        }
        420ms {
          opacity: 0;
        }
      }
      #clash {
        0ms {
          opacity: 0;
          transform: scale(0.4);
        }
        540ms {
          opacity: 0;
          transform: scale(0.4);
        }
        640ms ease-out {
          opacity: 1;
          transform: scale(1.1);
        }
        760ms {
          transform: scale(1);
        }
      }
      #reveal-line {
        0ms {
          opacity: 0;
        }
        560ms {
          opacity: 0;
        }
        760ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline vignette {
      #vignette {
        0ms {
          opacity: 0;
        }
        120ms ease-out {
          opacity: 1;
        }
        520ms ease-in {
          opacity: 0;
        }
      }
    }
  </timelines>
</xt>
