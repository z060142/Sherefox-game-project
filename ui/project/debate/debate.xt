<xt version="2">
  <head>
    <title>Debate</title>
  </head>

  <ports>
    mode: number in = 0
    opp_char: string in = "valet"
    opp_name: string in = "費奇"
    opp_type: string in = "犯人"
    hp_me: number in = 81
    hp_me_max: number in = 100
    hp_opp: number in = 70
    hp_opp_max: number in = 100
    counter_text: string in = ""
    round_text: string in = "第 3 回合"
    nodes: list<struct{id: string, text: string, state: number, src: string}> in = [{"id":"CH02_N1","text":"我在報時鳥報三點時就離開了","state":1,"src":""},{"id":"CH02_N2","text":"老闆有工具也有時間掉包","state":0,"src":""},{"id":"CH02_N3","text":"新機芯是這家店的零件","state":0,"src":""}]
    claim_preview: string in = "主張 26＋4×3＝38"
    tell_line: string in = "小人記得清清楚楚，報時鳥一叫我就走了。"
    tell_gesture: string in = "拉袖口、鞠躬"
    tell_clarity: number in = 1
    tell_basis: string in = ""
    tell_a: number in = 0
    tell_b: number in = 1
    tell_star: number in = -1
    tell_star_text: string in = ""
    hand: number in = 1
    chains: list<struct{chain: number, pos: number, id: string, name: string, link: number, sel: bool}> in = [{"chain":0,"pos":0,"id":"E02_03","name":"鐘擺護蓋上的新刮痕","link":1,"sel":false},{"chain":0,"pos":1,"id":"E02_02","name":"報時鳥鐘","link":1,"sel":false},{"chain":0,"pos":2,"id":"E02_04","name":"報童小湯米的證詞","link":1,"sel":false},{"chain":0,"pos":3,"id":"E02_05","name":"寄修收據（店鐘 3:05 簽收）","link":0,"sel":false},{"chain":1,"pos":0,"id":"E02_06","name":"店內零件目錄","link":2,"sel":false},{"chain":1,"pos":1,"id":"E02_01","name":"特製雙層發條齒輪","link":0,"sel":false}]
    act_enabled: list<bool> in = [true,true,true,true]
    act_reason: list<string> in = ["","","",""]
    sel_act: number in = 3
    parry_cards: list<struct{id: string, name: string}> in = [{"id":"E02_02","name":"報時鳥鐘"},{"id":"E02_04","name":"報童小湯米的證詞"}]
    summary: string in = "反駁　對準：我在報時鳥報三點時就離開了　出示：報童小湯米的證詞"
    preview: string in = "截斷：反擊 30、粉碎主張"
    preview_vs: string in = "若主張：截斷成立　若猛攻：截斷，對方動搖"
    can_lock: bool in = true
    instinct_left: number in = 2
    assist_left: number in = 1
    instinct_ok: bool in = true
    assist_armed: bool in = false
    act: number out = 0
    seg: number out = 0
    target: string out = ""
    card: string out = ""
    lock: event out
    back: event out
    instinct: event out
    assist: event out
    st_shaken: number in = 0
    st_break: bool in = false
    st_tail: number in = 0
    st_hachiku: number in = 1
    st_hachiku_preview: bool in = false
    st_konju: number in = 0
    st_shisshu: number in = 0
    st_flags: string in = ""
    phase: number in = 0
    reveal_me: number in = 3
    reveal_opp: number in = 0
    reveal_seq: number in = 0
    reveal_combo: number in = 1
    reveal_line: string in = "報時鳥叫了三聲，店裡的人都——"
    float_opp: string in = ""
    float_me: string in = ""
    result_line: string in = ""
    skip: event out
    next: event out
    notes: event out
    improv: event out
    improv_ok: bool in = false
    picker_title: string in = ""
    settings: event out
  </ports>

  <body on:show="play(intro); play(fidget, loop)" key-activation="none">
    <div id="debate" tabindex="0" autofocus="" on:port(phase)="if port(phase) eq 0 play(fidget, loop) else pause(fidget)" on:port(opp_char)="play(ink-in)" on:port(parry_cards)="play(picker-in)" on:port(reveal_seq)="play(reveal)" on:port(float_opp)="play(float-opp)" on:port(float_me)="play(float-me)" on:key(1)="if port(phase) eq 0 set(act, 1)" on:key(2)="if port(phase) eq 0 set(act, 2)" on:key(3)="if port(phase) eq 0 set(act, 3)" on:key(4)="if port(phase) eq 0 set(act, 4)" on:key(F)="if port(phase) eq 0 and port(instinct_ok) eq true emit(instinct)" on:key(V)="if port(phase) eq 0 emit(assist)" on:key(T)="state(Open, toggle, target=#table)" on:key(Enter)="if port(phase) eq 0 and port(can_lock) eq true emit(lock); if port(phase) eq 1 emit(skip); if port(phase) ge 2 emit(next)" on:key(Space)="if port(phase) eq 1 emit(skip); if port(phase) ge 2 emit(next)" on:key(Backspace)="if port(phase) eq 0 emit(back)" on:key(N)="emit(notes)" on:click(right)="if port(phase) eq 0 emit(back)" on:key(Escape)="emit(settings)" on:key(F1)="emit(settings)">
      <img id="bg-art" src="../shared/img/bg-debate.jpg"/>
      <div id="sheet">
        <div id="opp-fig">
          <div id="opp-ink">
            <div id="opp-bob">
              <img id="opp-sherefox" class="s-b00406" src="../shared/img/ch-c-sherefox.png" bind:display="opp_char | eq('sherefox')"/>
              <img id="opp-arthur" class="s-b00406" src="../shared/img/ch-c-arthur.png" bind:display="opp_char | eq('arthur')"/>
              <img id="opp-baskerville" class="s-b00406" src="../shared/img/ch-c-baskerville.png" bind:display="opp_char | eq('baskerville')"/>
              <img id="opp-victor" class="s-b00406" src="../shared/img/ch-c-victor.png" bind:display="opp_char | eq('victor')"/>
              <img id="opp-wolfhart" class="s-b00406" src="../shared/img/ch-c-wolfhart.png" bind:display="opp_char | eq('wolfhart')"/>
              <img id="opp-valet" class="s-b00406" src="../shared/img/ch-c-valet.png" bind:display="opp_char | eq('valet')"/>
              <img id="opp-partner" class="s-b00406" src="../shared/img/ch-c-partner.png" bind:display="opp_char | eq('partner')"/>
            </div>
          </div>
        </div>
        <div id="me-fig">
          <img id="me-sherefox" class="s-b00406" src="../shared/img/ch-c-sherefox.png"/>
        </div>
        <div id="mast-bg"/>
        <div id="mast">
          <div id="mast-name" class="mast-t">@UI_PAPER_MAST</div>
          <div id="mast-extra" class="extra">@UI_PAPER_EXTRA</div>
          <div id="round" class="round" bind:text="round_text">第 3 回合</div>
        </div>
        <div id="tail" class="plate" bind:display="st_tail | gt(0)">
          <div id="tail-t" class="plate-t">@UI_TAIL</div>
          <div id="tail-l1" class="lamp on"/>
          <div id="tail-l2" class="lamp on" bind:display="st_tail | ge(2)"/>
        </div>
        <div id="mast-rule" class="rule2"/>
        <div id="claims">
          <div id="node-0" class="node" on:click(left)="if port(phase) eq 0 set(target, port(nodes) | item(0) | item(id))" bind:display="nodes | item(0) | item(id) | ne('')" bind:class.s0="nodes | item(0) | item(state) | eq(0)" bind:class.s1="nodes | item(0) | item(state) | eq(1)" bind:class.s2="nodes | item(0) | item(state) | eq(2)" bind:class.s3="nodes | item(0) | item(state) | eq(3)" bind:class.s4="nodes | item(0) | item(state) | eq(4)">
            <div id="nk-0">
              <div id="nk-0-0" class="kicker nk nk-0">@UI_NODE_NORMAL</div>
              <div id="nk-0-1" class="kicker nk nk-1">@UI_NODE_LIT</div>
              <div id="nk-0-2" class="kicker nk nk-2">@UI_NODE_FRAGILE</div>
              <div id="nk-0-3" class="kicker nk nk-3">@UI_NODE_SECOND</div>
            </div>
            <div id="lit-0" class="lit-mark">
              <svg id="lit-0-art" viewBox="0 0 14 14">
                <path id="Tri" d="M1 2 H13 L7 12 Z" fill="#f3eedf"/>
              </svg>
            </div>
            <div id="node-0-t" class="node-text" bind:text="nodes | item(0) | item(text)">我在報時鳥報三點時就離開了</div>
            <div id="node-0-src" class="node-src" bind:display="nodes | item(0) | item(src) | ne('')">@UI_NODE_STURDY_SRC</div>
            <svg id="crack-0" class="crack" viewBox="0 0 40 40">
              <path id="Crack" d="M38 2 L28 12 L32 18 L20 26 L24 32 L12 38" fill="none" stroke="#b8322a" stroke-width="2"/>
            </svg>
            <div id="strike-0" class="strike s-b7ad68"/>
          </div>
          <div id="node-1" class="node" on:click(left)="if port(phase) eq 0 set(target, port(nodes) | item(1) | item(id))" bind:display="nodes | item(1) | item(id) | ne('')" bind:class.s0="nodes | item(1) | item(state) | eq(0)" bind:class.s1="nodes | item(1) | item(state) | eq(1)" bind:class.s2="nodes | item(1) | item(state) | eq(2)" bind:class.s3="nodes | item(1) | item(state) | eq(3)" bind:class.s4="nodes | item(1) | item(state) | eq(4)">
            <div id="pipe-1" class="pipe"/>
            <div id="nk-1">
              <div id="nk-1-0" class="kicker nk nk-0">@UI_NODE_NORMAL</div>
              <div id="nk-1-1" class="kicker nk nk-1">@UI_NODE_LIT</div>
              <div id="nk-1-2" class="kicker nk nk-2">@UI_NODE_FRAGILE</div>
              <div id="nk-1-3" class="kicker nk nk-3">@UI_NODE_SECOND</div>
            </div>
            <div id="lit-1" class="lit-mark">
              <svg id="lit-1-art" viewBox="0 0 14 14">
                <path id="Tri" d="M1 2 H13 L7 12 Z" fill="#f3eedf"/>
              </svg>
            </div>
            <div id="node-1-t" class="node-text" bind:text="nodes | item(1) | item(text)">老闆有工具也有時間掉包</div>
            <div id="node-1-src" class="node-src" bind:display="nodes | item(1) | item(src) | ne('')">@UI_NODE_STURDY_SRC</div>
            <svg id="crack-1" class="crack" viewBox="0 0 40 40">
              <path id="Crack" d="M38 2 L28 12 L32 18 L20 26 L24 32 L12 38" fill="none" stroke="#b8322a" stroke-width="2"/>
            </svg>
            <div id="strike-1" class="strike s-b7ad68"/>
          </div>
          <div id="node-2" class="node" on:click(left)="if port(phase) eq 0 set(target, port(nodes) | item(2) | item(id))" bind:display="nodes | item(2) | item(id) | ne('')" bind:class.s0="nodes | item(2) | item(state) | eq(0)" bind:class.s1="nodes | item(2) | item(state) | eq(1)" bind:class.s2="nodes | item(2) | item(state) | eq(2)" bind:class.s3="nodes | item(2) | item(state) | eq(3)" bind:class.s4="nodes | item(2) | item(state) | eq(4)">
            <div id="pipe-2" class="pipe"/>
            <div id="nk-2">
              <div id="nk-2-0" class="kicker nk nk-0">@UI_NODE_NORMAL</div>
              <div id="nk-2-1" class="kicker nk nk-1">@UI_NODE_LIT</div>
              <div id="nk-2-2" class="kicker nk nk-2">@UI_NODE_FRAGILE</div>
              <div id="nk-2-3" class="kicker nk nk-3">@UI_NODE_SECOND</div>
            </div>
            <div id="lit-2" class="lit-mark">
              <svg id="lit-2-art" viewBox="0 0 14 14">
                <path id="Tri" d="M1 2 H13 L7 12 Z" fill="#f3eedf"/>
              </svg>
            </div>
            <div id="node-2-t" class="node-text" bind:text="nodes | item(2) | item(text)">新機芯是這家店的零件</div>
            <div id="node-2-src" class="node-src" bind:display="nodes | item(2) | item(src) | ne('')">@UI_NODE_STURDY_SRC</div>
            <svg id="crack-2" class="crack" viewBox="0 0 40 40">
              <path id="Crack" d="M38 2 L28 12 L32 18 L20 26 L24 32 L12 38" fill="none" stroke="#b8322a" stroke-width="2"/>
            </svg>
            <div id="strike-2" class="strike s-b7ad68"/>
          </div>
          <div id="node-3" class="node" on:click(left)="if port(phase) eq 0 set(target, port(nodes) | item(3) | item(id))" bind:display="nodes | item(3) | item(id) | ne('')" bind:class.s0="nodes | item(3) | item(state) | eq(0)" bind:class.s1="nodes | item(3) | item(state) | eq(1)" bind:class.s2="nodes | item(3) | item(state) | eq(2)" bind:class.s3="nodes | item(3) | item(state) | eq(3)" bind:class.s4="nodes | item(3) | item(state) | eq(4)">
            <div id="pipe-3" class="pipe"/>
            <div id="nk-3">
              <div id="nk-3-0" class="kicker nk nk-0">@UI_NODE_NORMAL</div>
              <div id="nk-3-1" class="kicker nk nk-1">@UI_NODE_LIT</div>
              <div id="nk-3-2" class="kicker nk nk-2">@UI_NODE_FRAGILE</div>
              <div id="nk-3-3" class="kicker nk nk-3">@UI_NODE_SECOND</div>
            </div>
            <div id="lit-3" class="lit-mark">
              <svg id="lit-3-art" viewBox="0 0 14 14">
                <path id="Tri" d="M1 2 H13 L7 12 Z" fill="#f3eedf"/>
              </svg>
            </div>
            <div id="node-3-t" class="node-text" bind:text="nodes | item(3) | item(text)"/>
            <div id="node-3-src" class="node-src" bind:display="nodes | item(3) | item(src) | ne('')">@UI_NODE_STURDY_SRC</div>
            <svg id="crack-3" class="crack" viewBox="0 0 40 40">
              <path id="Crack" d="M38 2 L28 12 L32 18 L20 26 L24 32 L12 38" fill="none" stroke="#b8322a" stroke-width="2"/>
            </svg>
            <div id="strike-3" class="strike s-b7ad68"/>
          </div>
          <div id="node-4" class="node" on:click(left)="if port(phase) eq 0 set(target, port(nodes) | item(4) | item(id))" bind:display="nodes | item(4) | item(id) | ne('')" bind:class.s0="nodes | item(4) | item(state) | eq(0)" bind:class.s1="nodes | item(4) | item(state) | eq(1)" bind:class.s2="nodes | item(4) | item(state) | eq(2)" bind:class.s3="nodes | item(4) | item(state) | eq(3)" bind:class.s4="nodes | item(4) | item(state) | eq(4)">
            <div id="pipe-4" class="pipe"/>
            <div id="nk-4">
              <div id="nk-4-0" class="kicker nk nk-0">@UI_NODE_NORMAL</div>
              <div id="nk-4-1" class="kicker nk nk-1">@UI_NODE_LIT</div>
              <div id="nk-4-2" class="kicker nk nk-2">@UI_NODE_FRAGILE</div>
              <div id="nk-4-3" class="kicker nk nk-3">@UI_NODE_SECOND</div>
            </div>
            <div id="lit-4" class="lit-mark">
              <svg id="lit-4-art" viewBox="0 0 14 14">
                <path id="Tri" d="M1 2 H13 L7 12 Z" fill="#f3eedf"/>
              </svg>
            </div>
            <div id="node-4-t" class="node-text" bind:text="nodes | item(4) | item(text)"/>
            <div id="node-4-src" class="node-src" bind:display="nodes | item(4) | item(src) | ne('')">@UI_NODE_STURDY_SRC</div>
            <svg id="crack-4" class="crack" viewBox="0 0 40 40">
              <path id="Crack" d="M38 2 L28 12 L32 18 L20 26 L24 32 L12 38" fill="none" stroke="#b8322a" stroke-width="2"/>
            </svg>
            <div id="strike-4" class="strike s-b7ad68"/>
          </div>
        </div>
        <div id="claim-preview" class="kicker" bind:text="claim_preview" bind:display="claim_preview | ne('')">主張 26＋4×3＝38</div>
        <div id="picker" class="sheet-paper" bind:display="parry_cards | item(0) | item(id) | ne('')">
          <div id="picker-k" class="kicker" bind:display="picker_title | eq('')">@MSG_DEB_SELECT_PARRY</div>
          <div id="picker-k2" class="kicker" bind:text="picker_title" bind:display="picker_title | ne('')">臨場硬接</div>
          <div id="picker-scroll">
            <repeat id="picker-list" port="parry_cards">
              <div id="pick" class="pick" on:click(left)="if port(phase) eq 0 set(card, item(id))">
                <div id="pick-id" class="pick-id" bind:text="item(id)">E02_02</div>
                <div id="pick-t" class="pick-t" bind:text="item(name)">報時鳥鐘</div>
              </div>
            </repeat>
          </div>
        </div>
        <div id="preview" class="sheet-paper" bind:display="preview | ne('')">
          <div id="preview-k" class="kicker">@UI_DEB_PREVIEW_LABEL</div>
          <div id="preview-t" class="preview-t" bind:text="preview">截斷：反擊 30、粉碎主張</div>
          <div id="preview-vs" class="preview-vs" bind:text="preview_vs" bind:display="preview_vs | ne('')">若主張：等一下！（反擊 30）　若猛攻：等一下！（反擊 30）</div>
          <div id="btn-improv" class="bbtn" on:click(left)="if port(phase) eq 0 emit(improv)" bind:display="improv_ok">
            <div id="improv-t" class="bbtn-t">@BTN_DEB_SOPH_NEW</div>
          </div>
        </div>
        <div id="tell" class="tell sheet-paper s-e35e37" bind:class.c0="tell_clarity | eq(0)" bind:class.c1="tell_clarity | eq(1)" bind:class.c2="tell_clarity | eq(2)">
          <div id="tell-head" class="col-head">@UI_DEB_GOSSIP</div>
          <div id="btn-instinct" class="bbtn" on:click(left)="if port(phase) eq 0 and port(instinct_ok) eq true emit(instinct); if port(phase) eq 0 and port(instinct_ok) eq true play(vignette)" bind:class.off="instinct_ok | not">
            <div id="instinct-t" class="bbtn-t s-2a083a">@BTN_DEB_INSTINCT</div>
            <div id="instinct-l1" class="lamp" bind:class.on="instinct_left | ge(1)"/>
            <div id="instinct-l2" class="lamp" bind:class.on="instinct_left | ge(2)"/>
          </div>
          <div id="tell-rule"/>
          <div id="tell-bubble" class="bubble" bind:display="tell_line | ne('')">
            <div id="tell-q-zh" class="tell-line q-zh" bind:text="format('「{0}」', tell_line)">「小人記得清清楚楚，報時鳥一叫我就走了。」</div>
            <div id="tell-q-en" class="tell-line q-en" bind:text="format('“{0}”', tell_line)">“I remember it clearly.”</div>
            <div id="tell-tail"/>
          </div>
          <div id="tell-gesture" bind:display="tell_gesture | ne('')">
            <svg id="gesture-ico" viewBox="0 0 16 16">
              <path id="Hand" d="M3 9 V5 M6 8 V3 M9 8 V3 M12 8 V5 M3 9 C3 13 6 15 9 15 C12 15 13 12 13 9 V5" fill="none" stroke="#a65432" stroke-width="1.5"/>
            </svg>
            <div id="tell-gesture-t" class="gesture" bind:text="tell_gesture">拉袖口、鞠躬</div>
          </div>
          <div id="tell-clar">
            <svg id="eye-0" bind:display="tell_clarity | eq(0)" viewBox="0 0 30 20">
              <path id="Lid" d="M1 10 C7 1 23 1 29 10 C23 19 7 19 1 10 Z" fill="#f3eedf" stroke="#a65432" stroke-width="2"/>
              <circle id="Iris" cx="15" cy="10" r="5" fill="#a65432"/>
              <circle id="Pupil" cx="15" cy="10" r="2" fill="#092e28"/>
            </svg>
            <svg id="eye-1" bind:display="tell_clarity | eq(1)" viewBox="0 0 30 20">
              <path id="Lid" d="M1 10 C7 1 23 1 29 10 C23 19 7 19 1 10 Z" fill="#f3eedf" stroke="#a65432" stroke-width="2"/>
              <circle id="Iris" cx="15" cy="12" r="5" fill="#a65432"/>
              <circle id="Pupil" cx="15" cy="12" r="2" fill="#092e28"/>
              <path id="Upper" d="M1 10 C7 1 23 1 29 10 Z" fill="#a65432"/>
            </svg>
            <svg id="eye-2" bind:display="tell_clarity | eq(2)" viewBox="0 0 30 20">
              <path id="Shackle" d="M10 9 V6 C10 1 20 1 20 6 V9" fill="none" stroke="#a65432" stroke-width="2.4"/>
              <rect id="Body" x="7" y="9" width="16" height="12" fill="#a65432"/>
              <circle id="Hole" cx="15" cy="15" r="2" fill="#092e28"/>
            </svg>
            <div id="clar-0" class="clar clar-0">@UI_DEB_TELL_CLEAR</div>
            <div id="clar-1" class="clar clar-1">@UI_DEB_TELL_FUZZY</div>
            <div id="clar-2" class="clar clar-2">@UI_DEB_TELL_SCRIPT</div>
            <div id="tell-basis" class="basis" bind:text="tell_basis" bind:display="tell_basis | ne('')">觀察</div>
          </div>
          <div id="tell-cands">
            <div id="cand-a" class="cand" bind:class.a0="tell_a | eq(0)" bind:class.a1="tell_a | eq(1)" bind:class.a2="tell_a | eq(2)" bind:class.a3="tell_a | eq(3)" bind:class.star="tell_star | eq(0)">
              <div id="cand-a-i0" class="ci ca-0">
                <svg id="cand-a-i0-art" viewBox="0 0 32 32">
                  <rect id="Sheet" x="6" y="4" width="20" height="24" fill="#f3eedf" stroke="#123a31" stroke-width="2"/>
                  <rect id="Head" x="9" y="8" width="14" height="4" fill="#123a31"/>
                  <path id="Lines" d="M9 16 H23 M9 20 H23 M9 24 H18" fill="none" stroke="#123a31" stroke-width="1.6"/>
                </svg>
              </div>
              <div id="cand-a-l0" class="cand-l ca-0">@UI_ACT_CLAIM</div>
              <div id="cand-a-i1" class="ci ca-1">
                <svg id="cand-a-i1-art" viewBox="0 0 32 32">
                  <path id="Chev" d="M5 8 L12 16 L5 24 M12 8 L19 16 L12 24 M19 8 L26 16 L19 24" fill="none" stroke="#b8322a" stroke-width="3" stroke-linejoin="round"/>
                </svg>
              </div>
              <div id="cand-a-l1" class="cand-l ca-1">@UI_ACT_RUSH</div>
              <div id="cand-a-i2" class="ci ca-2">
                <svg id="cand-a-i2-art" viewBox="0 0 32 32">
