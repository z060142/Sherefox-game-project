        </div>
        <div id="opp-gauge" class="gauge" bind:display="mode | eq(0)" bind:class.mid="hp_opp | range(0, hp_opp_max, 0, 1) | between(0.2, 0.5)" bind:class.low="hp_opp | range(0, hp_opp_max, 0, 1) | lt(0.2)" bind:class.shaken="st_shaken | gt(0)" bind:class.brk="st_break">
          <div id="go-ring" class="gring"/>
          <div id="go-wrap" class="dial-wrap">
            <svg id="go-dial" viewBox="0 0 156 156">
              <defs>
                <linearGradient id="go-brass" x1="0" y1="0" x2="156" y2="156" gradientUnits="userSpaceOnUse">
                  <stop offset="0" stop-color="#e3b36a"/>
                  <stop offset="0.45" stop-color="#a65432"/>
