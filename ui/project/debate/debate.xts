}

.tblock {
  background-gradient: linear-gradient(180deg, #2a4f45 0%, #123a31 45%, #092e28 100%);
  border: 1px #000000;
  effect: shadow(0px 2px 0px 0px #ffffff26 inset) shadow(0px -3px 0px 0px #00000066 inset) shadow(3px 3px 0px 0px #092e2880);
  transition: background-color 120ms linear;
}

.tblock:hover {
  background-gradient: linear-gradient(180deg, #c06a40 0%, #a65432 50%, #7a3e24 100%);
}

.tblock.on {
  background-gradient: linear-gradient(180deg, #ffffff 0%, #f3eedf 60%, #e3d9c2 100%);
  border: 2px #b8322a;
  effect: shadow(0px -5px 0px 0px #b8322a inset) shadow(0px 0px 12px 2px #b8322a99);
}

.tblock.off {
  background-gradient: linear-gradient(180deg, #7b8581 0%, #5b6662 100%);
}

.tblock.off:hover {
  background-gradient: linear-gradient(180deg, #7b8581 0%, #5b6662 100%);
}

.tb-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 21px;
  line-height: 30px;
  font-weight: 700;
  letter-spacing: 2px;
  color: var(--paper);
  text-align: center;
  white-space: nowrap;
  text-effect: shadow 0px -1px 0px #000000;
}

:lang(en) .tb-t {
  font-size: 17px;
  letter-spacing: 0px;
}

.tblock.on .tb-t {
  color: var(--ink-deep);
  text-effect: shadow 0px 1px 0px #ffffff;
}

.tblock.off .tb-t {
  color: #d7dbd6;
}

.tb-k {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 11px;
  line-height: 14px;
  color: #f3eedf99;
  text-align: center;
}

.tblock.on .tb-k {
  color: var(--vermilion);
}

.tb-r {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 11px;
  line-height: 13px;
  color: #fff3cf;
  text-align: center;
  line-clamp: 2;
}

.tblock.on .tb-r {
  color: var(--vermilion);
}

.divider {
  background-gradient: linear-gradient(90deg, #5e2c18 0%, #e3b36a 40%, #a65432 70%, #5e2c18 100%);
  border: 1px #3b1d10;
}

.rivet {
  border-radius: 3px;
  background-color: #3b1d10;
}

.acts.locked {
  opacity: 0.55;
}

.assist {
  background-color: #092e28d9;
  border: 1px #000000;
  transition: background-color 120ms linear;
}

.assist:hover {
  background-color: #123a31;
}

.assist.armed {
  border: 2px #e0a050;
  effect: shadow(0px 0px 12px 2px #e0a050aa);
}

.face {
  border-radius: 26px;
  border: 2px #a65432;
  background-color: var(--paper-old);
}

.assist.spent .face {
  effect: color-adjust(saturate(-1));
  opacity: 0.55;
}

.assist.armed .face {
  effect: color-adjust(saturate(0));
  opacity: 1;
  border-color: var(--lamp-gold);
}

.assist-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  line-height: 22px;
  font-weight: 700;
  color: var(--paper);
  white-space: nowrap;
}

.assist.armed .assist-t {
  color: var(--lamp-gold);
}

.status {
  background-color: #f3eedfeb;
  border-top-width: 3px;
  border-top-color: #123a31;
  border-bottom-width: 1px;
  border-bottom-color: #123a31;
  effect: shadow(3px 3px 0px 0px #092e2859);
}

.st-row {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 14px;
  line-height: 22px;
  font-weight: 700;
  color: var(--ink-deep);
  white-space: nowrap;
}

.st-brk {
  background-color: var(--vermilion);
  color: var(--paper);
}

.st-flags {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 12px;
  line-height: 17px;
  color: var(--ink);
  line-clamp: 3;
}

.dot {
  border-radius: 4px;
  background-color: var(--copper);
}

.tab {
  background-gradient: linear-gradient(180deg, #d79b55 0%, #a65432 60%, #7a3e24 100%);
  border: 1px #5e2c18;
  effect: shadow(2px 2px 0px 0px #092e2866);
  transition: background-color 120ms linear;
}

.tab:hover {
  background-gradient: linear-gradient(180deg, #e8b06a 0%, #c06a40 60%, #a65432 100%);
}

.tab-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 30px;
  letter-spacing: 1px;
  color: var(--paper);
  white-space: nowrap;
  text-align: center;
}

.tbl {
  background-color: var(--paper);
  border: 2px #123a31;
  effect: shadow(5px 5px 0px 0px #092e2880);
}

.th {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 28px;
  font-weight: 700;
  color: var(--paper);
  background-color: var(--ink);
  text-align: center;
  white-space: nowrap;
}

.th.lit-a, .th.lit-b {
  background-color: var(--vermilion);
}

.td {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 12px;
  line-height: 16px;
  color: var(--ink);
  background-color: #fbf8ef;
  border: 1px #123a3140;
}

.td.lit-a, .td.lit-b {
  background-color: #fff1d6;
  border-color: var(--lamp-gold);
}

.rh {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 14px;
  line-height: 18px;
  font-weight: 700;
  color: var(--ink-deep);
  background-color: var(--paper-old);
}

.trow.dim {
  opacity: 0.35;
}

.band {
  background-color: #092e28e6;
  border-top-width: 2px;
  border-top-color: #a65432;
  border-bottom-width: 2px;
  border-bottom-color: #a65432;
}

.rcard {
  background-color: var(--paper);
  border: 3px #c58a45;
  effect: shadow(0px 0px 0px 2px #5e2c18) shadow(6px 8px 0px 0px #00000080);
}

.rback {
  background-gradient: linear-gradient(45deg, #a65432 0%, #a65432 12.5%, #7a3e24 12.5%, #7a3e24 25%, #a65432 25%, #a65432 37.5%, #7a3e24 37.5%, #7a3e24 50%, #a65432 50%, #a65432 62.5%, #7a3e24 62.5%, #7a3e24 75%, #a65432 75%, #a65432 87.5%, #7a3e24 87.5%, #7a3e24 100%);
  border: 3px #e3b36a;
}

.rwho {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 12px;
  line-height: 18px;
  letter-spacing: 3px;
  color: var(--copper);
  text-align: center;
  white-space: nowrap;
}

.rname {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 26px;
  line-height: 34px;
  font-weight: 700;
  color: var(--ink-deep);
  text-align: center;
  white-space: nowrap;
}

:lang(en) .rname {
  font-size: 20px;
}

.rline {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 20px;
  line-height: 40px;
  color: var(--paper);
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
}

:lang(en) .rline {
  font-size: 17px;
}

.resline {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 22px;
  line-height: 40px;
  font-weight: 700;
  color: var(--paper);
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
  border-bottom-width: 3px;
  border-bottom-color: #b8322a;
}

:lang(en) .resline {
  font-size: 18px;
}

.clash-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 18px;
  line-height: 24px;
  font-weight: 700;
  color: var(--lamp-gold);
  text-align: center;
  white-space: nowrap;
}

.rcards.stale .rcard {
  opacity: 0.7;
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --lamp-gold: #e0a050;
  --paper: #f3eedf;
  --paper-old: #e3d9c2;
  --vermilion: #b8322a;
}

