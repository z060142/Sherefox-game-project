.veil {
  background-color: #092e28b3;
  color: var(--ink);
}

.band {
  background-color: #f3eedf;
  border-top-width: 4px;
  border-top-color: #123a31;
  border-bottom-width: 4px;
  border-bottom-color: #123a31;
  effect: shadow(0px 0px 0px 2px #f3eedf) shadow(0px 0px 40px 8px #00000080);
}

.band-rule {
  border-top-width: 1px;
  border-top-color: #123a31;
  color: var(--copper);
}

.big-img {
  object-fit: contain;
}

.big-txt {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 168px;
  line-height: 400px;
  font-weight: 700;
  color: #b8322a;
  text-align: center;
  white-space: nowrap;
  letter-spacing: 6px;
}

.big-sub {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 30px;
  line-height: 40px;
  font-weight: 700;
  letter-spacing: 10px;
  color: var(--paper);
  text-align: center;
  white-space: nowrap;
  text-transform: uppercase;
  text-effect: shadow 0px 2px 0px #092e28, shadow 0px 0px 6px #092e28;
}

.st-img {
  object-fit: contain;
}

.st-sub {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 22px;
  font-weight: 700;
  letter-spacing: 3px;
  color: #f3eedf;
