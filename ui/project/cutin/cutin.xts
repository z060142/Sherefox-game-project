  text-align: center;
  white-space: nowrap;
  text-transform: uppercase;
  border-bottom-width: 2px;
  border-bottom-color: #a65432;
}

.st-hk {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 64px;
  line-height: 120px;
  font-weight: 700;
  color: #2f6b3a;
  text-align: center;
  white-space: nowrap;
  border: 6px #2f6b3a;
