    }
    /* import: Cutin.dc.html:1/0/2/6 */
    #big-cut-reverse {
      height: 400px;
      left: 0px;
      position: absolute;
      top: 15px;
      width: 900px;
    }
    /* import: Cutin.dc.html:1/0/2/7 */
    #big-cut-double {
      height: 400px;
      left: 0px;
      position: absolute;
      top: 15px;
      width: 900px;
    }
    /* import: Cutin.dc.html:1/0/2/8 */
    #big-cut-counter {
      height: 400px;
      left: 0px;
      position: absolute;
      top: 15px;
      width: 900px;
    }
    /* import: Cutin.dc.html:1/0/3 */
    #big-sub {
      height: 40px;
      left: 140px;
      position: absolute;
      top: 566px;
      width: 1000px;
    }
    /* import: Cutin.dc.html:1/1 */
    #stamp-tr {
      anchor: right top;
      offset: 20px 18px;
      size: 168px 168px;
      transform-origin: 100% 0%;
    }
    /* import: Cutin.dc.html:1/1/0 */
    #st-stamp-parry {
      height: 168px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 168px;
    }
    /* import: Cutin.dc.html:1/1/0/0 */
    #st-stamp-parry-img {
      height: 168px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 168px;
    }
    /* import: Cutin.dc.html:1/1/1 */
    #st-stamp-clash {
      height: 168px;
      left: 0px;
      position: absolute;
      top: 0px;
