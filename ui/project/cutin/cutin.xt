  </layout>
  <style src="../shared/base.xts"/>
  <style src="cutin.xts"/>
  <timelines>
    @timeline big {
      #big-grp {
        0ms {
          opacity: 0;
        }
        120ms ease-out {
          opacity: 1;
        }
        1100ms {
          opacity: 1;
        }
        1500ms ease-in {
          opacity: 0;
        }
      }
      #band {
        0ms {
          transform: scaleY(0.2);
        }
        160ms ease-out {
          transform: scaleY(1);
        }
      }
      #big-art {
        0ms {
          opacity: 0;
          transform: translate(0px, 0px) scale(1.3);
          effect.blur.radiusX: 6px;
          effect.blur.radiusY: 6px;
        }
        420ms ease-out {
          opacity: 1;
          transform: translate(0px, 0px) scale(1);
          effect.blur.radiusX: 0px;
          effect.blur.radiusY: 0px;
        }
        450ms {
          transform: translate(-9px, 5px) scale(1);
        }
        480ms {
          transform: translate(8px, -6px) scale(1);
        }
        510ms {
          transform: translate(-6px, 3px) scale(1);
        }
        540ms {
          transform: translate(4px, -2px) scale(1);
        }
        580ms {
          transform: translate(0px, 0px) scale(1);
        }
        1100ms {
          opacity: 1;
          transform: translate(0px, 0px) scale(1);
          effect.blur.radiusX: 0px;
          effect.blur.radiusY: 0px;
        }
        1500ms ease-in {
          opacity: 0;
          transform: translate(0px, -8px) scale(1.05);
          effect.blur.radiusX: 5px;
          effect.blur.radiusY: 5px;
        }
      }
      #big-sub {
        0ms {
          opacity: 0;
        }
        620ms {
          opacity: 0;
        }
        820ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline ronpa {
      #big-grp {
        0ms {
          opacity: 0;
        }
        120ms ease-out {
          opacity: 1;
        }
        3500ms {
          opacity: 1;
        }
        4000ms ease-in {
          opacity: 0;
        }
      }
      #band {
        0ms {
          transform: scaleY(0.2);
        }
        160ms ease-out {
          transform: scaleY(1);
        }
        3500ms {
          transform: scaleY(1);
        }
        4000ms ease-in {
          transform: scaleY(0.9);
        }
      }
      #big-art {
        0ms {
          opacity: 0;
          transform: translate(0px, 0px) scale(1.45);
          effect.blur.radiusX: 8px;
          effect.blur.radiusY: 8px;
        }
        520ms ease-out {
          opacity: 1;
          transform: translate(0px, 0px) scale(1);
          effect.blur.radiusX: 0px;
          effect.blur.radiusY: 0px;
        }
        550ms {
          transform: translate(-9px, 5px) scale(1);
        }
        590ms {
          transform: translate(8px, -6px) scale(1);
        }
        630ms {
          transform: translate(-6px, 3px) scale(1);
        }
        670ms {
          transform: translate(4px, -2px) scale(1);
        }
        720ms {
          transform: translate(0px, 0px) scale(1);
        }
        3500ms {
          opacity: 1;
          transform: translate(0px, 0px) scale(1.03);
          effect.blur.radiusX: 0px;
          effect.blur.radiusY: 0px;
        }
        4000ms ease-in {
          opacity: 0;
          transform: translate(0px, -10px) scale(1.08);
          effect.blur.radiusX: 6px;
          effect.blur.radiusY: 6px;
        }
      }
      #big-sub {
        0ms {
          opacity: 0;
        }
        720ms {
          opacity: 0;
        }
        920ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline stamp {
      #stamp-tr {
        0ms {
          opacity: 0;
          transform: scale(1.9) rotate(-14deg);
        }
        150ms ease-in {
          opacity: 1;
          transform: scale(1) rotate(-6deg);
        }
        175ms ease-out {
          transform: scale(0.93) rotate(-6deg);
        }
        210ms ease-out {
          transform: scale(1) rotate(-6deg);
        }
        500ms {
          opacity: 1;
          transform: scale(1) rotate(-6deg);
        }
        700ms ease-in-out {
          transform: scale(0.55) rotate(-6deg);
        }
        2700ms {
          opacity: 1;
        }
        3100ms ease-in {
          opacity: 0;
        }
      }
      #stamp-tr-sub {
        0ms {
          opacity: 0;
        }
        150ms {
          opacity: 0;
        }
        260ms ease-out {
          opacity: 1;
        }
        520ms {
          opacity: 1;
        }
        680ms ease-in {
          opacity: 0;
        }
      }
      #stamp-bl {
        0ms {
          opacity: 0;
          transform: scale(1.9) rotate(-14deg);
        }
        150ms ease-in {
          opacity: 1;
          transform: scale(1) rotate(-6deg);
        }
        175ms ease-out {
          transform: scale(0.93) rotate(-6deg);
        }
        210ms ease-out {
          transform: scale(1) rotate(-6deg);
        }
        500ms {
          opacity: 1;
          transform: scale(1) rotate(-6deg);
        }
        700ms ease-in-out {
          transform: scale(0.55) rotate(-6deg);
        }
        2700ms {
          opacity: 1;
        }
        3100ms ease-in {
          opacity: 0;
        }
      }
      #stamp-bl-sub {
        0ms {
          opacity: 0;
        }
        150ms {
          opacity: 0;
        }
        260ms ease-out {
          opacity: 1;
        }
        520ms {
          opacity: 1;
        }
        680ms ease-in {
          opacity: 0;
        }
      }
    }
  </timelines>
</xt>
