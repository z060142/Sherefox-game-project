<xt version="2">
  <head>
    <title>Cutin</title>
  </head>

  <ports>
    big: string in = "CUT_RONPA"
    big_seq: number in = 0
    stamp: string in = "STAMP_PARRY"
    stamp_seq: number in = 0
    stamp_n: number in = 1
    subtitle: string in = ""
    done: event out
  </ports>

  <body>
    <div id="cutin" on:port(big_seq)="if port(big) eq 'CUT_RONPA' play(ronpa) else play(big)" on:port(stamp_seq)="play(stamp)" on:timeline(big).end="emit(done)" on:timeline(ronpa).end="emit(done)">
      <div id="big-grp">
        <div id="veil" class="veil"/>
        <div id="band" class="band">
          <div id="band-r1" class="band-rule"/>
          <div id="band-r2" class="band-rule"/>
        </div>
        <div id="big-art">
          <img id="big-cut-ronpa" class="big-img" src="../shared/img/big-cut-ronpa.png" bind:display="big | eq('CUT_RONPA')"/>
          <img id="big-cut-shaken" class="big-img" src="../shared/img/big-cut-shaken.png" bind:display="big | eq('CUT_SHAKEN')"/>
          <img id="big-cut-hachiku3" class="big-img" src="../shared/img/big-cut-hachiku3.png" bind:display="big | eq('CUT_HACHIKU3')"/>
          <img id="big-cut-konju" class="big-img" src="../shared/img/big-cut-konju.png" bind:display="big | eq('CUT_KONJU')"/>
          <img id="big-cut-shisshu" class="big-img" src="../shared/img/big-cut-shisshu.png" bind:display="big | eq('CUT_SHISSHU')"/>
          <div id="big-cut-brink" class="big-txt" bind:display="big | eq('CUT_BRINK')">@CUT_BRINK</div>
          <div id="big-cut-reverse" class="big-txt" bind:display="big | eq('CUT_REVERSE')">@CUT_REVERSE</div>
          <div id="big-cut-double" class="big-txt" bind:display="big | eq('CUT_DOUBLE')">@CUT_DOUBLE</div>
          <div id="big-cut-counter" class="big-txt" bind:display="big | eq('CUT_COUNTER')">@CUT_COUNTER</div>
        </div>
        <div id="big-sub" class="big-sub" bind:text="subtitle" bind:display="subtitle | ne('')">BREAK</div>
      </div>
      <div id="stamp-tr">
        <div id="st-stamp-parry" bind:display="stamp | eq('STAMP_PARRY')">
          <img id="st-stamp-parry-img" class="st-img" src="../shared/img/st-stamp-parry-img.png"/>
        </div>
        <div id="st-stamp-clash" bind:display="stamp | eq('STAMP_CLASH')">
          <img id="st-stamp-clash-img" class="st-img" src="../shared/img/st-stamp-clash-img.png"/>
        </div>
        <div id="st-stamp-seen" bind:display="stamp | eq('STAMP_SEEN')">
          <img id="st-stamp-seen-img" class="st-img" src="../shared/img/st-stamp-seen-img.png"/>
        </div>
      </div>
      <div id="stamp-tr-sub">
        <div id="sts-stamp-parry" class="st-sub" bind:text="subtitle" bind:display="stamp | eq('STAMP_PARRY')">CUT IN</div>
        <div id="sts-stamp-clash" class="st-sub" bind:text="subtitle" bind:display="stamp | eq('STAMP_CLASH')">CUT IN</div>
        <div id="sts-stamp-seen" class="st-sub" bind:text="subtitle" bind:display="stamp | eq('STAMP_SEEN')">CUT IN</div>
      </div>
      <div id="stamp-bl">
        <div id="st-stamp-trap" bind:display="stamp | eq('STAMP_TRAP')">
          <img id="st-stamp-trap-img" class="st-img" src="../shared/img/st-stamp-trap-img.png"/>
        </div>
        <div id="st-stamp-whiff" bind:display="stamp | eq('STAMP_WHIFF')">
          <img id="st-stamp-whiff-img" class="st-img" src="../shared/img/st-stamp-whiff-img.png"/>
        </div>
        <div id="st-stamp-assist" bind:display="stamp | eq('STAMP_ASSIST')">
          <img id="st-stamp-assist-img" class="st-img" src="../shared/img/st-stamp-assist-img.png"/>
        </div>
        <div id="st-stamp-hachiku-lost" bind:display="stamp | eq('STAMP_HACHIKU_LOST')">
          <img id="st-stamp-hachiku-lost-img" class="st-img" src="../shared/img/st-stamp-hachiku-lost-img.png"/>
        </div>
        <div id="st-stamp-hachiku" bind:display="stamp | eq('STAMP_HACHIKU')">
          <div id="st-hk-seal" class="st-hk">@STAMP_HACHIKU</div>
          <div id="st-hk-n" class="st-hk-n" bind:text="format('×{0}', stamp_n)">×1</div>
        </div>
      </div>
      <div id="stamp-bl-sub">
        <div id="sts-stamp-trap" class="st-sub" bind:text="subtitle" bind:display="stamp | eq('STAMP_TRAP')">CUT IN</div>
        <div id="sts-stamp-whiff" class="st-sub" bind:text="subtitle" bind:display="stamp | eq('STAMP_WHIFF')">CUT IN</div>
        <div id="sts-stamp-assist" class="st-sub" bind:text="subtitle" bind:display="stamp | eq('STAMP_ASSIST')">CUT IN</div>
        <div id="sts-stamp-hachiku-lost" class="st-sub" bind:text="subtitle" bind:display="stamp | eq('STAMP_HACHIKU_LOST')">CUT IN</div>
        <div id="sts-stamp-hachiku" class="st-sub" bind:text="subtitle" bind:display="stamp | eq('STAMP_HACHIKU')">UNSTOPPABLE ×1</div>
      </div>
    </div>
  </body>

  <layout>
    /* import: Cutin.dc.html:1 */
    #cutin {
      height: 100vh;
      margin-bottom: 0;
      margin-left: 0;
      margin-right: 0;
      margin-top: 0;
      overflow: hidden;
      position: relative;
      width: 100vw;
    }
    /* import: Cutin.dc.html:1/0 */
    #big-grp {
      anchor: stretch stretch screen;
    }
    /* import: Cutin.dc.html:1/0/0 */
    #veil {
      height: 720px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 1280px;
    }
    /* import: Cutin.dc.html:1/0/1 */
    #band {
      height: 380px;
      left: -20px;
      position: absolute;
      top: 170px;
      width: 1320px;
    }
    /* import: Cutin.dc.html:1/0/1/0 */
    #band-r1 {
      height: 1px;
      left: 20px;
