    #st-stamp-seen-img {
      height: 168px;
      left: 0px;
      position: absolute;
      top: 0px;
      width: 168px;
    }
    /* import: Cutin.dc.html:1/2 */
    #stamp-tr-sub {
      anchor: right top;
      offset: 20px 18px;
      size: 168px 200px;
    }
    /* import: Cutin.dc.html:1/2/0 */
    #sts-stamp-parry {
      height: 22px;
      left: 0px;
      position: absolute;
      top: 168px;
      width: 168px;
    }
    /* import: Cutin.dc.html:1/2/1 */
    #sts-stamp-clash {
      height: 22px;
      left: 0px;
      position: absolute;
      top: 168px;
      width: 168px;
    }
