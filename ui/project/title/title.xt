<xt version="2">
  <head>
    <title>Title</title>
  </head>

  <ports>
    chapter: number out = 0
    lang_toggle: event out
    lang_en: bool in = false
    ended: bool in = false
    end_dismiss: event out
    open_settings: event out
    quit: event out
  </ports>

  <body on:show="play(intro)">
    <div id="title">
      <div id="kicker" class="kicker">@UI_TITLE_KICKER</div>
      <div id="lang-toggle" tabindex="0" on:click="emit(lang_toggle)">
        <div id="lang-label" class="kicker">@UI_TITLE_LANG</div>
        <div id="lang-switch">
          <div id="lang-zh" class="lang-opt active" bind:class.active="lang_en | not">@UI_TITLE_LANG_ZH</div>
          <div id="lang-en" class="lang-opt" bind:class.active="lang_en">@UI_TITLE_LANG_EN</div>
        </div>
      </div>
      <div id="rule-top" class="rule-copper"/>
      <div id="mast-dock">
        <div id="masthead">
          <img id="masthead-art" class="s-b00406" src="../shared/img/masthead-art.png"/>
        </div>
        <svg id="mast-tick" viewBox="0 0 96 64">
          <path id="Stroke" d="M6 34 C14 38 22 46 30 56 C44 34 62 16 90 6" fill="none" stroke="#b8322a" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" path-trim="0 1"/>
        </svg>
      </div>
      <div id="rule-mast-thick" class="rule-thick"/>
      <div id="rule-mast-thin" class="rule-thin"/>
      <div id="paper-name">@UI_PAPER_MAST</div>
      <div id="rule-name" class="rule-thin"/>
      <div id="lead">
        <div id="lead-kicker" class="kicker">@UI_TITLE_LEAD</div>
        <h1 id="lead-headline">@UI_TITLE_LOGO</h1>
        <div id="lead-rule" class="rule-thin"/>
        <p id="lead-deck">@UI_TITLE_SUB</p>
      </div>
      <div id="rule-column" class="rule-thin"/>
      <div id="contents">
        <div id="contents-heading" class="kicker s-7ee933">@UI_TITLE_CONTENTS</div>
        <div id="btn-ch1" class="entry" tabindex="0" on:click="set(chapter, 1)">
          <div id="btn-ch1-no" class="entry-no">Ch.1</div>
          <div id="btn-ch1-title" class="entry-title">@CHAP_01_TITLE</div>
        </div>
        <div id="btn-ch2" class="entry" tabindex="0" on:click="set(chapter, 2)">
          <div id="btn-ch2-no" class="entry-no">Ch.2</div>
          <div id="btn-ch2-title" class="entry-title">@CHAP_02_TITLE</div>
        </div>
        <div id="btn-ch3" class="entry" tabindex="0" on:click="set(chapter, 3)">
          <div id="btn-ch3-no" class="entry-no">Ch.3</div>
          <div id="btn-ch3-title" class="entry-title">@CHAP_03_TITLE</div>
        </div>
        <div id="contents-foot">
          <div id="btn-settings" class="entry-sm" tabindex="0" on:click="emit(open_settings)">@BTN_SETTINGS</div>
          <div id="btn-quit" class="entry-sm" tabindex="0" on:click="emit(quit)">@BTN_QUIT</div>
        </div>
      </div>
      <div id="rule-foot" class="rule-copper"/>
      <div id="end-card" class="end-card" tabindex="0" on:port(ended)="play(end-in); focus()" on:click="emit(end_dismiss)" bind:display="ended">
        <div id="end-dock">
          <div id="end-mast">
            <img id="end-mast-art" class="s-b00406" src="../shared/img/masthead-art.png"/>
          </div>
          <div id="end-rule-a" class="rule-thick"/>
          <div id="end-rule-b" class="rule-thin"/>
          <div id="end-text" class="end-text">@UI_TO_BE_CONTINUED</div>
          <div id="end-rule-c" class="rule-thin"/>
          <div id="end-rule-d" class="rule-thick"/>
          <div id="end-name" class="end-kicker">@UI_TITLE_LOGO</div>
        </div>
      </div>
    </div>
  </body>

  <layout>
    /* import: Title.dc.html:1 */
    #title {
      height: 100vh;
      margin-bottom: 0;
      margin-left: 0;
      margin-right: 0;
      margin-top: 0;
      overflow: hidden;
      position: relative;
      width: 100vw;
    }
    /* import: Title.dc.html:1/0 */
    #kicker {
      anchor: left top;
      offset: 16px -2px;
      size: 520px 20px;
    }
    /* import: Title.dc.html:1/1 */
    #lang-toggle {
      align-items: center;
      anchor: right top;
      display: flex;
      flex-direction: row;
      gap: 8px;
      offset: 16px -8px;
      size: 320px 30px;
    }
    /* import: Title.dc.html:1/1/0 */
    #lang-label {
      flex-shrink: 0;
      height: 20px;
      width: 156px;
    }
    /* import: Title.dc.html:1/1/1 */
    #lang-switch {
      display: flex;
      flex-direction: row;
      flex-shrink: 0;
      gap: 0px;
      height: 30px;
      padding-bottom: 1px;
      padding-left: 1px;
      padding-right: 1px;
      padding-top: 1px;
      width: 156px;
    }
    /* import: Title.dc.html:1/2 */
    #rule-top {
      anchor: left top;
      offset: 16px 28px;
      size: 1184px 1px;
    }
    /* import: Title.dc.html:1/3 */
    #mast-dock {
      anchor: left top;
      offset: 208px 34px;
      size: 800px 172px;
    }
    /* import: Title.dc.html:1/3/0 */
    #masthead {
      height: 172px;
      left: 20px;
      overflow: hidden;
      position: absolute;
      top: 0px;
      width: 760px;
    }
    /* import: Title.dc.html:1/3/0/0 */
    #masthead-art {
      height: 253px;
      left: 0px;
      position: absolute;
      top: -34px;
      width: 760px;
    }
    /* import: Title.dc.html:1/3/1 */
    #mast-tick {
      height: 64px;
      left: 744px;
      position: absolute;
      top: 22px;
      width: 96px;
    }
    /* import: Title.dc.html:1/4 */
    #rule-mast-thick {
      height: 3px;
      left: calc(1safe-left + 16px);
      position: absolute;
      top: calc(32.08% - 0.96px);
      width: 1184px;
    }
    /* import: Title.dc.html:1/5 */
    #rule-mast-thin {
      height: 1px;
      left: calc(1safe-left + 16px);
      position: absolute;
      top: calc(32.82% - 0.33px);
      width: 1184px;
    }
    /* import: Title.dc.html:1/6 */
    #paper-name {
      height: 28px;
      left: calc(50% - 300px);
      position: absolute;
      top: calc(34.97% - 9.79px);
      width: 600px;
    }
    /* import: Title.dc.html:1/7 */
    #rule-name {
      height: 1px;
      left: calc(1safe-left + 16px);
      position: absolute;
      top: calc(38.11% - 0.38px);
      width: 1184px;
    }
    /* import: Title.dc.html:1/8 */
    #lead {
      anchor: left bottom;
      display: flex;
      flex-direction: column;
      gap: 12px;
      offset: 16px 22px;
      size: 712px 380px;
    }
    /* import: Title.dc.html:1/8/0 */
    #lead-kicker {
      flex-shrink: 0;
      height: 20px;
      width: 712px;
    }
    /* import: Title.dc.html:1/8/1 */
    #lead-headline {
      flex-shrink: 0;
      height: 168px;
      margin-bottom: 0px;
      margin-left: 0px;
      margin-right: 0px;
      margin-top: 0px;
      width: 712px;
    }
    /* import: Title.dc.html:1/8/2 */
    #lead-rule {
      flex-shrink: 0;
      height: 1px;
      width: 712px;
    }
    /* import: Title.dc.html:1/8/3 */
    #lead-deck {
      flex-shrink: 0;
      height: 40px;
      margin-bottom: 0px;
      margin-left: 0px;
      margin-right: 0px;
      margin-top: 0px;
      width: 712px;
    }
    /* import: Title.dc.html:1/9 */
    #rule-column {
      bottom: calc(1safe-bottom + 18px);
      height: 384px;
      left: calc(61.92% - 0.62px);
      position: absolute;
      width: 1px;
    }
    /* import: Title.dc.html:1/10 */
    #contents {
      anchor: right bottom;
      display: flex;
      flex-direction: column;
      gap: 0px;
      offset: 16px 18px;
      size: 408px 384px;
    }
    /* import: Title.dc.html:1/10/0 */
    #contents-heading {
      flex-shrink: 0;
      height: 28px;
      width: 408px;
    }
    /* import: Title.dc.html:1/10/1 */
    #btn-ch1 {
      flex-shrink: 0;
    }
    /* import: Title.dc.html:1/10/1/0 */
    #btn-ch1-no {
      flex-shrink: 0;
      height: 22px;
      width: 376px;
    }
    /* import: Title.dc.html:1/10/1/1 */
    #btn-ch1-title {
      flex-shrink: 0;
      width: 376px;
    }
    /* import: Title.dc.html:1/10/2 */
    #btn-ch2 {
      flex-shrink: 0;
    }
    /* import: Title.dc.html:1/10/2/0 */
    #btn-ch2-no {
      flex-shrink: 0;
      height: 22px;
      width: 376px;
    }
    /* import: Title.dc.html:1/10/2/1 */
    #btn-ch2-title {
      flex-shrink: 0;
      width: 376px;
    }
    /* import: Title.dc.html:1/10/3 */
    #btn-ch3 {
      flex-shrink: 0;
    }
    /* import: Title.dc.html:1/10/3/0 */
    #btn-ch3-no {
      flex-shrink: 0;
      height: 22px;
      width: 376px;
    }
    /* import: Title.dc.html:1/10/3/1 */
    #btn-ch3-title {
      flex-shrink: 0;
      width: 376px;
    }
    /* import: Title.dc.html:1/10/4 */
    #contents-foot {
      display: flex;
      flex-direction: row;
      flex-shrink: 0;
      gap: 8px;
      height: 56px;
      padding-bottom: 0px;
      padding-left: 0px;
      padding-right: 0px;
      padding-top: 12px;
      width: 408px;
    }
    /* import: Title.dc.html:1/11 */
    #rule-foot {
      anchor: left bottom;
      offset: 16px 9px;
      size: 1184px 1px;
    }
    /* import: Title.dc.html:1/12 */
    #end-card {
      anchor: stretch stretch screen;
    }
    /* import: Title.dc.html:1/12/0 */
    #end-dock {
      height: 720px;
      left: calc(50% - 640px);
      position: absolute;
      top: calc(50% - 360px);
      width: 1280px;
    }
    /* import: Title.dc.html:1/12/0/0 */
    #end-mast {
      height: 136px;
      left: 340px;
      overflow: hidden;
      position: absolute;
      top: 96px;
      width: 600px;
    }
    /* import: Title.dc.html:1/12/0/0/0 */
    #end-mast-art {
      height: 200px;
      left: 0px;
      position: absolute;
      top: -27px;
      width: 600px;
    }
    /* import: Title.dc.html:1/12/0/1 */
    #end-rule-a {
      height: 3px;
      left: 240px;
      position: absolute;
      top: 252px;
      width: 800px;
    }
    /* import: Title.dc.html:1/12/0/2 */
    #end-rule-b {
      height: 1px;
      left: 240px;
      position: absolute;
      top: 258px;
      width: 800px;
    }
    /* import: Title.dc.html:1/12/0/3 */
    #end-text {
      height: 160px;
      left: 240px;
      position: absolute;
      top: 284px;
      width: 800px;
    }
    /* import: Title.dc.html:1/12/0/4 */
    #end-rule-c {
      height: 1px;
      left: 240px;
      position: absolute;
      top: 470px;
      width: 800px;
    }
    /* import: Title.dc.html:1/12/0/5 */
    #end-rule-d {
      height: 3px;
      left: 240px;
      position: absolute;
      top: 474px;
      width: 800px;
    }
    /* import: Title.dc.html:1/12/0/6 */
    #end-name {
      height: 28px;
      left: 340px;
      position: absolute;
      top: 494px;
      width: 600px;
    }
    .lang-opt {
      width: 76px;
      height: 26px;
      flex-shrink: 0;
    }
    .entry {
      width: 408px;
      height: 100px;
      padding-top: 9px;
      padding-right: 16px;
      padding-bottom: 9px;
      padding-left: 16px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2px;
    }
    .entry-sm {
      width: 200px;
      height: 44px;
      flex-shrink: 0;
    }
  </layout>
  <style src="../shared/base.xts"/>
  <style src="title.xts"/>
  <timelines>
    @timeline end-in {
      #end-card {
        0ms {
          opacity: 0;
        }
        500ms ease-out {
          opacity: 1;
        }
      }
      #end-text {
        0ms {
          opacity: 0;
          transform: scale(1.12);
        }
        250ms {
          opacity: 0;
          transform: scale(1.12);
        }
        800ms ease-out {
          opacity: 1;
          transform: scale(1);
        }
      }
      #end-name {
        0ms {
          opacity: 0;
        }
        700ms {
          opacity: 0;
        }
        1100ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline intro {
      #masthead {
        0ms {
          opacity: 0;
        }
        400ms ease-out {
          opacity: 1;
        }
      }
      #mast-tick/Stroke {
        0ms {
          path-trim-end: 0;
        }
        300ms {
          path-trim-end: 0;
        }
        700ms ease-out {
          path-trim-end: 1;
        }
      }
      #lead {
        0ms {
          opacity: 0;
        }
        150ms {
          opacity: 0;
        }
        450ms ease-out {
          opacity: 1;
        }
      }
      #contents {
        0ms {
          opacity: 0;
        }
        250ms {
          opacity: 0;
        }
        550ms ease-out {
          opacity: 1;
        }
      }
    }
  </timelines>
</xt>
