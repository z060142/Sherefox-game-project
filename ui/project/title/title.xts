/* Generated by xtframe-import from "Title". Edits are kept on re-import; see import-report.json. */

/* import: Title.dc.html:1 */
#title {
  background-color: #f3eedf;
  background-color: var(--paper);
  color: var(--ink);
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

/* import: Title.dc.html:1/1/1 */
#lang-switch {
  background-color: var(--paper);
  border: 1px #123a31;
}

/* import: Title.dc.html:1/6 */
#paper-name {
  color: var(--ink);
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  letter-spacing: 4px;
  line-height: 28px;
  text-align: center;
}

/* import: Title.dc.html:1/8/1 */
#lead-headline {
  color: var(--ink-deep);
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 140px;
  font-weight: 700;
  letter-spacing: 6px;
  line-height: 168px;
}

/* import: Title.dc.html:1/8/3 */
#lead-deck {
  color: var(--ink);
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 28px;
  line-height: 40px;
}

.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
}

.rule-thin {
  background-color: var(--ink);
}

.rule-thick {
  background-color: var(--ink);
}

.rule-copper {
  background-color: var(--copper);
}

.lang-opt {
  line-height: 26px;
  text-align: center;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  letter-spacing: 1px;
  color: var(--ink);
  background-color: var(--paper);
}

.lang-opt.active {
  color: var(--paper);
  background-color: var(--ink);
}

.entry {
  text-align: left;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 20px;
  line-height: 28px;
  font-weight: 400;
  color: var(--ink);
  background-color: var(--paper);
  border: 0px #123a31;
  border-bottom-width: 1px;
  border-bottom-color: #123a31;
  border-bottom-style: dashed;
  transition: background-color 150ms linear, color 150ms linear;
}

.entry:hover {
  color: var(--paper);
  background-color: var(--ink);
}

.entry:active {
  color: var(--ink);
  background-color: var(--paper-old);
}

.entry:focus {
  outline: 2px solid #a65432;
  outline-offset: -4px;
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --paper: #f3eedf;
  --paper-old: #e3d9c2;
}

