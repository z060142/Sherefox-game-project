/* Generated by xtframe-import from "Title". Edits are kept on re-import; see import-report.json. */

/* import: Title.dc.html:1 */
#title {
  background-color: #f3eedf;
  background-color: var(--paper);
  color: var(--ink);
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
}

/* import: Title.dc.html:1/1/0 */
#lang-label {
  text-align: right;
  white-space: nowrap;
}

/* import: Title.dc.html:1/1/1 */
#lang-switch {
  background-color: var(--paper);
  border: 1px #123a31;
}

/* import: Title.dc.html:1/6 */
#paper-name {
  color: var(--ink);
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  letter-spacing: 4px;
  line-height: 28px;
  text-align: center;
}

/* import: Title.dc.html:1/8/1 */
#lead-headline {
  color: var(--ink-deep);
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 140px;
  font-weight: 700;
  letter-spacing: 6px;
  line-height: 168px;
}

/* import: Title.dc.html:1/8/3 */
#lead-deck {
  color: var(--ink);
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 28px;
  line-height: 40px;
}

.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
}

.rule-thin {
  background-color: var(--ink);
}

.rule-thick {
  background-color: var(--ink);
}

.rule-copper {
  background-color: var(--copper);
}

.lang-opt {
  line-height: 26px;
  text-align: center;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  letter-spacing: 1px;
  color: var(--ink);
  background-color: var(--paper);
}

.lang-opt.active {
  color: var(--paper);
  background-color: var(--ink);
}

.entry {
  color: var(--ink);
  background-color: var(--paper);
  border: 0px #123a31;
  border-bottom-width: 1px;
  border-bottom-color: #123a31;
  border-bottom-style: dashed;
  transition: background-color 150ms linear;
}

.entry:hover {
  background-color: var(--ink);
}

.entry:active {
  background-color: var(--paper-old);
}

.entry:focus {
  outline: 2px solid #a65432;
  outline-offset: -4px;
}

.entry-no {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 22px;
  letter-spacing: 3px;
  color: var(--copper);
}

.entry-title {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 22px;
  line-height: 30px;
  font-weight: 400;
  color: var(--ink);
  line-clamp: 2;
}

.entry:hover .entry-no {
  color: var(--lamp-gold);
}

.entry:hover .entry-title {
  color: var(--paper);
}

.entry:active .entry-no {
  color: var(--copper);
}

.entry:active .entry-title {
  color: var(--ink);
}

.entry-sm {
  text-align: center;
  line-height: 42px;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  letter-spacing: 2px;
  color: var(--ink);
  background-color: var(--paper);
  border: 1px #123a31;
  white-space: nowrap;
  transition: background-color 150ms linear;
}

:lang(en) .entry-sm {
  letter-spacing: 1px;
}

.entry-sm:hover {
  color: var(--paper);
  background-color: var(--ink);
}

.entry-sm:active {
  color: var(--ink);
  background-color: var(--paper-old);
}

.entry-sm:focus {
  outline: 2px solid #a65432;
  outline-offset: -4px;
}

.end-card {
  background-gradient: radial-gradient(70.7107% 77.7817% at 50% 45%, #f3eedf 60%, #e3d9c2 100%);
}

.end-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 132px;
  line-height: 160px;
  font-weight: 700;
  letter-spacing: 24px;
  text-align: center;
  color: var(--ink-deep);
}

:lang(en) .end-text {
  font-size: 84px;
  letter-spacing: 6px;
}

.end-kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  line-height: 28px;
  letter-spacing: 6px;
  text-align: center;
  color: var(--ink);
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --lamp-gold: #e0a050;
  --paper: #f3eedf;
  --paper-old: #e3d9c2;
}

