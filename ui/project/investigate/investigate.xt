  <style src="investigate.xts"/>
  <timelines>
    @timeline bg-in {
      #bg-art {
        0ms {
          opacity: 0.35;
        }
        360ms ease-out {
          opacity: 1;
        }
      }
    }
    @timeline card-line-in {
      #card-line {
        0ms {
          opacity: 0;
          transform: translate(0px, 6px);
        }
        260ms ease-out {
          opacity: 1;
          transform: translate(0px, 0px);
        }
      }
    }
    @timeline fly {
      #pop-card {
        0ms {
          opacity: 1;
          transform: translate(0px, 0px) scale(1) rotate(0deg);
        }
        420ms ease-in {
          opacity: 0.3;
          transform: translate(380px, 300px) scale(0.16) rotate(-8deg);
        }
      }
    }
    @timeline hint-in {
      #hint-bubble {
        0ms {
          opacity: 0;
          transform: translateX(-8px);
        }
        240ms ease-out {
          opacity: 1;
          transform: translateX(0px);
        }
      }
    }
    @timeline info-line-in {
      #info-line {
        0ms {
          opacity: 0;
          transform: translate(0px, 6px);
        }
        260ms ease-out {
          opacity: 1;
          transform: translate(0px, 0px);
        }
      }
    }
    @timeline msg-in {
      #pop-msg {
        0ms {
          opacity: 0;
          transform: translate(0px, 16px) scale(1) rotate(0deg);
        }
        220ms ease-out {
          opacity: 1;
          transform: translate(0px, 0px) scale(1) rotate(0deg);
        }
      }
    }
    @timeline msg-line-in {
      #msg-line {
        0ms {
          opacity: 0;
          transform: translate(0px, 6px);
        }
        260ms ease-out {
          opacity: 1;
          transform: translate(0px, 0px);
        }
      }
    }
    @timeline pop-in {
      #pop-info {
        0ms {
          opacity: 0;
          transform: translate(0px, 16px) scale(1) rotate(0deg);
        }
        220ms ease-out {
          opacity: 1;
          transform: translate(0px, 0px) scale(1) rotate(0deg);
        }
      }
      #pop-card {
        0ms {
          opacity: 0;
          transform: translate(0px, 16px) scale(1) rotate(0deg);
        }
        220ms ease-out {
          opacity: 1;
          transform: translate(0px, 0px) scale(1) rotate(0deg);
        }
      }
    }
  </timelines>
</xt>
