}

/* import: Investigate.dc.html:1/6/5/4 */
#msg-close {
  color: #a65432;
  font-size: 13px;
  letter-spacing: 2px;
  line-height: 22px;
  text-align: right;
}

.bg-art {
  object-fit: cover;
}

.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
}

.badge {
  border: 2px #123a31;
  border-radius: 0px 0px 9px 9px;
  background-color: var(--paper);
}

.badge.on {
  background-color: var(--copper);
  border-color: var(--ink-deep);
}

.ring {
  opacity: 0;
  border: 2px #2e2f2dd9;
  border-radius: 50%;
  effect: shadow(0px 0px 22px 4px #e0a050a6);
  transition: opacity 140ms ease-out;
}

.ring2 {
  opacity: 0;
  border: 1px #2e2f2d99;
  border-radius: 50%;
  transition: opacity 140ms ease-out;
}

.spot:hover .ring2 {
  opacity: 1;
}

.spot.done .ring2 {
  opacity: 0.35;
  border-color: #e3d9c299;
}

.chip {
  opacity: 0;
  border-radius: 20px;
  background-color: #f3eedfeb;
  border: 2px #a65432;
  transition: opacity 140ms ease-out;
}

.spot-name {
  opacity: 0;
  text-align: center;
  white-space: nowrap;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 14px;
  line-height: 26px;
  color: var(--paper);
  background-color: #092e28d9;
  transition: opacity 140ms ease-out;
}

.spot:hover .ring {
  opacity: 1;
}

.spot:hover .chip {
  opacity: 1;
}

.spot:hover .spot-name {
  opacity: 1;
}

.spot.done .ring {
  opacity: 0.45;
  border-color: #e3d9c299;
  effect: shadow(0px 0px 0px 0px #e0a05000);
}

.spot.done .chip {
  opacity: 0.85;
  border-color: #5b6662;
  background-color: #e3d9c2d9;
  effect: color-adjust(saturate(-1));
}

.spot.done:hover .ring {
  opacity: 0.8;
}

.spot.locked .chip {
  opacity: 1;
  border-color: var(--vermilion);
}

.ico {
  object-fit: contain;
}

.ico-done {
  object-fit: contain;
  background-color: var(--paper);
  border-radius: 10px;
}

.hud-card {
  background-color: var(--paper);
  border-top-width: 3px;
  border-top-color: #123a31;
  border-bottom-width: 1px;
  border-bottom-color: #123a31;
  effect: shadow(3px 3px 0px 0px #092e2859);
}

.watch.limited.low .tick-num {
  color: var(--vermilion);
}

.tick-num {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 30px;
  line-height: 40px;
  color: var(--ink);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.tick-max {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  line-height: 40px;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.nav {
  text-align: center;
  line-height: 38px;
  font-size: 18px;
  color: var(--paper);
  background-color: var(--ink);
  border: 1px #092e28;
  transition: background-color 120ms linear;
}

.nav:hover {
  background-color: var(--copper);
}

.nav.off {
  background-color: #123a3166;
  color: #f3eedf66;
}

.btn {
  text-align: center;
  line-height: 42px;
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 16px;
  letter-spacing: 2px;
  color: var(--paper);
  background-color: var(--ink);
  border: 1px #092e28;
  effect: shadow(3px 3px 0px 0px #092e2866);
  transition: background-color 120ms linear;
}

.btn:hover {
  background-color: var(--copper);
}

.btn:active {
  background-color: var(--ink-deep);
}

.btn.paper {
  color: var(--ink);
  background-color: var(--paper);
  border-color: var(--ink);
}

.btn.paper:hover {
  color: var(--paper);
  background-color: var(--ink);
}

.btn.off {
  color: #f3eedf8c;
  background-color: #5b6662;
  border-color: #5b6662;
}

.btn.off:hover {
  background-color: #5b6662;
}

.bubble {
  background-color: var(--paper);
  border: 1px #123a31;
  border-left-width: 3px;
  border-left-color: #a65432;
  effect: shadow(3px 3px 0px 0px #092e2859);
}

.hint-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 17px;
  line-height: 26px;
  color: var(--ink);
}

.pop-kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  color: var(--copper);
}

.pop-title {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 26px;
  line-height: 34px;
  font-weight: 700;
  color: var(--ink-deep);
}

.pop-body {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 17px;
  line-height: 28px;
  color: var(--ink);
}

.clip {
  background-color: var(--paper);
  border: 4px #a65432;
  effect: shadow(6px 6px 0px 0px #092e2880);
}

.clip.g1 {
  border-color: #9ea7aa;
}

.clip.g2 {
  background-color: var(--paper-old);
  border-color: var(--ink-deep);
}

.clip.g3 {
  border-color: var(--lamp-gold);
  effect: shadow(0px 0px 24px 4px #e0a050b3);
}

.clip.g4 {
  background-color: var(--paper-old);
  border-style: dashed;
  border-color: var(--copper);
}

.clip-band {
  background-color: var(--copper);
}

.clip.g1 .clip-band {
  background-color: #9ea7aa;
}

.clip.g2 .clip-band {
  background-color: var(--ink-deep);
}

.clip.g3 .clip-band {
  background-color: var(--lamp-gold);
}

.clip.g4 .clip-band {
  background-color: #a6543299;
}

.pop-line {
  background-color: var(--paper-old);
  border-left-width: 3px;
  border-left-color: #a65432;
}

.pop-spk {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 18px;
  letter-spacing: 2px;
  font-weight: 700;
  color: var(--copper);
}

.pop-line-text {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 17px;
  line-height: 26px;
  color: var(--ink-deep);
}

.msg-body {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 24px;
  line-height: 34px;
  font-weight: 700;
  color: var(--ink-deep);
  text-align: center;
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --lamp-gold: #e0a050;
  --paper: #f3eedf;
  --paper-old: #e3d9c2;
  --vermilion: #b8322a;
}

