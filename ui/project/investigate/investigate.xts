  font-weight: 700;
  line-height: 42px;
  text-align: center;
  white-space: nowrap;
}

/* import: Investigate.dc.html:1/4 */
#hint-dock {
  pointer-events: none;
}

/* import: Investigate.dc.html:1/4/0 */
#avatar {
  background-color: var(--paper-old);
  border: 3px #a65432;
