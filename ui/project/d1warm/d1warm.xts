/* Generated by xtframe-import from "D1Warm". Edits are kept on re-import; see import-report.json. */

/* import: D1Warm.dc.html:1 */
#d1warm {
  background-color: var(--paper);
}

/* import: D1Warm.dc.html:1/0 */
#bg {
  object-fit: cover;
}

/* import: D1Warm.dc.html:1/4 */
#head {
  background-color: #f3eedfeb;
}

.title {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 24px;
  line-height: 36px;
  font-weight: 700;
  color: var(--ink-deep);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ch-art {
  object-fit: contain;
}

.kicker {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--copper);
  white-space: nowrap;
}

:lang(en) .kicker {
  letter-spacing: 1px;
}

.extra {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 20px;
  line-height: 36px;
  font-weight: 700;
  letter-spacing: 4px;
  text-align: center;
  color: var(--paper);
  background-color: var(--vermilion);
  white-space: nowrap;
}

:lang(en) .extra {
  font-size: 15px;
  letter-spacing: 1px;
}

:lang(en) .title {
  font-size: 20px;
}

.miss {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 18px;
  line-height: 34px;
  font-weight: 700;
  text-align: center;
  color: var(--ink-deep);
  background-color: var(--paper);
  border: 2px #123a31;
  white-space: nowrap;
}

.rule {
  background-color: var(--ink);
}

.fig {
  effect: color-adjust(brightness(0) saturate(0));
  transition: effect 220ms ease-out;
}

.fig.dim {
  effect: color-adjust(brightness(-0.14) saturate(-0.5));
}

.point {
  background-color: #fbf8ef;
  border: 3px #b8322a;
  effect: shadow(5px 5px 0px 0px #092e2866);
}

.point-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 23px;
  line-height: 33px;
  font-weight: 700;
  color: var(--ink-deep);
}

:lang(en) .point-t {
  font-size: 19px;
  line-height: 26px;
}

.prompt {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 22px;
  color: var(--paper);
  text-align: center;
  background-color: #092e28d9;
  border-top-width: 1px;
  border-top-color: #a65432;
  border-bottom-width: 1px;
  border-bottom-color: #a65432;
}

.obs {
  background-color: var(--paper);
  border: 1px #123a31;
  border-top-width: 4px;
  border-top-color: #a65432;
  effect: shadow(3px 3px 0px 0px #092e2866);
  opacity: 0.6;
  transition: background-color 120ms linear;
}

.obs.on {
  opacity: 1;
}

.obs.on:hover {
  background-color: #fff3cf;
  border-top-color: var(--vermilion);
}

.obs-k {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 12px;
  line-height: 18px;
  letter-spacing: 2px;
  color: var(--copper);
  white-space: nowrap;
}

.obs-n {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 15px;
  line-height: 18px;
  font-weight: 700;
  color: var(--copper);
  text-align: right;
  white-space: nowrap;
}

.obs-t {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 17px;
  line-height: 25px;
  color: var(--ink-deep);
}

:lang(en) .obs-t {
  font-size: 15px;
  line-height: 21px;
}

.dlg {
  background-color: var(--paper);
  border-top-width: 3px;
  border-top-color: #123a31;
  border-bottom-width: 1px;
  border-bottom-color: #123a31;
  effect: shadow(4px 4px 0px 0px #092e2859);
}

.spk {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 14px;
  line-height: 22px;
  letter-spacing: 3px;
  color: var(--copper);
  white-space: nowrap;
}

:lang(en) .spk {
  letter-spacing: 1px;
}

.line {
  font-family: "Noto Serif", "Noto Sans TC", "Georgia";
  font-size: 20px;
  line-height: 30px;
  color: var(--ink);
}

:lang(en) .line {
  font-size: 18px;
  line-height: 26px;
}

:root {
  --copper: #a65432;
  --ink: #123a31;
  --ink-deep: #092e28;
  --paper: #f3eedf;
  --vermilion: #b8322a;
}

