    {
      "id": "paperChars",
      "type": "atrium.expr",
      "params": {
        "expr": "lnB + (addOnN ? lnA2 + lnA3 : 0)"
      }
    },
    {
      "id": "paperCols",
      "type": "atrium.expr",
      "params": {
        "expr": "paperChars > 6 * (langEnP ? 67 : 26) ? 2 : 1"
      }
    },
    {
      "id": "paperColH",
      "type": "atrium.expr",
      "params": {
        "expr": "paperCols == 1 ? 342 : ceil((ceil(paperChars / (langEnP ? 72 : 25)) + 1) / 2) * (langEnP ? 29 : 34)"
      }
    },
