   }
  },
  {
   "id": "n_g2",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (tVoid ? 1 : s_g2) : (brOk ? 1 : gb2 && recSIdx != 2)"
   }
  },
  {
   "id": "n_g3",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (tVoid ? 1 : s_g3) : (brOk ? 1 : gb3 && recSIdx != 3)"
   }
  },
  {
   "id": "n_fseq",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (s_fseq) : (s_fseq + obsF)"
   }
  },
  {
   "id": "n_flo",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (s_flo) : (brOk ? s_fseq + obsF : s_flo + fragC)"
   }
  },
  {
   "id": "n_sh",
   "type": "atrium.expr",
   "params": {
