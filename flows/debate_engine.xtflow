   }
  },
  {
   "id": "n_kjh",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (s_kjh) : (kjhN)"
   }
  },
  {
   "id": "n_par",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (s_par) : (parN)"
   }
  },
  {
   "id": "n_ss",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (max(0, s_ss - 1)) : (tailStart ? 0 : ssN)"
   }
  },
  {
   "id": "n_as",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (s_as) : (s_as - kAssist)"
   }
  },
  {
   "id": "n_fox",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (s_fox) : (s_fox)"
   }
  },
  {
   "id": "n_foxr",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (s_foxr) : (s_foxr)"
   }
  },
  {
