   }
  },
  {
   "id": "n_tl",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (max(0, tlN)) : (tailStart ? c_tr : s_tl)"
   }
  },
  {
   "id": "n_voids",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (s_voids + tVoid) : (s_voids)"
   }
  },
  {
   "id": "n_hk",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (s_hk) : (hkN)"
   }
  },
  {
   "id": "n_kj",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (max(0, s_kj - 1)) : (kjN)"
   }
  },
  {
   "id": "n_kjp",
   "type": "atrium.expr",
   "params": {
