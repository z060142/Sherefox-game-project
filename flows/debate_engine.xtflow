   }
  },
  {
   "id": "n_man",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (s_man) : (oScr ? s_man : kPA == 3 && oA == 3)"
   }
  },
  {
   "id": "r3fire",
   "type": "atrium.expr",
   "params": {
    "expr": "!oScr && c_hp && !s_r3f && ohp3 <= c_oMax * c_r3 / 100"
   }
  },
  {
   "id": "n_r3f",
