   }
  },
  {
   "id": "n_php",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (tPhp) : (php2)"
   }
  },
  {
   "id": "n_ohp",
   "type": "atrium.expr",
   "params": {
