   }
  },
  {
   "id": "guOn",
   "type": "atrium.expr",
   "params": {
    "expr": "brOk && (c_gpN == 0 || lblN1 == 1)"
   }
  },
  {
   "id": "gu",
   "type": "select"
  },
  {
   "id": "hasGold_c",
   "type": "compare",
   "params": {
    "op": "ne"
   }
  },
  {
   "id": "hasGold",
   "type": "select"
  },
  {
   "id": "fRonpa",
   "type": "atrium.expr",
   "params": {
    "expr": "brOk"
   }
  },
  {
   "id": "fShaken",
   "type": "atrium.expr",
   "params": {
    "expr": "gainSh"
   }
  },
  {
   "id": "fShisshu",
   "type": "atrium.expr",
   "params": {
    "expr": "trigS"
   }
  },
  {
   "id": "fHk3",
   "type": "atrium.expr",
   "params": {
    "expr": "hk3"
   }
  },
  {
   "id": "fKonju",
   "type": "atrium.expr",
   "params": {
    "expr": "kjGain"
   }
  },
  {
   "id": "minPrio",
   "type": "atrium.expr",
   "params": {
    "expr": "min(min(fRonpa ? 3 : 99, fShaken ? 6 : 99), min(min(fKonju ? 7 : 99, fShisshu ? 8 : 99), fHk3 ? 9 : 99))"
   }
  },
  {
   "id": "pRonpa",
   "type": "atrium.expr",
   "params": {
    "expr": "minPrio == 3"
   }
  },
  {
   "id": "pShaken",
   "type": "atrium.expr",
   "params": {
    "expr": "minPrio == 6"
   }
  },
  {
   "id": "pKonju",
   "type": "atrium.expr",
   "params": {
    "expr": "minPrio == 7"
   }
  },
  {
   "id": "pShisshu",
   "type": "atrium.expr",
   "params": {
    "expr": "minPrio == 8"
   }
  },
  {
   "id": "pHk3",
   "type": "atrium.expr",
   "params": {
    "expr": "minPrio == 9"
   }
  },
  {
   "id": "tCorrect",
   "type": "atrium.expr",
   "params": {
    "expr": "kPA == 2 && hasSeg && L >= 2 && pL == 0 && seg_rT"
   }
  },
  {
   "id": "tPhp",
   "type": "atrium.expr",
   "params": {
    "expr": "tCorrect ? s_php : s_php - c_tw"
   }
  },
  {
   "id": "tLoss",
   "type": "atrium.expr",
   "params": {
    "expr": "!tCorrect && tPhp <= 0"
   }
  },
  {
   "id": "tOver",
   "type": "atrium.expr",
   "params": {
    "expr": "tCorrect || tLoss"
   }
  },
  {
   "id": "tlN",
   "type": "atrium.expr",
   "params": {
    "expr": "s_tl - 1"
   }
  },
  {
   "id": "tVoid",
   "type": "atrium.expr",
   "params": {
    "expr": "!tOver && tlN <= 0"
   }
  },
  {
   "id": "tOhp",
   "type": "atrium.expr",
   "params": {
    "expr": "tCorrect ? 0 : tVoid ? c_oMax * c_voidPct / 100 : s_ohp"
   }
  },
  {
   "id": "n_act",
   "type": "atrium.expr",
   "params": {
    "expr": "tailR ? (s_act) : (s_act)"
   }
  },
  {
   "id": "n_r",
