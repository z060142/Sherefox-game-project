   }
  },
  {
   "id": "inSh",
   "type": "atrium.expr",
   "params": {
    "expr": "c_ssOn && s_ss > 0"
   }
  },
  {
   "id": "kjAct",
   "type": "atrium.expr",
   "params": {
    "expr": "c_kjOn && s_kj > 0"
   }
  },
  {
   "id": "nStart",
   "type": "atrium.expr",
   "params": {
    "expr": "3 - s_g1 - s_g2 - s_g3"
   }
  },
  {
   "id": "tRef",
   "type": "atrium.expr",
   "params": {
    "expr": "(tIdx == 1 && seg_r1) || (tIdx == 2 && seg_r2) || (tIdx == 3 && seg_r3)"
   }
  },
  {
   "id": "reduce",
   "type": "atrium.expr",
   "params": {
    "expr": "c_hk == 2 && s_hk >= 3"
   }
  },
  {
   "id": "needChain",
   "type": "atrium.expr",
   "params": {
    "expr": "max(1, c_brChain + s_voids - reduce)"
   }
  },
  {
   "id": "needStrong",
   "type": "atrium.expr",
   "params": {
    "expr": "max(1, c_brStrong + s_voids - reduce)"
   }
  },
  {
   "id": "thr",
   "type": "atrium.expr",
   "params": {
    "expr": "c_ch1 ? segBrk : (pL == 0 && L >= needChain) || (segStrongOk && pL == 0 && L >= needStrong)"
   }
  },
  {
   "id": "brOk",
   "type": "atrium.expr",
   "params": {
    "expr": "br && ((kPA == 0 && thr) || (kPA == 2 && hasSeg && icpt))"
   }
  },
  {
   "id": "brVia",
   "type": "atrium.expr",
   "params": {
    "expr": "kPA == 0 ? 0 : 1"
   }
  },
  {
   "id": "missPB",
   "type": "atrium.expr",
   "params": {
    "expr": "br && kPA == 2 && hasSeg && !icpt"
   }
  },
  {
   "id": "nf",
   "type": "atrium.expr",
   "params": {
    "expr": "s_fseq - s_flo"
   }
  },
  {
   "id": "fragC",
   "type": "atrium.expr",
   "params": {
    "expr": "hit && nf > 0"
   }
  },
  {
   "id": "tAlive",
   "type": "atrium.expr",
   "params": {
    "expr": "(tIdx == 1 && !s_g1) || (tIdx == 2 && !s_g2) || (tIdx == 3 && !s_g3)"
   }
  },
  {
   "id": "remT",
   "type": "atrium.expr",
   "params": {
    "expr": "kPA == 0 && !brOk && tAlive && tRef"
   }
  },
  {
   "id": "cand1",
   "type": "atrium.expr",
   "params": {
    "expr": "remT && L >= 4 && !s_g1 && tIdx != 1 && seg_r1"
   }
  },
  {
   "id": "cand2",
   "type": "atrium.expr",
   "params": {
    "expr": "remT && L >= 4 && !s_g2 && tIdx != 2 && seg_r2"
   }
  },
  {
   "id": "cand3",
   "type": "atrium.expr",
   "params": {
    "expr": "remT && L >= 4 && !s_g3 && tIdx != 3 && seg_r3"
   }
  },
  {
   "id": "sec1",
   "type": "atrium.expr",
   "params": {
    "expr": "cand1 && (!cand2 || pos1 < pos2) && (!cand3 || pos1 < pos3)"
   }
  },
  {
   "id": "sec2",
   "type": "atrium.expr",
   "params": {
    "expr": "cand2 && (!cand1 || pos2 < pos1) && (!cand3 || pos2 < pos3)"
   }
  },
  {
   "id": "sec3",
   "type": "atrium.expr",
   "params": {
    "expr": "cand3 && (!cand1 || pos3 < pos1) && (!cand2 || pos3 < pos2)"
   }
  },
  {
   "id": "secIdx",
   "type": "atrium.expr",
   "params": {
    "expr": "sec1 ? 1 : sec2 ? 2 : sec3 ? 3 : 0"
   }
  },
  {
   "id": "remP",
   "type": "atrium.expr",
   "params": {
    "expr": "icpt && !brOk"
   }
  },
  {
   "id": "ga1",
   "type": "atrium.expr",
   "params": {
    "expr": "s_g1 || (remT && tIdx == 1) || secIdx == 1 || (remP && litIdx == 1)"
   }
  },
  {
   "id": "ga2",
   "type": "atrium.expr",
   "params": {
    "expr": "s_g2 || (remT && tIdx == 2) || secIdx == 2 || (remP && litIdx == 2)"
   }
  },
  {
   "id": "ga3",
   "type": "atrium.expr",
   "params": {
    "expr": "s_g3 || (remT && tIdx == 3) || secIdx == 3 || (remP && litIdx == 3)"
   }
  },
  {
   "id": "obsF",
   "type": "atrium.expr",
   "params": {
    "expr": "kPA == 3 && (oA == 2 || oA == 3)"
   }
  },
  {
   "id": "recRIdx",
   "type": "atrium.expr",
   "params": {
    "expr": "oA == 2 && (3 - ga1 - ga2 - ga3) < c_cap ? (ga1 ? 1 : ga2 ? 2 : ga3 ? 3 : 0) : 0"
   }
  },
  {
   "id": "gb1",
   "type": "atrium.expr",
   "params": {
    "expr": "ga1 && recRIdx != 1"
   }
  },
  {
   "id": "gb2",
   "type": "atrium.expr",
   "params": {
    "expr": "ga2 && recRIdx != 2"
   }
  },
  {
   "id": "gb3",
   "type": "atrium.expr",
   "params": {
    "expr": "ga3 && recRIdx != 3"
   }
  },
  {
   "id": "remAny",
   "type": "atrium.expr",
   "params": {
    "expr": "remT || secIdx > 0 || remP"
   }
  },
  {
   "id": "conInc",
   "type": "atrium.expr",
   "params": {
    "expr": "c_conT > 0 && !brOk && (remP || (kPA == 0 && oA == 2 && remAny))"
   }
  },
  {
   "id": "conN",
   "type": "atrium.expr",
   "params": {
    "expr": "s_con + conInc"
   }
  },
  {
   "id": "half",
   "type": "atrium.expr",
   "params": {
    "expr": "oAtk || (kPA == 0 && oA == 2 && !brOk)"
   }
  },
  {
   "id": "cd0",
   "type": "atrium.expr",
   "params": {
    "expr": "14 * (10 + 5 * sL + 8 * pL) / 10"
   }
  },
  {
   "id": "cd1",
   "type": "atrium.expr",
   "params": {
    "expr": "br ? cd0 * c_shN / c_shD : cd0"
   }
  },
  {
   "id": "cd2",
   "type": "atrium.expr",
   "params": {
    "expr": "stacks ? cd1 * (10 + stacks) / 10 : cd1"
   }
  },
  {
   "id": "cd3",
   "type": "atrium.expr",
   "params": {
    "expr": "half ? cd2 / 2 : cd2"
   }
  },
  {
   "id": "chainD",
   "type": "atrium.expr",
   "params": {
    "expr": "fragC ? cd3 + 10 : cd3"
   }
  },
  {
   "id": "ctrD",
   "type": "atrium.expr",
   "params": {
    "expr": "stacks ? c_counter * (10 + stacks) / 10 : c_counter"
   }
  },
  {
   "id": "dmgO",
   "type": "atrium.expr",
   "params": {
    "expr": "hit ? chainD : icpt ? ctrD : 0"
   }
  },
  {
   "id": "ohp1",
   "type": "atrium.expr",
   "params": {
    "expr": "c_hp && dmgO != 0 ? s_ohp - dmgO : s_ohp"
   }
  },
  {
   "id": "brAmt",
   "type": "atrium.expr",
   "params": {
    "expr": "c_oMax * c_brPct / 100"
   }
  },
  {
   "id": "oppZero",
   "type": "atrium.expr",
   "params": {
    "expr": "!brOk && c_hp && ohp1 <= 0"
   }
  },
  {
   "id": "ohp2",
   "type": "atrium.expr",
   "params": {
    "expr": "brOk ? (c_hp ? max(1, ohp1 - brAmt) : ohp1) : oppZero ? 0 : ohp1"
   }
  },
  {
   "id": "takeAtk",
   "type": "atrium.expr",
   "params": {
    "expr": "!oppZero && oAtk && !icpt"
   }
  },
  {
   "id": "pd0",
   "type": "atrium.expr",
   "params": {
    "expr": "c_base + c_per * nStart"
   }
  },
  {
   "id": "pd1",
   "type": "atrium.expr",
   "params": {
    "expr": "oA == 1 ? pd0 * c_rushN / c_rushD : pd0"
   }
  },
  {
   "id": "pd2",
   "type": "atrium.expr",
   "params": {
    "expr": "kjAct ? pd1 * c_kjN / c_kjD : pd1"
   }
  },
  {
   "id": "pd3",
   "type": "atrium.expr",
   "params": {
    "expr": "s_r >= c_impR ? pd2 + c_impA : pd2"
   }
  },
  {
   "id": "dmgP",
   "type": "atrium.expr",
   "params": {
    "expr": "kPA == 3 ? pd3 / 2 : pd3"
   }
  },
  {
   "id": "fullRush",
   "type": "atrium.expr",
   "params": {
    "expr": "takeAtk && oA == 1 && kPA != 3"
   }
  },
  {
   "id": "php1",
   "type": "atrium.expr",
   "params": {
    "expr": "takeAtk && c_hp ? s_php - dmgP : s_php"
   }
  },
  {
   "id": "trapOn",
   "type": "atrium.expr",
   "params": {
    "expr": "!oppZero && trapped"
   }
  },
  {
   "id": "asBlock",
   "type": "atrium.expr",
   "params": {
    "expr": "trapOn && kAssist && anyUA"
   }
  },
  {
   "id": "crit",
   "type": "atrium.expr",
   "params": {
    "expr": "trapOn && !kAssist && anyUA"
   }
  },
  {
   "id": "php2",
   "type": "atrium.expr",
   "params": {
    "expr": "crit && c_hp ? php1 - c_crit : php1"
   }
  },
  {
   "id": "asWaste",
   "type": "atrium.expr",
   "params": {
    "expr": "!oppZero && kAssist && oA != 3"
   }
  },
  {
   "id": "caughtSlot",
   "type": "atrium.expr",
   "params": {
    "expr": "cj == 0 ? lslot0 : cj == 1 ? lslot1 : cj == 2 ? lslot2 : lslot3"
   }
  },
  {
   "id": "reinfOk",
   "type": "atrium.expr",
   "params": {
    "expr": "oA == 2 && !hit"
   }
  },
  {
   "id": "healOk",
   "type": "atrium.expr",
   "params": {
    "expr": "c_hp && reinfOk && !oppZero"
   }
  },
  {
   "id": "ohp3",
   "type": "atrium.expr",
   "params": {
    "expr": "healOk ? min(c_oMax, ohp2 + c_oMax * c_heal / 100) : ohp2"
   }
  },
  {
   "id": "healAmt",
   "type": "atrium.expr",
   "params": {
    "expr": "ohp3 - ohp2"
   }
  },
  {
   "id": "lossA",
   "type": "atrium.expr",
   "params": {
    "expr": "!oppZero && c_hp && php2 <= 0"
   }
  },
  {
   "id": "over1",
   "type": "atrium.expr",
   "params": {
    "expr": "oppZero || lossA"
   }
  },
  {
   "id": "scTrig",
   "type": "atrium.expr",
   "params": {
    "expr": "c_conT == 0 && kPA == 0 && hit && tIdx > 0 && seg_scandal && tPs"
   }
  },
  {
   "id": "fourTrig",
   "type": "atrium.expr",
   "params": {
    "expr": "c_conT == 0 && kPA == 0 && hit && tIdx > 0 && L >= 4 && (c_brLine == 0 || ohp3 <= c_oMax * c_brLine / 100)"
   }
  },
  {
   "id": "trig",
   "type": "atrium.expr",
   "params": {
    "expr": "!over1 && (c_conT > 0 ? conInc && conN >= c_conT : (icpt && oA == 1) || scTrig || fourTrig)"
   }
  },
  {
   "id": "shN",
   "type": "atrium.expr",
   "params": {
    "expr": "over1 ? s_sh : brOk ? 2 : br ? (trig ? 1 : 0) : trig ? 1 : s_sh"
   }
  },
  {
   "id": "lostBR",
   "type": "atrium.expr",
   "params": {
    "expr": "!over1 && !brOk && br && !trig"
   }
  },
  {
   "id": "gainSh",
   "type": "atrium.expr",
   "params": {
    "expr": "trig && !brOk"
   }
  },
  {
   "id": "ssLive",
   "type": "atrium.expr",
   "params": {
    "expr": "c_ssOn && !over1"
   }
  },
  {
   "id": "trigS",
   "type": "atrium.expr",
   "params": {
    "expr": "ssLive && !brOk && ((fullRush && isAtk) || crit)"
   }
  },
  {
   "id": "ssN",
   "type": "atrium.expr",
   "params": {
    "expr": "!ssLive ? s_ss : brOk ? 0 : trigS ? 1 : max(0, s_ss - 1)"
   }
  },
  {
   "id": "lostSsBr",
   "type": "atrium.expr",
   "params": {
    "expr": "ssLive && brOk && s_ss > 0"
   }
  },
  {
   "id": "lostSsExp",
   "type": "atrium.expr",
   "params": {
    "expr": "ssLive && !brOk && !trigS && s_ss == 1"
   }
  },
  {
   "id": "hkLive",
   "type": "atrium.expr",
   "params": {
    "expr": "c_hk >= 1 && !over1"
   }
  },
  {
   "id": "right",
   "type": "atrium.expr",
   "params": {
    "expr": "(oAtk ? icpt || (inSh && kPA == 3) : oA == 2 ? (kPA == 1 && s_soph) || kPA == 3 : kPA == 0 || kPA == 3) || scTrig || brOk"
   }
  },
  {
   "id": "hkNew",
   "type": "atrium.expr",
   "params": {
    "expr": "trigS ? 0 : right ? min(3, s_hk + 1) : 0"
   }
  },
  {
   "id": "hkN",
   "type": "atrium.expr",
   "params": {
    "expr": "hkLive ? hkNew : s_hk"
   }
  },
  {
   "id": "hkPrev",
   "type": "atrium.expr",
   "params": {
    "expr": "c_hk == 1"
   }
  },
  {
   "id": "hk3",
   "type": "atrium.expr",
   "params": {
    "expr": "hkLive && c_hk == 2 && hkNew > s_hk && hkNew == 3"
   }
  },
  {
   "id": "hkUp",
   "type": "atrium.expr",
   "params": {
    "expr": "hkLive && c_hk == 2 && hkNew > s_hk && hkNew < 3"
   }
  },
  {
   "id": "hkLost",
   "type": "atrium.expr",
   "params": {
    "expr": "hkLive && c_hk == 2 && hkNew < s_hk"
   }
  },
  {
   "id": "parN",
   "type": "atrium.expr",
   "params": {
    "expr": "s_par + icpt"
   }
  },
  {
   "id": "kjLive",
   "type": "atrium.expr",
   "params": {
    "expr": "c_kjOn && !over1"
   }
  },
  {
   "id": "condP",
   "type": "atrium.expr",
   "params": {
    "expr": "parN >= 2 && !s_kjp"
   }
  },
  {
   "id": "condH",
   "type": "atrium.expr",
   "params": {
    "expr": "c_hp && ohp3 <= c_oMax * c_kjHp / 100 && !s_kjh"
   }
  },
  {
   "id": "kjGain",
   "type": "atrium.expr",
   "params": {
    "expr": "kjLive && !brOk && (condP || condH) && s_kj == 0"
   }
  },
  {
   "id": "kjN",
   "type": "atrium.expr",
   "params": {
    "expr": "!kjLive ? s_kj : brOk ? 0 : kjGain ? c_kjR : max(0, s_kj - 1)"
   }
  },
  {
   "id": "kjpN",
   "type": "atrium.expr",
   "params": {
    "expr": "s_kjp || (kjGain && condP)"
   }
  },
  {
   "id": "kjhN",
   "type": "atrium.expr",
   "params": {
    "expr": "s_kjh || (kjGain && condH)"
   }
  },
  {
   "id": "lostKjBr",
   "type": "atrium.expr",
   "params": {
    "expr": "kjLive && brOk && s_kj > 0"
   }
  },
  {
   "id": "lostKjExp",
   "type": "atrium.expr",
   "params": {
    "expr": "kjLive && !brOk && s_kj == 1"
   }
  },
  {
   "id": "ch1Live",
   "type": "atrium.expr",
   "params": {
    "expr": "c_conT > 0 && !over1"
   }
  },
  {
   "id": "winB",
   "type": "atrium.expr",
   "params": {
    "expr": "ch1Live && brOk"
   }
  },
  {
   "id": "unachD",
   "type": "atrium.expr",
   "params": {
    "expr": "ch1Live && !brOk && s_r >= c_conD && conN < c_conT"
   }
  },
  {
   "id": "capU",
   "type": "atrium.expr",
   "params": {
    "expr": "ch1Live && !brOk && !unachD && c_rcap > 0 && s_r >= c_rcap"
   }
  },
  {
   "id": "over2",
   "type": "atrium.expr",
   "params": {
    "expr": "over1 || winB || unachD || capU"
   }
  },
  {
   "id": "tailStart",
   "type": "atrium.expr",
   "params": {
    "expr": "brOk && c_hasTail && !over2"
   }
  },
  {
   "id": "winNT",
   "type": "atrium.expr",
   "params": {
    "expr": "brOk && !c_hasTail && !over2"
   }
  },
  {
   "id": "overN1",
   "type": "atrium.expr",
   "params": {
    "expr": "over2 || winNT"
   }
  },
  {
   "id": "endN",
   "type": "atrium.expr",
   "params": {
    "expr": "oppZero ? 1 : lossA ? 2 : winB ? 3 : unachD ? 4 : capU ? 5 : winNT ? 6 : 0"
   }
  },
  {
   "id": "recSIdx",
   "type": "atrium.expr",
   "params": {
    "expr": "!overN1 && !tailStart && (3 - gb1 - gb2 - gb3) < c_cap ? (gb1 ? 1 : gb2 ? 2 : gb3 ? 3 : 0) : 0"
   }
  },
  {
   "id": "lblN1",
   "type": "atrium.expr",
   "params": {
