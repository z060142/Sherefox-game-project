   "type": "atrium.expr",
   "params": {
    "expr": "kPA == 1 && oA == 3"
   }
  },
  {
   "id": "hit",
   "type": "atrium.expr",
   "params": {
    "expr": "isAtk && !trapped"
   }
  },
  {
   "id": "icpt",
   "type": "atrium.expr",
   "params": {
    "expr": "kPA == 2 && oAtk"
   }
  },
  {
   "id": "br",
   "type": "atrium.expr",
   "params": {
    "expr": "s_sh == 1"
   }
  },
  {
   "id": "stacks",
   "type": "atrium.expr",
   "params": {
