          }
        ]
      }
    },
    {
      "id": "choosing",
      "type": "atrium.expr",
      "params": {
        "expr": "n == 2 || n == 6 || n == 9"
      }
    },
    {
      "id": "nextN",
      "type": "atrium.expr",
      "params": {
        "expr": "n == 1 ? 2 : n == 3 ? 4 : n == 4 ? 6 : n == 7 ? 8 : n == 8 ? 9 : n == 10 ? 11 : n == 11 ? 12 : n == 5 ? (pt == 0 ? 2 : pt == 1 ? 6 : 9) : n == 12 ? (mis == 0 ? 13 : 0) : n == 14 ? 15 : 0"
      }
    },
    {
