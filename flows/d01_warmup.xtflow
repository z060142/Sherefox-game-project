            "from": "b",
            "on": "go",
            "to": "a"
          }
        ]
      }
    },
    {
      "id": "advOk",
      "type": "atrium.expr",
      "params": {
        "expr": "n > 0 && !choosing"
      }
    },
    {
      "id": "advG",
      "type": "atrium.gate"
    },
    {
      "id": "nextOk",
      "type": "atrium.expr",
