{
  "version": 1,
  "nodes": [
    {
      "id": "lang",
      "type": "state",
      "params": {
        "initial": "zh",
        "states": [
          "zh",
          "en"
        ],
        "transitions": [
          {
            "from": "zh",
            "on": "toggle",
            "to": "en"
          },
          {
            "from": "en",
            "on": "toggle",
            "to": "zh"
          }
        ]
      }
    },
    {
      "id": "langTag",
