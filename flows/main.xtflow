{
  "version": 1,
  "nodes": [
    {
      "id": "lang",
      "type": "state",
      "params": {
        "initial": "zh",
        "states": [
          "zh",
          "en"
        ],
        "transitions": [
          {
            "from": "zh",
            "on": "toggle",
            "to": "en"
          },
          {
            "from": "en",
            "on": "toggle",
            "to": "zh"
          }
        ]
      }
    },
    {
      "id": "langTag",
      "type": "lookup",
      "params": {
        "values": [
          "zh-TW",
          "en"
        ]
      }
    },
    {
      "id": "enTag",
      "type": "constant",
      "params": {
        "value": "en"
      }
    },
    {
      "id": "langIsEn",
      "type": "compare",
      "params": {
        "op": "eq"
      }
    },
    {
      "id": "langName",
      "type": "select"
    },
    {
      "id": "zhName",
      "type": "constant",
      "params": {
        "value": "zh"
      }
    },
    {
      "id": "enName",
      "type": "constant",
      "params": {
        "value": "en"
      }
    },
    {
      "id": "one",
      "type": "constant",
      "params": {
        "value": 1
      }
    },
    {
      "id": "isEnUi",
      "type": "compare",
      "params": {
        "op": "eq"
      }
    },
    {
      "id": "chText",
      "type": "toString"
    },
    {
      "id": "zeroText",
      "type": "constant",
      "params": {
        "value": "0"
      }
    },
    {
      "id": "chStart",
      "type": "atrium.table.find",
      "params": {
        "table": "steps",
        "column": "chapter",
        "filterColumn": "idx"
      }
    },
    {
      "id": "chPick",
      "type": "filter",
      "params": {
        "op": "sample"
      }
    },
    {
      "id": "cur",
      "type": "counter",
      "params": {
        "initial": -1
      }
    },
    {
      "id": "kind",
      "type": "atrium.table.get",
      "params": {
        "table": "steps",
        "column": "kind",
        "type": "string"
      }
    },
    {
      "id": "arg",
      "type": "atrium.table.get",
      "params": {
        "table": "steps",
        "column": "arg",
        "type": "string"
      }
    },
    {
      "id": "scene",
      "type": "atrium.table.get",
      "params": {
        "table": "steps",
        "column": "scene",
        "type": "string"
      }
    },
    {
      "id": "chapter",
      "type": "atrium.table.get",
      "params": {
        "table": "steps",
        "column": "chapter",
        "type": "number"
      }
    },
    {
      "id": "begin",
      "type": "filter",
      "params": {
        "op": "deadband",
        "threshold": 0
      }
    },
    {
      "id": "rebegin",
      "type": "merge"
    },
    {
      "id": "same",
      "type": "compare",
      "params": {
        "op": "eq"
      }
    },
    {
      "id": "sameGate",
      "type": "state",
      "params": {
        "states": [
          "a",
          "b"
        ],
        "initial": "a",
        "transitions": [
          {
            "from": "a",
            "on": "go",
            "to": "b"
          },
          {
            "from": "b",
            "on": "go",
            "to": "a"
          }
        ]
      }
    },
    {
      "id": "retrying",
      "type": "toggle",
      "params": {
        "initial": false
      }
    },
    {
      "id": "screen",
      "type": "state",
      "params": {
        "initial": "title",
        "states": [
          "title",
          "paper",
          "vn",
          "investigate",
          "board",
          "debate",
          "result"
        ],
        "transitions": [
          {
            "from": "*",
            "on": "to_title",
            "to": "title"
          },
          {
            "from": "*",
            "on": "to_paper",
            "to": "paper"
          },
          {
            "from": "*",
            "on": "to_vn",
            "to": "vn"
          },
          {
            "from": "*",
            "on": "to_investigate",
            "to": "investigate"
          },
          {
            "from": "*",
            "on": "to_board",
            "to": "board"
          },
          {
            "from": "*",
            "on": "to_debate",
            "to": "debate"
          },
          {
            "from": "*",
            "on": "to_result",
            "to": "result"
          }
        ]
      }
    },
    {
      "id": "sceneKey",
      "type": "format",
      "params": {
        "format": "CH0{a}_{b}"
      }
    },
    {
      "id": "preRow",
      "type": "atrium.table.find",
      "params": {
        "table": "script",
        "column": "sceneKey",
        "filters": "{\"playable\": \"true\", \"cue\": \"pre\"}"
      }
    },
    {
      "id": "hasPre",
      "type": "atrium.expr",
      "params": {
        "expr": "preRow >= 0"
      }
    },
    {
      "id": "noPre",
      "type": "atrium.expr",
      "params": {
        "expr": "preRow < 0"
      }
    },
    {
      "id": "isEndTag",
      "type": "constant",
      "params": {
        "value": "end"
      }
    },
    {
      "id": "isEnd",
      "type": "compare",
      "params": {
        "op": "eq"
      }
    },
    {
      "id": "isPaperTag",
      "type": "constant",
      "params": {
        "value": "paper"
      }
    },
    {
      "id": "isPaper",
      "type": "compare",
      "params": {
        "op": "eq"
      }
    },
    {
      "id": "isVnTag",
      "type": "constant",
      "params": {
        "value": "vn"
      }
    },
    {
      "id": "isVn",
      "type": "compare",
      "params": {
        "op": "eq"
      }
    },
    {
      "id": "isInvTag",
      "type": "constant",
      "params": {
        "value": "investigate"
      }
    },
    {
      "id": "isInv",
      "type": "compare",
      "params": {
        "op": "eq"
      }
    },
    {
      "id": "isBoardTag",
      "type": "constant",
      "params": {
        "value": "board"
      }
    },
    {
      "id": "isBoard",
      "type": "compare",
      "params": {
        "op": "eq"
      }
    },
    {
      "id": "isDebTag",
      "type": "constant",
      "params": {
        "value": "debate"
      }
    },
    {
      "id": "isDeb",
      "type": "compare",
      "params": {
        "op": "eq"
      }
    },
    {
      "id": "isWarmTag",
      "type": "constant",
      "params": {
        "value": "warmup"
      }
    },
    {
      "id": "isWarm",
      "type": "compare",
      "params": {
        "op": "eq"
      }
    },
    {
      "id": "isResTag",
      "type": "constant",
      "params": {
        "value": "result"
      }
    },
    {
      "id": "isRes",
      "type": "compare",
      "params": {
        "op": "eq"
      }
    },
    {
      "id": "isDebN",
      "type": "select"
    },
    {
      "id": "K0",
      "type": "constant",
      "params": {
        "value": 1
      }
    },
    {
      "id": "K1",
      "type": "constant",
      "params": {
        "value": 0
      }
    },
    {
      "id": "isWarmN",
      "type": "select"
    },
    {
      "id": "retryN",
      "type": "select"
    },
    {
      "id": "debPre",
      "type": "atrium.expr",
      "params": {
        "expr": "(isDebN || isWarmN) && hasPre && !retryN"
      }
    },
    {
      "id": "debNoPre",
      "type": "atrium.expr",
      "params": {
        "expr": "(isDebN || isWarmN) && (noPre || retryN)"
      }
    },
    {
      "id": "debPreG",
      "type": "atrium.gate"
    },
    {
      "id": "debNoPreG",
      "type": "atrium.gate"
    },
    {
      "id": "card",
      "type": "state",
      "params": {
        "initial": "open",
        "states": [
          "open",
          "closed"
        ],
        "transitions": [
          {
            "from": "open",
            "on": "dismiss",
            "to": "closed"
          },
          {
            "from": "*",
            "on": "rearm",
            "to": "open"
          }
        ]
      }
    },
    {
      "id": "zeroIdx",
      "type": "constant",
      "params": {
        "value": 0
      }
    },
    {
      "id": "no",
      "type": "constant",
      "params": {
        "value": false
      }
    },
    {
      "id": "cardOpen",
      "type": "compare",
      "params": {
        "op": "eq"
      }
    },
    {
      "id": "ended",
      "type": "select"
    },
