      "id": "sophAvail",
      "type": "atrium.expr",
      "params": {
        "expr": "(bl0 == 2 && snv0 < L_Round) + (bl1 == 2 && snv1 < L_Round) + (bl2 == 2 && snv2 < L_Round) + (bl3 == 2 && snv3 < L_Round) + (bl5 == 2 && snv5 < L_Round) + (bl6 == 2 && snv6 < L_Round) + (bl7 == 2 && snv7 < L_Round) + (bl8 == 2 && snv8 < L_Round) + (bl10 == 2 && snv10 < L_Round) + (bl11 == 2 && snv11 < L_Round) + (bl12 == 2 && snv12 < L_Round) + (bl13 == 2 && snv13 < L_Round)"
      }
