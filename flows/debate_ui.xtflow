    {
      "id": "segLo",
      "type": "atrium.expr",
      "params": {
        "expr": "min(segA, segB)"
      }
    },
    {
      "id": "segHi",
      "type": "atrium.expr",
      "params": {
        "expr": "max(segA, segB)"
      }
    },
    {
      "id": "segL",
      "type": "atrium.expr",
      "params": {
        "expr": "d_sa > 0 ? segHi - segLo + 1 : 0"
      }
    },
    {
      "id": "segSoph",
      "type": "atrium.expr",
      "params": {
        "expr": "(segLo <= 0 && 0 < segHi && bl0 == 2) + (segLo <= 1 && 1 < segHi && bl1 == 2) + (segLo <= 2 && 2 < segHi && bl2 == 2) + (segLo <= 3 && 3 < segHi && bl3 == 2) + (segLo <= 4 && 4 < segHi && bl4 == 2) + (segLo <= 5 && 5 < segHi && bl5 == 2) + (segLo <= 6 && 6 < segHi && bl6 == 2) + (segLo <= 7 && 7 < segHi && bl7 == 2) + (segLo <= 8 && 8 < segHi && bl8 == 2) + (segLo <= 9 && 9 < segHi && bl9 == 2) + (segLo <= 10 && 10 < segHi && bl10 == 2) + (segLo <= 11 && 11 < segHi && bl11 == 2) + (segLo <= 12 && 12 < segHi && bl12 == 2) + (segLo <= 13 && 13 < segHi && bl13 == 2)"
