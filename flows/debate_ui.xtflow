        "expr": "(in0 && (q0h0 || q0h1 || q0h2 || q0h3)) + (in1 && (q1h0 || q1h1 || q1h2 || q1h3)) + (in2 && (q2h0 || q2h1 || q2h2 || q2h3)) + (in3 && (q3h0 || q3h1 || q3h2 || q3h3)) + (in4 && (q4h0 || q4h1 || q4h2 || q4h3))"
      }
    },
    {
      "id": "segRef",
      "type": "atrium.expr",
      "params": {
        "expr": "(in0 && q0_ref) + (in1 && q1_ref) + (in2 && q2_ref) + (in3 && q3_ref) + (in4 && q4_ref)"
      }
    },
    {
      "id": "segHidden",
      "type": "atrium.expr",
      "params": {
        "expr": "(in0 && !q0_full) + (in1 && !q1_full) + (in2 && !q2_full) + (in3 && !q3_full) + (in4 && !q4_full)"
      }
    },
    {
      "id": "segStrong",
      "type": "atrium.expr",
      "params": {
        "expr": "(in0 && q0_strong && q0ok) + (in1 && q1_strong && q1ok) + (in2 && q2_strong && q2ok) + (in3 && q3_strong && q3ok) + (in4 && q4_strong && q4ok)"
      }
    },
    {
      "id": "segBrk",
      "type": "atrium.expr",
      "params": {
