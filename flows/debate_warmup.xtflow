   }
  },
  {
   "id": "hasSeg",
   "type": "atrium.expr",
   "params": {
    "expr": "kFrom >= 0"
   }
  },
  {
   "id": "L",
   "type": "atrium.expr",
   "params": {
    "expr": "hasSeg ? abs(kTo - kFrom) + 1 : 0"
   }
  },
  {
   "id": "dir",
   "type": "atrium.expr",
   "params": {
    "expr": "kTo >= kFrom ? 1 : -1"
   }
  },
  {
   "id": "slot0",
   "type": "atrium.expr",
   "params": {
    "expr": "hasSeg && 0 < L ? kFrom + 0 * dir : -1"
   }
  },
  {
   "id": "card0",
   "type": "atrium.coll.get",
   "params": {
    "name": "debBoard"
   }
  },
  {
   "id": "slot1",
   "type": "atrium.expr",
   "params": {
    "expr": "hasSeg && 1 < L ? kFrom + 1 * dir : -1"
   }
  },
  {
   "id": "card1",
   "type": "atrium.coll.get",
   "params": {
    "name": "debBoard"
   }
  },
  {
   "id": "slot2",
   "type": "atrium.expr",
   "params": {
    "expr": "hasSeg && 2 < L ? kFrom + 2 * dir : -1"
   }
  },
  {
   "id": "card2",
   "type": "atrium.coll.get",
   "params": {
    "name": "debBoard"
   }
  },
  {
   "id": "seg12",
