   }
  },
  {
   "id": "segLen3",
   "type": "atrium.expr",
   "params": {
    "expr": "L >= 3"
   }
  },
  {
   "id": "segLen2",
   "type": "atrium.expr",
   "params": {
    "expr": "L == 2"
   }
  },
  {
   "id": "seg1",
   "type": "format",
   "params": {
