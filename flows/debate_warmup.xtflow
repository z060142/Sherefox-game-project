  {
   "id": "n",
   "type": "atrium.expr",
   "params": {
    "expr": "c_cap"
   }
  },
  {
   "id": "live",
   "type": "atrium.expr",
   "params": {
    "expr": "s_act && !s_over && kPA == 2"
   }
  },
  {
   "id": "ok",
   "type": "atrium.expr",
   "params": {
    "expr": "!hasSeg && hasCard && ((claimNo == 1 && r1_C) || (claimNo == 2 && r2_C) || (claimNo == 3 && r3_C))"
   }
  },
  {
   "id": "misN",
   "type": "atrium.expr",
   "params": {
    "expr": "ok ? s_mis : s_mis + 1"
   }
  },
  {
   "id": "autoNow",
   "type": "atrium.expr",
   "params": {
    "expr": "!ok && misN >= c_mis"
   }
  },
  {
   "id": "idxN",
   "type": "atrium.expr",
   "params": {
    "expr": "ok ? s_idx + 1 : autoNow ? n : s_idx"
   }
  },
  {
   "id": "overN",
   "type": "atrium.expr",
   "params": {
    "expr": "idxN >= n"
   }
  },
  {
   "id": "autoN",
   "type": "atrium.expr",
   "params": {
    "expr": "s_auto || autoNow"
   }
  },
  {
   "id": "trustD",
   "type": "atrium.expr",
   "params": {
    "expr": "autoN || misN >= c_mis ? -1 : misN == 0 ? 1 : 0"
   }
  },
  {
   "id": "reward",
   "type": "atrium.expr",
   "params": {
    "expr": "autoN || misN >= c_mis ? 0 : 1"
   }
  },
  {
   "id": "n_act",
   "type": "atrium.expr",
