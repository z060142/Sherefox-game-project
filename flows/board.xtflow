        "expr": "xs >= 0 && (xs == 11 || xs == 11 + 1)"
      }
    },
    {
      "id": "adj12",
      "type": "atrium.expr",
      "params": {
        "expr": "xs >= 0 && (xs == 12 || xs == 12 + 1)"
      }
    },
    {
      "id": "adj13",
