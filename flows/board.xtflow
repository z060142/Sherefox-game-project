        "name": "row2"
      }
    },
    {
      "id": "xs",
      "type": "atrium.expr",
      "params": {
        "expr": "xi0 >= 0 ? xi0 : xi1 >= 0 ? 5 + xi1 : xi2 >= 0 ? 10 + xi2 : -1"
      }
    },
    {
      "id": "adj0",
      "type": "atrium.expr",
      "params": {
        "expr": "xs >= 0 && (xs == 0 || xs == 0 + 1)"
      }
    },
    {
      "id": "adj1",
      "type": "atrium.expr",
      "params": {
        "expr": "xs >= 0 && (xs == 1 || xs == 1 + 1)"
      }
    },
    {
      "id": "adj2",
      "type": "atrium.expr",
      "params": {
        "expr": "xs >= 0 && (xs == 2 || xs == 2 + 1)"
      }
    },
    {
      "id": "adj3",
      "type": "atrium.expr",
      "params": {
        "expr": "xs >= 0 && (xs == 3 || xs == 3 + 1)"
      }
    },
    {
      "id": "adj5",
      "type": "atrium.expr",
      "params": {
        "expr": "xs >= 0 && (xs == 5 || xs == 5 + 1)"
      }
    },
    {
      "id": "adj6",
      "type": "atrium.expr",
      "params": {
        "expr": "xs >= 0 && (xs == 6 || xs == 6 + 1)"
      }
    },
    {
      "id": "adj7",
      "type": "atrium.expr",
      "params": {
        "expr": "xs >= 0 && (xs == 7 || xs == 7 + 1)"
      }
    },
    {
      "id": "adj8",
      "type": "atrium.expr",
      "params": {
        "expr": "xs >= 0 && (xs == 8 || xs == 8 + 1)"
      }
    },
    {
      "id": "adj10",
      "type": "atrium.expr",
      "params": {
        "expr": "xs >= 0 && (xs == 10 || xs == 10 + 1)"
      }
    },
    {
