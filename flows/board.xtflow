    {
      "id": "di_full",
      "type": "atrium.expr",
      "params": {
        "expr": "!di_hidden || di_apprHas || (policeOn && di_policeFull)"
      }
    },
    {
      "id": "di_rsn",
      "type": "atrium.map.get",
      "params": {
        "name": "reason"
      }
    },
    {
      "id": "di_ok",
      "type": "atrium.expr",
      "params": {
        "expr": "di_fixed || di_rsn == di_correct + 1"
      }
    },
    {
      "id": "di_rset",
      "type": "atrium.expr",
      "params": {
        "expr": "di_fixed || di_rsn > 0"
