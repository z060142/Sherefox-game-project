      }
    },
    {
      "id": "noReason",
      "type": "atrium.expr",
      "params": {
        "expr": "noR0 + noR1 + noR2 + noR3 + noR4 + noR5 + noR6 + noR7 + noR8 + noR9 + noR10 + noR11 + noR12 + noR13 + noR14"
      }
    },
    {
      "id": "firstInv",
      "type": "atrium.expr",
      "params": {
        "expr": "(k0 == 3 ? 0 : (k1 == 3 ? 1 : (k2 == 3 ? 2 : (k3 == 3 ? 3 : (k5 == 3 ? 5 : (k6 == 3 ? 6 : (k7 == 3 ? 7 : (k8 == 3 ? 8 : (k10 == 3 ? 10 : (k11 == 3 ? 11 : (k12 == 3 ? 12 : (k13 == 3 ? 13 : 99))))))))))))"
      }
    },
    {
      "id": "anyInv",
      "type": "atrium.expr",
      "params": {
        "expr": "firstInv < 99"
      }
    },
    {
      "id": "xi0",
