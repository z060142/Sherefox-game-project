      }
    },
    {
      "id": "xInv",
      "type": "atrium.expr",
      "params": {
        "expr": "adj0 * (k0 == 3) + adj1 * (k1 == 3) + adj2 * (k2 == 3) + adj3 * (k3 == 3) + adj5 * (k5 == 3) + adj6 * (k6 == 3) + adj7 * (k7 == 3) + adj8 * (k8 == 3) + adj10 * (k10 == 3) + adj11 * (k11 == 3) + adj12 * (k12 == 3) + adj13 * (k13 == 3)"
      }
    },
    {
      "id": "xSoph",
      "type": "atrium.expr",
      "params": {
        "expr": "adj0 * (k0 == 2) + adj1 * (k1 == 2) + adj2 * (k2 == 2) + adj3 * (k3 == 2) + adj5 * (k5 == 2) + adj6 * (k6 == 2) + adj7 * (k7 == 2) + adj8 * (k8 == 2) + adj10 * (k10 == 2) + adj11 * (k11 == 2) + adj12 * (k12 == 2) + adj13 * (k13 == 2)"
      }
    },
    {
      "id": "xSolid",
      "type": "atrium.expr",
      "params": {
        "expr": "adj0 * (k0 == 1 || k0 == 4) + adj1 * (k1 == 1 || k1 == 4) + adj2 * (k2 == 1 || k2 == 4) + adj3 * (k3 == 1 || k3 == 4) + adj5 * (k5 == 1 || k5 == 4) + adj6 * (k6 == 1 || k6 == 4) + adj7 * (k7 == 1 || k7 == 4) + adj8 * (k8 == 1 || k8 == 4) + adj10 * (k10 == 1 || k10 == 4) + adj11 * (k11 == 1 || k11 == 4) + adj12 * (k12 == 1 || k12 == 4) + adj13 * (k13 == 1 || k13 == 4)"
      }
    },
    {
      "id": "xSub",
      "type": "atrium.expr",
      "params": {
        "expr": "adj0 * (k0 == 1 || k0 == 2 || k0 == 4) * (s0_sub || s1_sub) + adj1 * (k1 == 1 || k1 == 2 || k1 == 4) * (s1_sub || s2_sub) + adj2 * (k2 == 1 || k2 == 2 || k2 == 4) * (s2_sub || s3_sub) + adj3 * (k3 == 1 || k3 == 2 || k3 == 4) * (s3_sub || s4_sub) + adj5 * (k5 == 1 || k5 == 2 || k5 == 4) * (s5_sub || s6_sub) + adj6 * (k6 == 1 || k6 == 2 || k6 == 4) * (s6_sub || s7_sub) + adj7 * (k7 == 1 || k7 == 2 || k7 == 4) * (s7_sub || s8_sub) + adj8 * (k8 == 1 || k8 == 2 || k8 == 4) * (s8_sub || s9_sub) + adj10 * (k10 == 1 || k10 == 2 || k10 == 4) * (s10_sub || s11_sub) + adj11 * (k11 == 1 || k11 == 2 || k11 == 4) * (s11_sub || s12_sub) + adj12 * (k12 == 1 || k12 == 2 || k12 == 4) * (s12_sub || s13_sub) + adj13 * (k13 == 1 || k13 == 2 || k13 == 4) * (s13_sub || s14_sub)"
      }
    },
