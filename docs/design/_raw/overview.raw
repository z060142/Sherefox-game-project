id='.14998' rev='68' h='38cf1906'><paragraph id='.14999' h='9912ff39'><text id='.15000'>主導權</text><text id='.16969'>爭</text><text id='.15004'>奪</text></paragraph></cell><cell id='.15005' rev='22' h='0c6e74a1'><paragraph id='.15006' h='89f9e15a'><text id='.15007'>論戰後半</text></paragraph></cell></row><row id='.15011' h='7db24122'><cell id='.15012' h='14fff202'><paragraph id='.15013' h='a0b1ce3d'><text id='.15014'>BGM09</text></paragraph></cell><cell id='.15019' h='2378ff16'><paragraph id='.15020' h='04871ac8'><text id='.15021'>等一下，我已經徹底解開了</text></paragraph></cell><cell id='.15033' h='d665e09e'><paragraph id='.15034' h='526c8afe'><text id='.15035'>論破與尾聲</text></paragraph></cell></row><row id='.15040' h='c5ead364'><cell id='.15041' h='df2104d7'><paragraph id='.15042' h='d7a5ee0f'><text id='.15043'>BGM10</text></paragraph></cell><cell id='.15048' h='ae786081'><paragraph id='.15049' h='dbbe74c2'><text id='.15050'>絕境重組</text></paragraph></cell><cell id='.15054' h='01103bcc'><paragraph id='.15055' h='bbfaa960'><text id='.15056'>被論破、反擊論破</text></paragraph></cell></row><row id='.15064' h='9f40adf4'><cell id='.15065' h='5d5f4b3a'><paragraph id='.15066' h='697a0b7e'><text id='.15067'>BGM11</text></paragraph></cell><cell id='.15072' h='d3838a25'><paragraph id='.15073' h='fa044dcf'><text id='.15074'>大家的報紙</text></paragraph></cell><cell id='.15079' h='a5ac0b0b'><paragraph id='.15080' h='f0e66124'><text id='.15081'>結算</text></paragraph></cell></row><row id='.15083' h='9037b1de'><cell id='.15084' h='a953c4f8'><paragraph id='.15085' h='f37f3f9f'><text id='.15086'>BGM12</text></paragraph></cell><cell id='.15091' h='64b126ca'><paragraph id='.15092' h='f19c1cb0'><text id='.15093'>溫馨小事</text></paragraph></cell><cell id='.15097' h='b516793a'><paragraph id='.15098' h='8b068437'><text id='.15099'>日常小事件</text></paragraph></cell></row><row id='.15104' h='b6dcd223'><cell id='.15105' h='19485c8f'><paragraph id='.15106' h='6e1777ba'><text id='.15107'>BGM13</text></paragraph></cell><cell id='.15112' h='212592a2'><paragraph id='.15113' h='446c9f81'><text id='.15114'>北方的風</text></paragraph></cell><cell id='.15118' h='8d5ae00a'><paragraph id='.15119' h='2040da18'><text id='.15120'>外地章</text></paragraph></cell></row><row id='.15123' h='0ba280e5'><cell id='.15124' h='293591f7'><paragraph id='.15125' h='b32d5ce9'><text id='.15126'>BGM14</text></paragraph></cell><cell id='.15131' h='9e54696a'><paragraph id='.15132' h='16fd2cdc'><text id='.15133'>熟悉的陌生城市</text></paragraph></cell><cell id='.15140' h='0cf7ce63'><paragraph id='.15141' h='26333812'><text id='.15142'>Ch.8</text></paragraph></cell></row><row id='.15146' h='f6625e80'><cell id='.15147' h='65b6555f'><paragraph id='.15148' h='f6f4c536'><text id='.15149'>BGM15</text></paragraph></cell><cell id='.15154' h='591bf214'><paragraph id='.15155' h='200f60df'><text id='.15156'>深淵的回音</text></paragraph></cell><cell id='.15161' h='e9fc7172'><paragraph id='.15162' h='0001008a'><text id='.15163'>Ch.9</text></paragraph></cell></row><row id='.15167' h='3113037d'><cell id='.15168' h='8e1d85e9'><paragraph id='.15169' h='35176c5f'><text id='.15170'>BGM16</text></paragraph></cell><cell id='.15175' h='9e9116a5'><paragraph id='.15176' h='cc548c48'><text id='.15177'>群眾的聲音</text></paragraph></cell><cell id='.15182' h='00ab09f9'><paragraph id='.15183' h='3f360c5c'><text id='.15184'>Ch.10</text></paragraph></cell></row><row id='.15189' h='a280d708'><cell id='.15190' h='c8906366'><paragraph id='.15191' h='295e0883'><text id='.15192'>BGM17</text></paragraph></cell><cell id='.15197' h='a5bddb93'><paragraph id='.15198' h='edad6b41'><text id='.15199'>假面華爾滋</text></paragraph></cell><cell id='.15204' h='b7580570'><paragraph id='.15205' h='0bde0726'><text id='.15206'>Ch.11</text></paragraph></cell></row><row id='.15211' h='6f874ab0'><cell id='.15212' h='62a6c58e'><paragraph id='.15213' h='a70e01aa'><text id='.15214'>BGM18</text></paragraph></cell><cell id='.15219' h='07b90ff2'><paragraph id='.15220' h='48938f4c'><text id='.15221'>灰狼的棋盤</text></paragraph></cell><cell id='.15226' h='ce572953'><paragraph id='.15227' h='23aa7680'><text id='.15228'>Wolfhart 主題</text></paragraph></cell></row><row id='.15239' h='f692084a'><cell id='.15240' h='9f469c68'><paragraph id='.15241' h='8cfdf2ba'><text id='.15242'>BGM19</text></paragraph></cell><cell id='.15247' h='f7a99e69'><paragraph id='.15248' h='63dd99cf'><text id='.15249'>發條塔頂的狼與狐</text></paragraph></cell><cell id='.15257' h='5b4866c3'><paragraph id='.15258' h='1f58e6ab'><text id='.15259'>終局論戰</text></paragraph></cell></row><row id='.15263' h='c3120791'><cell id='.15264' h='6f4eadc4'><paragraph id='.15265' h='6159d6ed'><text id='.15266'>BGM20</text></paragraph></cell><cell id='.15271' h='1a8c8e2d'><paragraph id='.15272' h='27f426ff'><text id='.15273'>夜霧之後</text></paragraph></cell><cell id='.15277' h='cc55dad2'><paragraph id='.15278' h='0a2e27f5'><text id='.15279'>True End</text></paragraph></cell></row></table><paragraph id='.15287' h='2c2f9bbc' heading='3'><text id='.15288'>音效分類</text></paragraph><table id='.15292' rev='140' h='ec807c4e'><row id='.15293' rev='22' h='5a41b5a1'><cell id='.15294' h='c3828728' header='true'><paragraph id='.15295' h='b4d250d2'><text id='.15296'>類別</text></paragraph></cell><cell id='.15298' h='d18067b6' header='true'><paragraph id='.15299' h='21e5bce6'><text id='.15300'>內容</text></paragraph></cell></row><row id='.15302' h='25004029'><cell id='.15303' h='5518b8ba'><paragraph id='.15304' h='87929b4b'><text id='.15305'>介面</text></paragraph></cell><cell id='.15307' h='dc91819a'><paragraph id='.15308' h='29879882'><text id='.15309'>確認、取消、翻頁、報紙展開、存檔</text></paragraph></cell></row><row id='.15325' h='3070e085'><cell id='.15326' h='0567ab86'><paragraph id='.15327' h='ca936577'><text id='.15328'>蒐證</text></paragraph></cell><cell id='.15330' h='e1c660d3'><paragraph id='.15331' h='14a440fd'><text id='.15332'>調查點反應、取得證物、鑑定完成（醫療／機械）</text></paragraph></cell></row><row id='.15354' h='505700fb'><cell id='.15355' h='34f78977'><paragraph id='.15356' h='b5ab7954'><text id='.15357'>線索板</text></paragraph></cell><cell id='.15360' h='b8301124'><paragraph id='.15361' h='0be9ad12'><text id='.15362'>釘圖釘、拉實線、拉虛線、禁止連線</text></paragraph></cell></row><row id='.15378' rev='140' h='a545dc74'><cell id='.15379' rev='22' h='ade90d71'><paragraph id='.15380' h='a2eaed07'><text id='.15381'>論戰</text></paragraph></cell><cell id='.15383' rev='140' h='e3071517'><paragraph id='.15384' h='3aa1bff0'><text id='.15385'>主張登場、連鎖命中（1～4 段）、暴擊、動搖洩壓、論破、逆論破、援護</text><text id='.23235'>、截斷、交鋒、書法大字（全幕與印章，音效清單見系統規格 4.7）</text></paragraph></cell></row><row id='.15419' rev='22' h='d63d56e9'><cell id='.15420' h='2cbe9efd'><paragraph id='.15421' h='fba18681'><text id='.15422'>環境</text></paragraph></cell><cell id='.15424' h='eb535ce4'><paragraph id='.15425' h='6377ec9d'><text id='.15426'>蒸氣、齒輪、鐘聲、雨霧、列車、群眾</text></paragraph></cell></row></table><paragraph id='.11972' rev='18' h='41ac3855' heading='2'><text id='.11973'>十二、開發範圍與時程【提案】</text></paragraph><paragraph id='.11987' rev='139' h='d9d33ec4'><text id='.11988'>建議先做 Ch.1～3 的垂直切片：這三章涵蓋蒐證、線索板、</text><text id='.23226'>同時出招與預兆判讀</text><text id='.12020'>、動搖、論破與黃金線索回收，可以在量產前驗證核心玩法好不好玩。以下數量與月份皆為估算，需依實際人力修正。</text></paragraph><table id='.12072' rev='138' h='c841952d'><row id='.12073' rev='18' h='7170aa97'><cell id='.12074' h='db0e45f5' header='true'><paragraph id='.12075' h='21e5bce6'><text id='.12076'>內容</text></paragraph></cell><cell id='.12078' h='cf513974' header='true'><paragraph id='.12079' h='50aa3dfd'><text id='.12080'>數量（估算）</text></paragraph></cell></row><row id='.12086' h='90f89717'><cell id='.12087' h='4ebd411c'><paragraph id='.12088' h='4dc1478b'><text id='.12089'>案件</text></paragraph></cell><cell id='.12091' h='cda481c0'><paragraph id='.12092' h='b819c565'><text id='.12093'>15 個（含 Ch.9 四案）</text></paragraph></cell></row><row id='.12108' rev='138' h='a4914f67'><cell id='.12109' rev='18' h='9d95bba9'><paragraph id='.12110' h='a2eaed07'><text id='.12111'>論戰</text></paragraph></cell><cell id='.12113' rev='138' h='16ada9a6'><paragraph id='.12114' h='de866835'><text id='.12115'>15 場主論戰＋</text><text id='.23179'>3 場熱身（Ch.3、4、9-1）；Ch.6、Ch.7 以權限爭取取代熱身，9-4 以突襲開場</text></paragraph></cell></row><row id='.12148' rev='18' h='1adacc01'><cell id='.12149' h='4f128516'><paragraph id='.12150' h='0efdd3a0'><text id='.12151'>證物卡</text></paragraph></cell><cell id='.12154' h='442254be'><paragraph id='.12155' h='7202c281'><text id='.12156'>約 120 張（每案約 8 張）</text></paragraph></cell></row><row id='.12172' h='9f4a2562'><cell id='.12173' h='0a23b4a3'><paragraph id='.12174' h='d8a3e356'><text id='.12175'>黃金線索與救人痕跡</text></paragraph></cell><cell id='.12184' h='a429cd3a'><paragraph id='.12185' h='8a9fff89'><text id='.12186'>6 條＋3 件</text></paragraph></cell></row><row id='.12193' h='48424f76'><cell id='.12194' h='55662b9b'><paragraph id='.12195' h='c47b54e8'><text id='.12196'>角色</text></paragraph></cell><cell id='.12198' h='b581c145'><paragraph id='.12199' h='da13eaf4'><text id='.12200'>常駐 5 人＋各案角色約 25 人</text></paragraph></cell></row><row id='.12217' h='084ef0a2'><cell id='.12218' h='ddf54aab'><paragraph id='.12219' h='f4b669c5'><text id='.12220'>背景</text></paragraph></cell><cell id='.12222' h='8d1b0f78'><paragraph id='.12223' h='5b3aab90'><text id='.12224'>約 25 張＋Ch.8 異樣版</text></paragraph></cell></row></table><embed id='.12239' h='8499301d' caption='開發時程提案 · 五階段、三道關卡（未依比例）' ref='node/caa4a278-4e1a'/><paragraph id='.12240' h='18d69fc1'><text id='.12241'>切片審查通過才進入量產；內容完成後凍結劇本，專心平衡論戰數值與在地化。</text></paragraph><paragraph id='.11437' rev='141' h='d8c67d50' heading='2'><text id='.11438'>十三、</text><text id='.25298'>設計決策紀錄與</text><text id='.11441'>待確認事項</text></paragraph><paragraph id='.23267' h='58971672' heading='3'><text id='.23268'>設計決策紀錄</text></paragraph><paragraph id='.23274' h='5e7e1960'><text id='.23275'>本專案過程中已經定案的重要決策。細節一律以「文件位置」欄的分頁為準。</text></paragraph><table id='.23309' rev='145' h='4e049410'><row id='.23310' rev='141' h='f6eafa92'><cell id='.23311' h='fa57187e' align='left' header='true'><paragraph id='.23312' h='b237172e'><text id='.23313'>決策</text></paragraph></cell><cell id='.23315' h='9938f83f' align='left' header='true'><paragraph id='.23316' h='f0932674'><text id='.23317'>定案內容</text></paragraph></cell><cell id='.23321' h='c5abf750' align='left' header='true'><paragraph id='.23322' h='18a46156'><text id='.23323'>文件位置</text></paragraph></cell></row><row id='.23327' h='7bad6f1b'><cell id='.23328' h='4645e119' align='left'><paragraph id='.23329' h='e9dba113'><text id='.23330'>連鎖案件四案</text></paragraph></cell><cell id='.23336' h='3a67992d' align='left'><paragraph id='.23337' h='716c1647'><text id='.23338'>Ch.9 由 2 案擴為 9-1～9-4 四個連續案件；9-1、9-4 走完整循環，9-2、9-3 走精簡版；回收 G-02＋G-03，產出 G-05</text></paragraph></cell><cell id='.23413' h='c48c2513' align='left'><paragraph id='.23414' h='a2860ffd'><text id='.23415'>設計總覽八；案件 Ch.9；劇本 Ch.9</text></paragraph></cell></row><row id='.23436' h='a19b5751'><cell id='.23437' h='e47186f9' align='left'><paragraph id='.23438' h='bfa403e3'><text id='.23439'>同時出招制</text></paragraph></cell><cell id='.23444' h='4a740680' align='left'><paragraph id='.23445' h='75ec3660'><text id='.23446'>每回合雙方同時鎖定：玩家實證連鎖／詭辯／反駁／觀察（取代舊的「等待破綻」），對手主張／猛攻／補強／設陷；依對決表結算；論破先算鏈傷害再扣 70／75／80%</text></paragraph></cell><cell id='.23524' h='aa3283fb' align='left'><paragraph id='.23525' h='54a1ed1e'><text id='.23526'>設計總覽六；系統規格 4.4、附錄 A；數值總表一～三</text></paragraph></cell></row><row id='.23553' h='02c27ed1'><cell id='.23554' h='231546e1' align='left'><paragraph id='.23555' h='46256815'><text id='.23556'>預兆規則</text></paragraph></cell><cell id='.23560' h='fb64fb61' align='left'><paragraph id='.23561' h='4ee6bae3'><text id='.23562'>明示／模糊（真實行動＋1 個誘餌；有行為規則適用時標出較可能的一個）／偽裝（只限維多與 Wolfhart，台詞與小動作必定對不上）；狐耳直覺每場 2 次提升預兆；被逆・論破後的翻盤稱「絕境重組」</text></paragraph></cell><cell id='.23659' h='68a21aef' align='left'><paragraph id='.23660' h='30944681'><text id='.23661'>設計總覽六；系統規格 4.4、A-3、A-10；數值總表四</text></paragraph></cell></row><row id='.23690' h='1fd09084'><cell id='.23691' h='7ed6a825' align='left'><paragraph id='.23692' h='0e607ef9'><text id='.23693'>狀態與書法大字</text></paragraph></cell><cell id='.23700' h='23e15186' align='left'><paragraph id='.23701' h='f0431e53'><text id='.23702'>破竹（讀對疊層，最多 3 層，每層 +10%）、困獸（對手攻擊 ×1.25、不能補強、預兆升級）、失守（下一回合不能反駁）；關鍵狀態以兩字書法大字演出，分全幕與印章兩級；Ch.2 起有破竹，Ch.3 起有困獸與失守</text></paragraph></cell><cell id='.23809' h='94f37833' align='left'><paragraph id='.23810' h='1f5f17d1'><text id='.23811'>設計總覽六「狀態與書法大字」；系統規格 4.4、4.7、A-15、8.14；數值總表三</text></paragraph></cell></row><row id='.23854' rev='145' h='50cf7b29'><cell id='.23855' rev='141' h='3bdb64bc' align='left'><paragraph id='.23856' h='230bd82e'><text id='.23857'>堅固節點</text></paragraph></cell><cell id='.23861' rev='145' h='bbc3e74b' align='left'><paragraph id='.23862' h='10a141fc'><text id='.23863'>只在後期：Ch.10 1 個、Ch.11 1 個、Ch.12 2 個（Wolfhart 的兩個核心主張）；前中期沒有，漏證只產生一般節點；</text><text id='.25395'>實證連鎖照常可移除，反駁要用黃金線索才能移除（非黃金的反駁照樣擋傷、反擊）</text></paragraph></cell><cell id='.23944' rev='141' h='55247c36' align='left'><paragraph id='.23945' h='7b24bf71'><text id='.23946'>系統規格 A-2；數值總表三；案件 Ch.10～12</text></paragraph></cell></row><row id='.23972' h='eb25b303'><cell id='.23973' h='f5ea21f5' align='left'><paragraph id='.23974' h='1125aa3f'><text id='.23975'>9-4 單條主導權</text></paragraph></cell><cell id='.23984' h='b0bfa301' align='left'><paragraph id='.23985' h='68052fda'><text id='.23986'>情報站長一條 200，犯人 200→130、庇護者 130→65、詭辯 65→0；只有第三階段可論破；G-02＋G-03 論破才得 G-05</text></paragraph></cell><cell id='.24056' h='a31e351d' align='left'><paragraph id='.24057' h='d1ef2edd'><text id='.24058'>數值總表五；系統規格 A-12；案件 Ch.9</text></paragraph></cell></row><row id='.24081' h='844b52e2'><cell id='.24082' h='529cdfb7' align='left'><paragraph id='.24083' h='26bab468'><text id='.24084'>Ch.7 兩段</text></paragraph></cell><cell id='.24091' h='517eb6ec' align='left'><paragraph id='.24092' h='077fc385'><text id='.24093'>伯爵夫人 80（庇護者）打完後由維多 90（對手偵探）接手；我方主導權延續不回復；援護每段 1 次</text></paragraph></cell><cell id='.24142' h='e685785e' align='left'><paragraph id='.24143' h='fd527816'><text id='.24144'>數值總表五；系統規格 A-12；案件 Ch.7</text></paragraph></cell></row><row id='.24167' h='40182d38'><cell id='.24168' h='71c37048' align='left'><paragraph id='.24169' h='0e16533d'><text id='.24170'>G-06 與救人痕跡</text></paragraph></cell><cell id='.24180' h='0ba2fbaa' align='left'><paragraph id='.24181' h='62507027'><text id='.24182'>G-06 ＝十年前企業收養與奪權卷宗（可參戰，Ch.11 取得，同夾有 Ch.7 名冊被裁去的一頁）；三件救人痕跡（裂開的黑咖啡杯、狼頭徽制動閥鉛封、銀袖扣）是劇情證物，解鎖 Ch.12 隱藏選項</text></paragraph></cell><cell id='.24280' h='d9b8ad33' align='left'><paragraph id='.24281' h='20830dce'><text id='.24282'>設計總覽五、九；案件 Ch.10～12；劇本 Ch.10～12</text></paragraph></cell></row><row id='.24313' h='b10495dd'><cell id='.24314' h='baa1b1c5' align='left'><paragraph id='.24315' h='c2afee36'><text id='.24316'>黃金線索不消耗</text></paragraph></cell><cell id='.24323' h='28dc1047' align='left'><paragraph id='.24324' h='313f6acd'><text id='.24325'>黃金線索存入檔案後可重複使用；漏拿時後半出現次級替代證物</text></paragraph></cell><cell id='.24353' h='a5ff2a56' align='left'><paragraph id='.24354' h='ab6fa771'><text id='.24355'>設計總覽五；系統規格 1.9</text></paragraph></cell></row><row id='.24369' h='fee35397'><cell id='.24370' h='768cd9d1' align='left'><paragraph id='.24371' h='7727236c'><text id='.24372'>逆・論破的對象</text></paragraph></cell><cell id='.24379' h='ebc9ac28' align='left'><paragraph id='.24380' h='2e4b780e'><text id='.24381'>只有維多與 Wolfhart 能發動；情報站長不能用</text></paragraph></cell><cell id='.24407' h='1d7bd491' align='left'><paragraph id='.24408' h='705b9251'><text id='.24409'>系統規格 A-10；數值總表三</text></paragraph></cell></row><row id='.24424' h='7b22b8dd'><cell id='.24425' h='43092e31' align='left'><paragraph id='.24426' h='b3563702'><text id='.24427'>熱身的範圍</text></paragraph></cell><cell id='.24432' h='9d06a441' align='left'><paragraph id='.24433' h='9d5add4d'><text id='.24434'>熱身小論戰只在 Ch.3、Ch.4、9-1；Ch.6、Ch.7 以權限爭取取代，9-4 以突襲開場</text></paragraph></cell><cell id='.24483' h='8f3e0172' align='left'><paragraph id='.24484' h='e5940a79'><text id='.24485'>案件各分頁；系統規格 1.6、A-13</text></paragraph></cell></row><row id='.24504' h='e1609db5'><cell id='.24505' h='b920a0cc' align='left'><paragraph id='.24506' h='7bf5d7b1'><text id='.24507'>名稱定案</text></paragraph></cell><cell id='.24511' h='0e86673a' align='left'><paragraph id='.24512' h='5897b831'><text id='.24513'>總工程師艾德格・索恩、女兒艾妲・索恩、帳房西蒙・艾許、內務部督察奧利佛・孟克頓、候選人葛雷夫斯、空殼公司北岸信託、組織銀牙會；配角老麥特、比利、艾蓮諾、哈洛德・溫斯洛、鄧肯、潘洛斯</text></paragraph></cell><cell id='.24603' h='c4515aca' align='left'><paragraph id='.24604' h='766fbd68'><text id='.24605'>案件各分頁；劇本各分頁</text></paragraph></cell></row><row id='.24616' h='77947384'><cell id='.24617' h='fd0c81b3' align='left'><paragraph id='.24618' h='32920449'><text id='.24619'>時間軸</text></paragraph></cell><cell id='.24622' h='8b3057a2' align='left'><paragraph id='.24623' h='aa45d84f'><text id='.24624'>1887 年 10 月 Ch.1～2、11 月 Ch.3～4、12 月 Ch.5～6、1888 年 1 月 Ch.7；約四個月的蘇格蘭與歐陸委託；5 月 25 日 Ch.8；5 月 31 日～6 月 10 日 Ch.9；6 月第三週 Ch.10，三天後 Ch.11，當晚 Ch.12</text></paragraph></cell><cell id='.24765' h='af87b2cf' align='left'><paragraph id='.24766' h='24d635ff'><text id='.24767'>設計總覽二「年表」；案件各分頁</text></paragraph></cell></row><row id='.24782' h='1b3ed32e'><cell id='.24783' h='ce321b5b' align='left'><paragraph id='.24784' h='f5413b47'><text id='.24785'>Ch.1 布丁</text></paragraph></cell><cell id='.24792' h='e6e6b8e7' align='left'><paragraph id='.24793' h='0b97e60f'><text id='.24794'>Ch.1 為「消失的發條焦糖布丁」：亞瑟半夜修懷錶時打翻布丁；不扣血的布丁論戰教攻守與讀預兆，破竹只作預覽</text></paragraph></cell><cell id='.24847' h='1b287017' align='left'><paragraph id='.24848' h='7d6fcae0'><text id='.24849'>設計總覽七；案件 Ch.1；劇本 Ch.1；系統規格 7.2、A-13</text></paragraph></cell></row><row id='.24884' h='09fd5194'><cell id='.24885' h='c2149377' align='left'><paragraph id='.24886' h='bc0e5664'><text id='.24887'>金禧</text></paragraph></cell><cell id='.24889' h='7d036496' align='left'><paragraph id='.24890' h='02b4dda7'><text id='.24891'>Ch.11 的宴會是「女王金禧週年紀念宴」，取代舊稿的「銀禧」</text></paragraph></cell><cell id='.24922' h='33678beb' align='left'><paragraph id='.24923' h='0ad68db5'><text id='.24924'>案件 Ch.11；劇本 Ch.11</text></paragraph></cell></row></table><paragraph id='.24941' h='273174d0' heading='3'><text id='.24942'>待確認事項</text></paragraph><paragraph id='.24947' h='7cd96014'><text id='.24948'>以下是仍需要你拍板的項目。</text></paragraph><list id='.24961' rev='146' h='48b66422' kind='check'><listItem id='.24962' rev='141' h='6d418fdf'><paragraph id='.24963' h='9a2998e6'><text id='.24964'>助手、警官、對手偵探的正式名字（亞瑟、巴斯克維爾、維多目前都是暫名）。</text></paragraph></listItem><listItem id='.25047' h='24477945'><paragraph id='.25048' h='075d6565'><text id='.25049'>平台、語言、遊玩時數、開發範圍與時程都是估算，需依實際人力與預算修正。</text></paragraph></listItem><listItem id='.25084' rev='143' h='629624ed'><paragraph id='.25085' h='13c1a515'><text id='.25086'>中期的技巧落差：數值總表的模擬中，粗心的玩家</text><text id='.25306'>（約 40% 讀對）中期勝率約 56～63%，高於約 45%（至少 55% 以下）的目標；會讀對手的玩家中期為 95～100%</text><text id='.25142'>。中期論戰只有 5～7 回合、運氣佔比高；要拉開差距只能拉長中期論戰。是否接受現況？</text></paragraph></listItem><listItem id='.25184' rev='141' h='33cdac39'><paragraph id='.25185' h='6eca0122'><text id='.25186'>書法大字譯名的各語言定稿（系統規格 8.14 只列了英文範例）。</text></paragraph></listItem><listItem id='.25218' h='cf2edd23'><paragraph id='.25219' h='2b2101ad'><text id='.25220'>立繪、事件 CG 與音樂曲名目前都是方向參考與暫名（第十一節）。</text></paragraph></listItem><listItem id='.25252' h='fe96d87c'><paragraph id='.25253' h='0f749c17'><text id='.25254'>是否有語音，以及配音範圍（系統規格已預留角色語音開關與 Sherefox 的截斷語音）。</text></paragraph></listItem></list></doc>","complete":true},"frame":{"slug":"9d1b706d-67e2-4dae-8860-bd0423c39193","url":"https://claude.ai/artifact/LQDVV6KG7qX32iaqWw4Pv2","artifactUrl":"https://claude.ai/artifact/LQDVV6KG7qX32iaqWw4Pv2"}}